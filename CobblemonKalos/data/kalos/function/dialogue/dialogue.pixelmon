tellraw @s[scores={DialogueTrigger=236,TalkTime=5}] ["",{"text":"<"},{"text":"Evelyn","color":"aqua"},{"text":"> Uh-um... Do...do you remember me?"}]
tellraw @s[scores={DialogueTrigger=236,TalkTime=12}] ["",{"text":"<"},{"text":"Evelyn","color":"aqua"},{"text":"> You don't...do you... Of course... I-I'm Evelyn..."}]
tellraw @s[scores={DialogueTrigger=236,TalkTime=21}] ["",{"text":"<"},{"text":"Evelyn","color":"aqua"},{"text":"> U-um... You really are a strong Trainer, aren't you, dear guest?"}]
tellraw @s[scores={DialogueTrigger=236,TalkTime=30}] ["",{"text":"<"},{"text":"Evelyn","color":"aqua"},{"text":"> Ah... I don't want to fight... You look too scary..."}]
tellraw @s[scores={DialogueTrigger=236,TalkTime=38}] ["",{"text":"<"},{"text":"Evelyn","color":"aqua"},{"text":"> I want to go home... O-oh! I'm so sorry!!!"}]
tellraw @s[scores={DialogueTrigger=236,TalkTime=47}] ["",{"text":"<"},{"text":"Evelyn","color":"aqua"},{"text":"> I know how fed up my sister would be if she heard me saying such things!"}]
tellraw @s[scores={DialogueTrigger=236,TalkTime=57}] ["",{"text":"<"},{"text":"Evelyn","color":"aqua"},{"text":"> L-let's just have the battle, shall we? I'll do my best!"}]
tellraw @s[scores={DialogueTrigger=236,TalkTime=66}] ["",{"text":"<"},{"text":"Evelyn","color":"aqua"},{"text":"> Honestly, I really will! You can fight with all you've got!"}]

tag @s[scores={DialogueTrigger=236,TalkTime=66..}] add Dialogue236
scoreboard players set @s[tag=Dialogue236] TalkTime 0
scoreboard players set @s[tag=Dialogue236] DialogueTrigger 0

