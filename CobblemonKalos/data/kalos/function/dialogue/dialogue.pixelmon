execute as @s[scores={DialogueTrigger=174,TalkTime=1}] run tag @s[x=-439,y=101,z=439,distance=..30] add TicketCenter


tellraw @s[scores={DialogueTrigger=174,TalkTime=2,LookerTickets=1}] ["",{"text":"You found a Looker Ticket! Looker Tickets remaining: "},{"text":"4","color":"dark_aqua"},{"text":"/5"}]
tellraw @s[scores={DialogueTrigger=174,TalkTime=2,LookerTickets=2}] ["",{"text":"You found a Looker Ticket! Looker Tickets remaining: "},{"text":"3","color":"dark_aqua"},{"text":"/5"}]
tellraw @s[scores={DialogueTrigger=174,TalkTime=2,LookerTickets=3}] ["",{"text":"You found a Looker Ticket! Looker Tickets remaining: "},{"text":"2","color":"dark_aqua"},{"text":"/5"}]
tellraw @s[scores={DialogueTrigger=174,TalkTime=2,LookerTickets=4}] ["",{"text":"You found a Looker Ticket! Looker Tickets remaining: "},{"text":"1","color":"dark_aqua"},{"text":"/5"}]
tellraw @s[scores={DialogueTrigger=174,TalkTime=2,LookerTickets=5}] ["",{"text":"You found a Looker Ticket! Looker Tickets remaining: "},{"text":"0","color":"dark_aqua"},{"text":"/5"}]

tellraw @s[scores={DialogueTrigger=174,TalkTime=10}] {"text":"There is something written on the reverse side of the ticket..."}

tellraw @s[scores={DialogueTrigger=174,TalkTime=20,LookerTickets=1}] {"text":"Congratulations! You've found a ticket!"}
tellraw @s[scores={DialogueTrigger=174,TalkTime=28,LookerTickets=1}] {"text":"Your brilliant deduction has brought you one step closer to becoming a detective!"}

tellraw @s[scores={DialogueTrigger=174,TalkTime=20,LookerTickets=2}] {"text":"Congratulations! You've found a ticket!"}
tellraw @s[scores={DialogueTrigger=174,TalkTime=28,LookerTickets=2}] ["",{"text":"Just as I would expect of my colleague-to-be, "},{"selector":"@s"},{"text":"! "}]
tellraw @s[scores={DialogueTrigger=174,TalkTime=36,LookerTickets=2}] {"text":"March on! March on! Dive deep into Lumiose City!"}

tellraw @s[scores={DialogueTrigger=174,TalkTime=20,LookerTickets=3}] {"text":"Congratulations! You've found a ticket! Your training is coming along smoothly!"}
tellraw @s[scores={DialogueTrigger=174,TalkTime=30,LookerTickets=3}] {"text":"If my deductions are correct, I would say that this is the third ticket you've tracked down."}
tellraw @s[scores={DialogueTrigger=174,TalkTime=40,LookerTickets=3}] {"text":"Which would mean you are now more than halfway through your training! "}
tellraw @s[scores={DialogueTrigger=174,TalkTime=48,LookerTickets=3}] {"text":"Lumiose is an imposing city, but do your best!"}

tellraw @s[scores={DialogueTrigger=174,TalkTime=20,LookerTickets=4}] {"text":"Congratulations! You've found a ticket! Shall I share my diagnostics with you again?"}
tellraw @s[scores={DialogueTrigger=174,TalkTime=30,LookerTickets=4}] {"text":"This ticket must be... your fourth ticket. Correct, yes? I imagine you are consumed with curiosity."}
tellraw @s[scores={DialogueTrigger=174,TalkTime=41,LookerTickets=4}] {"text":"How could I possibly know this? The answer to that is simply-- I am a hard-boiled detective, after all!"}

tellraw @s[scores={DialogueTrigger=174,TalkTime=20,LookerTickets=5}] {"text":"Congratulations! You've found a ticket!"}
tellraw @s[scores={DialogueTrigger=174,TalkTime=30,LookerTickets=5}] {"text":"If you have gathered all five tickets, make your way straight to the Looker Bureau!"}
tellraw @s[scores={DialogueTrigger=174,TalkTime=40,LookerTickets=5}] ["",{"text":"Your training continues until we meet again! Remember that, brave "},{"selector":"@s"},{"text":"!"}]

tag @s[scores={DialogueTrigger=174,TalkTime=40..}] add Dialogue174
scoreboard players set @s[tag=Dialogue174] TalkTime 0
scoreboard players set @s[tag=Dialogue174] DialogueTrigger 0

#----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
#https://youtu.be/rrMxYkXdKC8?t=676
#Looker after finding all 5 tickets
#scoreboard players set @a[x=-176,y=100,z=387,r=7,score_LookerTickets_min=5,tag=!Dialogue175] DialogueTrigger 175

tellraw @s[scores={DialogueTrigger=175,TalkTime=2}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> Ein, tvo, tri, fjore..."}]
tellraw @s[scores={DialogueTrigger=175,TalkTime=10}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> Fif! Five Looker Tickets!"}]
tellraw @s[scores={DialogueTrigger=175,TalkTime=17}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> Congratulations, "},{"selector":"@s"},{"text":"! You have completed your training using my patented course,"}]
tellraw @s[scores={DialogueTrigger=175,TalkTime=25}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> \u201cThe Looker Method: Yes, even YOU can become a detective in five easy steps!\u201d"}]
execute as @s[scores={DialogueTrigger=175,TalkTime=34}] run scoreboard players set @s click 1
tellraw @s[scores={DialogueTrigger=175,TalkTime=35}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> From this day onward, you are a fully fledged, completely boiled detective!"}]
tellraw @s[scores={DialogueTrigger=175,TalkTime=44}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> It will be an honor for you to serve as an official member of the Looker Bureau!"}]
tellraw @s[scores={DialogueTrigger=175,TalkTime=53}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> And... as partner to the one and only Looker!"}]
tellraw @s[scores={DialogueTrigger=175,TalkTime=60}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> I'll send you a message on your Holo Caster whenever we have a job to do!"}]

#Blinds player, keeps player in place for spectating
execute as @s[scores={DialogueTrigger=175,TalkTime=68}] run effect give @s minecraft:blindness 5 1 true
execute as @s[scores={DialogueTrigger=175,TalkTime=68}] run gamemode spectator @s
execute as @s[scores={DialogueTrigger=175,TalkTime=69}] run tp @s -168 106 429 120 35
execute as @s[scores={DialogueTrigger=175,TalkTime=70..129}] run tp @s -168 106 429 ~ ~
execute as @s[scores={DialogueTrigger=175,TalkTime=68}] run scoreboard players set @s click 1

tellraw @s[scores={DialogueTrigger=175,TalkTime=74}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> ... ... ...","italic":true}]
tellraw @s[scores={DialogueTrigger=175,TalkTime=81}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> To complete my patented training course, \u201cThe Looker Method: Yes, even YOU can become a detective in five easy steps!\u201c in so little time and with such ease...","italic":true}]
tellraw @s[scores={DialogueTrigger=175,TalkTime=93}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> "},{"selector":"@s"},{"text":", you truly are a masterful Trainer.","italic":true}]
tellraw @s[scores={DialogueTrigger=175,TalkTime=101}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> The big case on which I have been at work... It is a certainty.","italic":true}]
tellraw @s[scores={DialogueTrigger=175,TalkTime=110}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> We will crack this case together. And, as for what is past, old friend, be patient.","italic":true}]
tellraw @s[scores={DialogueTrigger=175,TalkTime=121}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> Justice will be served--enough for all!","italic":true}]

#Blinds player, tp to front of Beaureu
execute as @s[scores={DialogueTrigger=175,TalkTime=129}] run effect give @s minecraft:blindness 5 1 true
execute as @s[scores={DialogueTrigger=175,TalkTime=130}] run gamemode adventure @s
execute as @s[scores={DialogueTrigger=175,TalkTime=130}] run tp @s -190 102 -634 -90 ~
execute as @s[scores={DialogueTrigger=175,TalkTime=131}] run scoreboard players set @s click 1
execute as @s[scores={DialogueTrigger=175,TalkTime=131}] run tag @s add LookerCooldown
execute as @s[scores={DialogueTrigger=175,TalkTime=131}] run advancement grant @s only kalos:looker1

