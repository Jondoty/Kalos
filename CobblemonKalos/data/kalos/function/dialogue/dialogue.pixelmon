tellraw @s[scores={DialogueTrigger=275,TalkTime=1}] {"text":"<Tourist> Everyone gets a bit absentminded at times-- and that goes for both Pokémon and people."}
tellraw @s[scores={DialogueTrigger=275,TalkTime=11}] {"text":"<Tourist> To help prevent such absentmindedness, I'll give your Pokémon a Careless Ribbon!"}
tellraw @s[scores={DialogueTrigger=275,TalkTime=21}] {"text":"<Tourist> Send out your Pokémon and I'll pin a ribbon on them!"}

