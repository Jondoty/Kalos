execute as @s[scores={DialogueTrigger=209,TalkTime=16}] run data modify entity @e[limit=1,x=-295,y=32,z=300,dy=3] {Rotation:[0.0f,0.0f]}

tellraw @s[scores={DialogueTrigger=209,TalkTime=20}] {"text":"<Team Flare Xerosic> Do I need to do more than simply put her in a state of sleep"}
tellraw @s[scores={DialogueTrigger=209,TalkTime=27}] {"text":"<Team Flare Xerosic> Must I subdue her spirit, too?"}
tellraw @s[scores={DialogueTrigger=209,TalkTime=35}] {"text":"<Team Flare Xerosic> No, no. Doing that would put far too great a strain upon Emma's mind..."}
tellraw @s[scores={DialogueTrigger=209,TalkTime=44}] {"text":"<Team Flare Xerosic> Oho ho ho! You're the trainer from the glitched trial!"}
tellraw @s[scores={DialogueTrigger=209,TalkTime=52}] {"text":"<Team Flare Xerosic> You've been interfering with my research!"}
tellraw @s[scores={DialogueTrigger=209,TalkTime=60}] {"text":"<Team Flare Xerosic> Very well. You will be the next subject for my trials!"}
tellraw @s[scores={DialogueTrigger=209,TalkTime=67}] {"text":"<Team Flare Xerosic> If Essentia can defeat you in the Expansion Suit,"}
tellraw @s[scores={DialogueTrigger=209,TalkTime=74}] {"text":"<Team Flare Xerosic> that is all the proof necessary to show that my research has been correct from the start! Come, Essentia!"}

