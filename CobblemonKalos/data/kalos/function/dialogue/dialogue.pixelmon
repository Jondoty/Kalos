tellraw @s[scores={DialogueTrigger=140,TalkTime=5}] {"text":"<Trevor> There is still so much I don't know. Do I just not have what it takes?"}]
tellraw @s[scores={DialogueTrigger=140,TalkTime=15}] {"text":"<Shauna> Wow! I don't think I've ever heard you worry about being weak or strong before, Trevor! \u266a"}]
tellraw @s[scores={DialogueTrigger=140,TalkTime=25}] {"text":"<Shauna> You seem a lot bolder than you used to be. Is it because you went on a journey?"}]
tellraw @s[scores={DialogueTrigger=140,TalkTime=35}] {"text":"<Shauna> Or maybe it's thanks to what you learned from being with your Pokémon, and with us-- your friends!"}]
tellraw @s[scores={DialogueTrigger=140,TalkTime=45}] {"text":"<Shauna> Speaking of which... Where's Serena?"}]
tellraw @s[scores={DialogueTrigger=140,TalkTime=53}] {"text":"<Tierno> She's off training with the Mega Evolution guru."}]
