#----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
#https://youtu.be/qEms9_nJ7M0?t=66653
#Lumiose Museum Director graffiti artwork
#execute as @s[x=-80,y=100,z=327,dx=9,dy=6,dz=7,tag=Dialogue185] run scoreboard players set @s[tag=!Dialogue187] DialogueTrigger 187

tellraw @s[scores={DialogueTrigger=187,TalkTime=3}] {"text":"<...> ...Mm-hmm."}
tellraw @s[scores={DialogueTrigger=187,TalkTime=8}] {"text":"<Museum Director> I am the museum director. May I ask you a question, young trainer?"}
tellraw @s[scores={DialogueTrigger=187,TalkTime=18}] {"text":"<Museum Director> When you behold this graffiti, what feelings rise up within you?"}
tellraw @s[scores={DialogueTrigger=187,TalkTime=28}] {"text":"<Museum Director> Do you feel that the value of this glorious work of art has been affected?"}
tellraw @s[scores={DialogueTrigger=187,TalkTime=38}] {"text":"<Museum Director> Does it seem too, too sullied to you?"}
tellraw @s[scores={DialogueTrigger=187,TalkTime=45}] {"text":"<Museum Director> Defacing a historical piece with graffiti..."}
tellraw @s[scores={DialogueTrigger=187,TalkTime=53}] {"text":"<Museum Director> Defacing the history embodied by this great work of art!"}
tellraw @s[scores={DialogueTrigger=187,TalkTime=61}] {"text":"<Museum Director> Consider the effort and pains of the artist..."}
tellraw @s[scores={DialogueTrigger=187,TalkTime=69}] {"text":"<Museum Director> Well, it is simply profane to have treated this work so savagely!"}
tellraw @s[scores={DialogueTrigger=187,TalkTime=78}] {"text":"<Museum Director> The problem is what to do now. Trying to restore the original work may worsen the damage."}
tellraw @s[scores={DialogueTrigger=187,TalkTime=90}] {"text":"<Museum Director> I think we will have to leave it as it is until we can decide."}
tellraw @s[scores={DialogueTrigger=187,TalkTime=98}] {"text":"<Museum Director> I suppose if the news brings curious citizens like yourself to our doors,"}
tellraw @s[scores={DialogueTrigger=187,TalkTime=107}] {"text":"<Museum Director> that is something of a silver lining."}
tellraw @s[scores={DialogueTrigger=187,TalkTime=115}] {"text":"<Museum Director> But who could be responsible for this shocking work?"}

tag @s[scores={DialogueTrigger=187,TalkTime=115..}] add Dialogue187
scoreboard players set @s[tag=Dialogue187] TalkTime 0
scoreboard players set @s[tag=Dialogue187] DialogueTrigger 0

#----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
#Looker after investigating Museum

execute as @s[scores={DialogueTrigger=188,TalkTime=1}] run scoreboard players set @s click 1
tellraw @s[scores={DialogueTrigger=188,TalkTime=3}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> "},{"selector":"@s"},{"text":", have you seen the news? The purloining of Pokémon continues!"}]
tellraw @s[scores={DialogueTrigger=188,TalkTime=13}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> It is unforgivable! We have not yet closed the case at the museum, but..."}]
tellraw @s[scores={DialogueTrigger=188,TalkTime=22}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> When you consider how many are suffering, we must pursue the culprits!"}]
tellraw @s[scores={DialogueTrigger=188,TalkTime=31}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> I have devised an absolutely amazing plan that will bring an immediate solution."}]
tellraw @s[scores={DialogueTrigger=188,TalkTime=41}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> It will be a sting operation!"}]
tellraw @s[scores={DialogueTrigger=188,TalkTime=48}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> It appears the criminals are targeting Trainers in places where there are no witnesses."}]
tellraw @s[scores={DialogueTrigger=188,TalkTime=59}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> If that is indeed the case, then we can simply bait a trap and wait!"}]
tellraw @s[scores={DialogueTrigger=188,TalkTime=68}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> First the \u201cvictim\u201d will go to some deserted location and act lost."}]
tellraw @s[scores={DialogueTrigger=188,TalkTime=77}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> The criminals will think they've found an easy mark, and they will surely reveal themselves!"}]
tellraw @s[scores={DialogueTrigger=188,TalkTime=88}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> All the reports say they like to challenge their victims to battle before stealing their Pokémon."}]
tellraw @s[scores={DialogueTrigger=188,TalkTime=99}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> That's when we'll get them! Right when they are distracted by the heat of a Pokémon battle!"}]
tellraw @s[scores={DialogueTrigger=188,TalkTime=110}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> The backup, who will be hiding and watching, will appear and help take down the criminals!"}]
tellraw @s[scores={DialogueTrigger=188,TalkTime=120}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> Indeed. What do you think? It is not without risk, but it's quite the best plan we have!"}]
tellraw @s[scores={DialogueTrigger=188,TalkTime=131}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> However! The plan will never succeed without you, "},{"selector":"@s"},{"text":"!"}]
tellraw @s[scores={DialogueTrigger=188,TalkTime=140}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> Now, as to our assignments..."}]
tellraw @s[scores={DialogueTrigger=188,TalkTime=147}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> There is little to decide, since you are aware that I have no Pokémon."}]
tellraw @s[scores={DialogueTrigger=188,TalkTime=156}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> Your role is therefore to play the victim in our little sting operation."}]
tellraw @s[scores={DialogueTrigger=188,TalkTime=165}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> I will conceal myself in the shadows and watch for my opening to attack."}]
tellraw @s[scores={DialogueTrigger=188,TalkTime=175}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> Keep your Pokémon ready to spring into battle when the criminals appear!"}]
tellraw @s[scores={DialogueTrigger=188,TalkTime=184}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> I ask myself how to draw these miscreants into approaching us."}]
tellraw @s[scores={DialogueTrigger=188,TalkTime=193}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> What we need is a place in this bustling city that is a little deserted, perhaps."}]
tellraw @s[scores={DialogueTrigger=188,TalkTime=203}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> A nice, neglected alley is exactly what I have in mind. Come, "},{"selector":"@s"},{"text":"! The game is afoot!"}]
tellraw @s[scores={DialogueTrigger=188,TalkTime=215}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> Let us begin the hunt close to home!"}]
tellraw @s[scores={DialogueTrigger=188,TalkTime=223}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> The nearest alley is right beside this building. It connects to Autumnal Avenue."}]
tellraw @s[scores={DialogueTrigger=188,TalkTime=232}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> Go quickly, "},{"selector":"@s"},{"text":"! I will be right behind you!"}]
execute as @s[scores={DialogueTrigger=188,TalkTime=240}] run scoreboard players set @s click 1

tag @s[scores={DialogueTrigger=188,TalkTime=240..}] add Dialogue188
scoreboard players set @s[tag=Dialogue188] TalkTime 0
scoreboard players set @s[tag=Dialogue188] DialogueTrigger 0

