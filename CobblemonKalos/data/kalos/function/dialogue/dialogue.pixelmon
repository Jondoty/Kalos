#Mable post-battle dialogue
#/tedit add LOSS /scoreboard players set @pl DialogueTrigger 115
#/tedit add LOSS /scoreboard players set @pl TalkTime 0
#execute as @s[x=-225,y=140,z=348,dx=17,dy=10,dz=10,tag=Dialogue114,score_TalkTime=0] run execute as @s[tag=!Dialogue115] run tp @e[x=-504,y=235,z=1278,dy=3,type=pixelmon:npc_trainer] -216 141 347

tellraw @s[scores={DialogueTrigger=115,TalkTime=5}] ["",{"text":"<"},{"text":"Team Flare Mable","color":"dark_aqua"},{"text":"> Ding-ding-ding! Yup, you did it!"}]
tellraw @s[scores={DialogueTrigger=115,TalkTime=12}] ["",{"text":"<"},{"text":"Team Flare Mable","color":"dark_aqua"},{"text":"> To the victor goes the spoils! Here! An elevator key for you!"}]
execute as @s[scores={DialogueTrigger=115,TalkTime=15}] run tag @s add ElevatorKey
execute as @s[scores={DialogueTrigger=115,TalkTime=15}] run give @s minecraft:iron_horse_armor{display:{Lore:["A card key that activates the","elevator in Lysandre Labs.","It is emblazoned with Team","Flare's logo."]},HideFlags:6}
tellraw @s[scores={DialogueTrigger=115,TalkTime=21}] ["",{"text":"<"},{"text":"Team Flare Mable","color":"dark_aqua"},{"text":"> The power of the Legendary Pokémon..."}]
tellraw @s[scores={DialogueTrigger=115,TalkTime=28}] ["",{"text":"<"},{"text":"Team Flare Mable","color":"dark_aqua"},{"text":"> The power to grant life to all around one..."}]
tellraw @s[scores={DialogueTrigger=115,TalkTime=36}] ["",{"text":"<"},{"text":"Team Flare Mable","color":"dark_aqua"},{"text":"> And the power to steal life from all around the other..."}]
tellraw @s[scores={DialogueTrigger=115,TalkTime=44}] ["",{"text":"<"},{"text":"Team Flare Mable","color":"dark_aqua"},{"text":"> It's mysterious abilities that even scientists like us haven't been able to really decode."}]
tellraw @s[scores={DialogueTrigger=115,TalkTime=55}] ["",{"text":"<"},{"text":"Team Flare Mable","color":"dark_aqua"},{"text":"> What d'you think will happen to the world if we fuel the ultimate weapon with something like that?"}]

