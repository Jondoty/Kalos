execute as @s[scores={DialogueTrigger=212,TalkTime=39}] run data modify entity @e[limit=1,x=-297,y=29,z=308,dy=3,type=pixelmon:npc_chatting] {Rotation:[180.0f,0.0f]}

tellraw @s[scores={DialogueTrigger=212,TalkTime=40}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> That is enough."}]
tellraw @s[scores={DialogueTrigger=212,TalkTime=46}] {"text":"<Team Flare Xerosic> What?!"}
tellraw @s[scores={DialogueTrigger=212,TalkTime=51}] {"text":"<Team Flare Xerosic> Who are you two? Why are you here?"}
tellraw @s[scores={DialogueTrigger=212,TalkTime=59}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> Mimi is a Psychic-type Pokémon."}]
tellraw @s[scores={DialogueTrigger=212,TalkTime=66}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> It is only natural that it could find the friend to whom it has opened its heart."}]
tellraw @s[scores={DialogueTrigger=212,TalkTime=78}] {"text":"<Team Flare Xerosic> You can't just barge into a private residence like this! This is a crime!"}
tellraw @s[scores={DialogueTrigger=212,TalkTime=88}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> That may have been true had we forced our way onto the property."}]
tellraw @s[scores={DialogueTrigger=212,TalkTime=97}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> However, all we did was step into a wide-open elevator."}]
tellraw @s[scores={DialogueTrigger=212,TalkTime=105}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> Notwithstanding that, "},{"selector":"@s"},{"text":" is the partner of the great Looker!"}]
tellraw @s[scores={DialogueTrigger=212,TalkTime=115}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> Were they in trouble, I would follow to the highest heights and the fathomless depths!"}]
tellraw @s[scores={DialogueTrigger=212,TalkTime=125}] {"text":"<Team Flare Xerosic> Grrr... Still, you will not capture me! Go, Essentia! Get them all!"}
tellraw @s[scores={DialogueTrigger=212,TalkTime=135}] ["",{"text":"<"},{"text":"Essentia","color":"gold"},{"text":"> ... ... ..."}]
tellraw @s[scores={DialogueTrigger=212,TalkTime=141}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> Stop this, Emma!"}]
tellraw @s[scores={DialogueTrigger=212,TalkTime=147}] ["",{"text":"<"},{"text":"Mimi","color":"light_purple"},{"text":"> Mrrrrrrawr!"}]
execute as @s[scores={DialogueTrigger=212,TalkTime=147}] run playsound espurr hostile @s ~ ~ ~ 100 1 1
tellraw @s[scores={DialogueTrigger=212,TalkTime=153}] {"text":"<Team Flare Xerosic> It's useless, you fools! Nothing you try will work!"}
tellraw @s[scores={DialogueTrigger=212,TalkTime=161}] {"text":"<Team Flare Xerosic> Emma cannot hear you! The one in control of Essentia is not Emma, but me!"}
tellraw @s[scores={DialogueTrigger=212,TalkTime=170}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> Can you hear me, Emma?!"}]
tellraw @s[scores={DialogueTrigger=212,TalkTime=177}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> If you can wake yourself, I know you can break free of that suit!"}]
tellraw @s[scores={DialogueTrigger=212,TalkTime=186}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> Awaken! Open your eyes!"}]
tellraw @s[scores={DialogueTrigger=212,TalkTime=192}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> Emma! EMMA!!"}]
tellraw @s[scores={DialogueTrigger=212,TalkTime=200}] ["",{"text":"<"},{"text":"Essentia","color":"gold"},{"text":"> ... ... ..."}]
tellraw @s[scores={DialogueTrigger=212,TalkTime=207}] {"text":"<Team Flare Xerosic> Isn't the power of science amazing?"}
tellraw @s[scores={DialogueTrigger=212,TalkTime=215}] {"text":"<Team Flare Xerosic> There's no way she will hear you now!"}

