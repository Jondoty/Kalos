tellraw @s[scores={DialogueTrigger=226,TalkTime=17}] {"text":"<Emma> Thanks to the Expansion Suit, it's easy to go anywhere."}]
tellraw @s[scores={DialogueTrigger=226,TalkTime=26}] {"text":"<Emma> And with the Pokémon that Xerosic gave me, I can deal with any kind of job request!"}]
