tellraw @s[scores={DialogueTrigger=182,TalkTime=40}] [<Looker> From your manner of speaking, madame, I deduce that you have traveled far indeed!"}]
tellraw @s[scores={DialogueTrigger=182,TalkTime=50}] [<Looker> I am...Looker. What may I do for you?"}]
