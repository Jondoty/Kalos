tellraw @s[scores={DialogueTrigger=215,TalkTime=4}] {"text":"<Punk Guy> Wotcher! How's it going, "},{"selector":"@s"},{"text":"?"}]
tellraw @s[scores={DialogueTrigger=215,TalkTime=12}] {"text":"<Punk Guy> I was bored, so I came over!"}]
tellraw @s[scores={DialogueTrigger=215,TalkTime=19}] {"text":"<Punk Guy> Eh, when I was comin' in just now, Emma were tearin' out in a hurry! Somethink happenin'?"}]
tellraw @s[scores={DialogueTrigger=215,TalkTime=29}] {"text":"<Punk Guy> Now you're gonna up and leave, too?!"}]
tellraw @s[scores={DialogueTrigger=215,TalkTime=37}] {"text":"<Punk Guy> I came all the way over here to visit! Why you all gotta be so cold like that?"}]
tellraw @s[scores={DialogueTrigger=215,TalkTime=47}] {"text":"<Punk Guy> An' even old man Looker!"}]
tellraw @s[scores={DialogueTrigger=215,TalkTime=54}] {"text":"<Punk Guy> When I just ran into him, he said he had to go to the Lumiose Museum and totally blew me off without another word!"}]
tellraw @s[scores={DialogueTrigger=215,TalkTime=65}] {"text":"<Punk Guy> Gah, I'm bored outta me skull."}]
tellraw @s[scores={DialogueTrigger=215,TalkTime=72}] {"text":"<Punk Guy> Happen I shoulda gone to the museum with our Looker, after all..."}]

