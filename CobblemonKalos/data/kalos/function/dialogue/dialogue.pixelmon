#execute as @s[x=837,y=108,z=-335,r=10,tag=!Dialogue99,score_TalkTime=0] run execute as @s[tag=!Dialogue98] run scoreboard players set @s DialogueTrigger 99

tellraw @s[scores={DialogueTrigger=99,TalkTime=2}] {"text":"<Ace Trainer> As you can see, Route 17 is completely covered in snow! It's like this all year round."}
tellraw @s[scores={DialogueTrigger=99,TalkTime=12}] {"text":"<Ace Trainer> People usually ride on the back of a Mamoswine to plow their way through to the other side."}
tellraw @s[scores={DialogueTrigger=99,TalkTime=22}] {"text":"<Ace Trainer> But unfortunately, the Mamoswine is hanging out in front of the Frost Cavern and won't budge..."}

