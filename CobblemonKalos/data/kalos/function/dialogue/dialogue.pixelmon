tellraw @s[scores={DialogueTrigger=126,TalkTime=45}] {"text":"<Serena> You came all the way out here, and I wasn't very considerate of your feelings..."}]
tellraw @s[scores={DialogueTrigger=126,TalkTime=55}] {"text":"<Serena> You are right. Friends should stick together."}]
