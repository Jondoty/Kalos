execute as @s[scores={DialogueTrigger=177,TalkTime=35}] run tp @e[x=-504,y=216,z=1296,dy=3,type=pixelmon:statue] -376 101 -276

tellraw @s[scores={DialogueTrigger=177,TalkTime=38}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> Why, it's a Pokémon! But to threaten humans like that, it is apparently none too gentle..."}]
tellraw @s[scores={DialogueTrigger=177,TalkTime=48}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> It may consider this area its territory."}]
tellraw @s[scores={DialogueTrigger=177,TalkTime=55}] ["",{"text":"<"},{"text":"...","color":"yellow"},{"text":"> Yup, old man, you got that right."}]
tellraw @s[scores={DialogueTrigger=177,TalkTime=62}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> Eh? Who's there? Show yourself!"}]

#tp Emma and little girl in
execute as @s[scores={DialogueTrigger=177,TalkTime=65}] run particle cloud -378 101 -278 2 2 2 1 100
execute as @s[scores={DialogueTrigger=177,TalkTime=65}] run particle cloud -378 101 -280 2 2 2 1 100
execute as @s[scores={DialogueTrigger=177,TalkTime=65}] run tp @e[x=-504,y=215,z=1291,dy=3,type=pixelmon:npc_chatting] -378 101 -278
execute as @s[scores={DialogueTrigger=177,TalkTime=65}] run tp @e[x=-504,y=215,z=1293,dy=3,type=pixelmon:npc_chatting] -378 101 -280

tellraw @s[scores={DialogueTrigger=177,TalkTime=68}] ["",{"text":"<"},{"text":"...","color":"yellow"},{"text":"> Oh, nobody special. But this little sweetie right here is Mimi."}]
tellraw @s[scores={DialogueTrigger=177,TalkTime=76}] ["",{"text":"<"},{"text":"...","color":"yellow"},{"text":"> That's what I named it, anyway."}]
tellraw @s[scores={DialogueTrigger=177,TalkTime=83}] ["",{"text":"<"},{"text":"Mimi","color":"light_purple"},{"text":"> Mrrawr! Mrrrawwwrrr!"}]
execute as @s[scores={DialogueTrigger=177,TalkTime=83}] run playsound espurr hostile @s ~ ~ ~ 100 1 1
tellraw @s[scores={DialogueTrigger=177,TalkTime=87}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> Ahem. Then this is your Pokémon?"}]
tellraw @s[scores={DialogueTrigger=177,TalkTime=92}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> In which case, would you mind returning it to its Poké Ball for a bit?"}]
tellraw @s[scores={DialogueTrigger=177,TalkTime=100}] ["",{"text":"<"},{"text":"...","color":"yellow"},{"text":"> Huh? What Poké Ball?"}]
tellraw @s[scores={DialogueTrigger=177,TalkTime=106}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> Pardon?"}]
tellraw @s[scores={DialogueTrigger=177,TalkTime=111}] ["",{"text":"<"},{"text":"...","color":"yellow"},{"text":"> I'm not a Trainer! Mimi is my friend."}]
tellraw @s[scores={DialogueTrigger=177,TalkTime=119}] ["",{"text":"<"},{"text":"...","color":"yellow"},{"text":"> I have no money to buy Poké Balls, so I can't be a Trainer, you get it?"}]
tellraw @s[scores={DialogueTrigger=177,TalkTime=129}] ["",{"text":"<"},{"text":"...","color":"yellow"},{"text":"> Anyway, Mimi and I don't need a Poké Ball to be friends!"}]
tellraw @s[scores={DialogueTrigger=177,TalkTime=137}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> Of course. I...get it. Please forgive my error."}]
tellraw @s[scores={DialogueTrigger=177,TalkTime=145}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> My name is Looker. I work as a detective."}]
tellraw @s[scores={DialogueTrigger=177,TalkTime=153}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> May I introduce my partner, "},{"selector":"@s"},{"text":"."}]
tellraw @s[scores={DialogueTrigger=177,TalkTime=160}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> If you will permit me to ask, Mimi's friend..."}]
tellraw @s[scores={DialogueTrigger=177,TalkTime=167}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> I am interested in what you're all doing here."}]
tellraw @s[scores={DialogueTrigger=177,TalkTime=175}] ["",{"text":"<"},{"text":"...","color":"yellow"},{"text":"> Well, we're all playing, that's all. Everybody here is a friend of mine."}]
tellraw @s[scores={DialogueTrigger=177,TalkTime=185}] ["",{"text":"<"},{"text":"...","color":"yellow"},{"text":"> What are you asking for? Do you want to join or something?"}]
tellraw @s[scores={DialogueTrigger=177,TalkTime=193}] ["",{"text":"<"},{"text":"...","color":"light_purple"},{"text":"> What! No, no, no-o-o-o-o! Don't do it!"}]
tellraw @s[scores={DialogueTrigger=177,TalkTime=200}] ["",{"text":"<"},{"text":"...","color":"light_purple"},{"text":"> This is our secret base. Kids only! No grown-ups allowed!"}]
tellraw @s[scores={DialogueTrigger=177,TalkTime=207}] ["",{"text":"<"},{"text":"Mimi","color":"light_purple"},{"text":"> Mrrawwwr!"}]
execute as @s[scores={DialogueTrigger=177,TalkTime=207}] run playsound espurr hostile @s ~ ~ ~ 100 1 1
tellraw @s[scores={DialogueTrigger=177,TalkTime=212}] ["",{"text":"<"},{"text":"...","color":"yellow"},{"text":"> Oh, put a sock in it! Play nice, both of you!"}]
tellraw @s[scores={DialogueTrigger=177,TalkTime=220}] ["",{"text":"<"},{"text":"...","color":"yellow"},{"text":"> How would you like to get left out just 'cause you're old and stuff?"}]
tellraw @s[scores={DialogueTrigger=177,TalkTime=230}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> ... ... ..."}]
tellraw @s[scores={DialogueTrigger=177,TalkTime=235}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> You seem to have a good group of friends playing together here."}]
tellraw @s[scores={DialogueTrigger=177,TalkTime=242}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> But why did you pick a dark alley like this one to play in?"}]
tellraw @s[scores={DialogueTrigger=177,TalkTime=250}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> Lumiose City is filled with plazas and open spaces and sunny corners."}]
tellraw @s[scores={DialogueTrigger=177,TalkTime=258}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> Flowers can't bloom without sunshine, and neither can young folks, you know."}]
tellraw @s[scores={DialogueTrigger=177,TalkTime=268}] ["",{"text":"<"},{"text":"...","color":"yellow"},{"text":"> Oh, really? Well... Mimi and I have always lived in alleys, so I don't know much about sunshine."}]
tellraw @s[scores={DialogueTrigger=177,TalkTime=278}] ["",{"text":"<"},{"text":"Mimi","color":"light_purple"},{"text":"> ...Mrawp."}]
execute as @s[scores={DialogueTrigger=177,TalkTime=278}] run playsound espurr hostile @s ~ ~ ~ 100 1 1
tellraw @s[scores={DialogueTrigger=177,TalkTime=283}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> You live in an alley? You and Mimi? And...your family? They--"}]
tellraw @s[scores={DialogueTrigger=177,TalkTime=291}] ["",{"text":"<"},{"text":"...","color":"yellow"},{"text":"> They're gone. I'm alone."}]
tellraw @s[scores={DialogueTrigger=177,TalkTime=298}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> I see."}]
tellraw @s[scores={DialogueTrigger=177,TalkTime=304}] ["",{"text":"<"},{"text":"...","color":"yellow"},{"text":"> Well, but... But Mimi is sort of my family. We stick together."}]
tellraw @s[scores={DialogueTrigger=177,TalkTime=312}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> Indeed..."}]
tellraw @s[scores={DialogueTrigger=177,TalkTime=317}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> Indeed! I, Looker, have struck upon an idea!"}]
tellraw @s[scores={DialogueTrigger=177,TalkTime=325}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> A genius idea. And here it is! Friend of Mimi!"}]
tellraw @s[scores={DialogueTrigger=177,TalkTime=332}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> I invite you to stay at my office, the Looker Bureau."}]
tellraw @s[scores={DialogueTrigger=177,TalkTime=340}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> You may work as my assistant and, in exchange, you may live in the office."}]
tellraw @s[scores={DialogueTrigger=177,TalkTime=350}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> I myself live elsewhere in a hotel, so you'll have it all to yourself after hours!"}]
tellraw @s[scores={DialogueTrigger=177,TalkTime=360}] ["",{"text":"<"},{"text":"...","color":"yellow"},{"text":"> Wha..."}]
tellraw @s[scores={DialogueTrigger=177,TalkTime=365}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> It is not to imply that anything's wrong with a free life in the alleys, but..."}]
tellraw @s[scores={DialogueTrigger=177,TalkTime=375}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> To have a home to shelter you from the cold and the rain..."}]
tellraw @s[scores={DialogueTrigger=177,TalkTime=384}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> There is joy in having work to do each day and your efforts seen and appreciated."}]
tellraw @s[scores={DialogueTrigger=177,TalkTime=394}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> This idea is genius, even for me!"}]
tellraw @s[scores={DialogueTrigger=177,TalkTime=401}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> And, Mimi, are you on board, too? It wouldn't be the same without you!"}]
tellraw @s[scores={DialogueTrigger=177,TalkTime=410}] ["",{"text":"<"},{"text":"Mimi","color":"light_purple"},{"text":"> Mrrrawr... Mrrawwwr!"}]
execute as @s[scores={DialogueTrigger=177,TalkTime=410}] run playsound espurr hostile @s ~ ~ ~ 100 1 1

#Espurr tps off
execute as @s[scores={DialogueTrigger=177,TalkTime=415}] run particle cloud -376 101 -276 2 2 2 1 100
execute as @s[scores={DialogueTrigger=177,TalkTime=415}] run tp @e[x=-376,y=100,z=-276,dy=3,type=pixelmon:statue] -504 217 1296

tellraw @s[scores={DialogueTrigger=177,TalkTime=420}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> Wh-what? Why did Mimi run off?"}]
tellraw @s[scores={DialogueTrigger=177,TalkTime=427}] ["",{"text":"<"},{"text":"...","color":"yellow"},{"text":"> Mimi gets scared pretty easy. Afraid of humans, I guess. Especially grown-ups."}]
tellraw @s[scores={DialogueTrigger=177,TalkTime=437}] ["",{"text":"<"},{"text":"...","color":"yellow"},{"text":"> Hey... Mr. Looker-guy..."}]
tellraw @s[scores={DialogueTrigger=177,TalkTime=443}] ["",{"text":"<"},{"text":"...","color":"yellow"},{"text":"> For a minute there, I was kinda happy that you invited me to stay with you..."}]
tellraw @s[scores={DialogueTrigger=177,TalkTime=453}] ["",{"text":"<"},{"text":"...","color":"yellow"},{"text":"> You're pretty cool. But I can't. Mimi likes it better here."}]
tellraw @s[scores={DialogueTrigger=177,TalkTime=463}] ["",{"text":"<"},{"text":"...","color":"yellow"},{"text":"> I can't leave Mimi behind. We stick together."}]
tellraw @s[scores={DialogueTrigger=177,TalkTime=470}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> Hold on! Mimi may grow to like me in time. But even if not, we can try a new angle"}]
tellraw @s[scores={DialogueTrigger=177,TalkTime=480}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> At a time like this, it helps to have a partner you can count on."}]
tellraw @s[scores={DialogueTrigger=177,TalkTime=488}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> P-partner?"}]

#Looker music changes
execute as @s[scores={DialogueTrigger=177,TalkTime=487}] run scoreboard players set @s click 1

tellraw @s[scores={DialogueTrigger=177,TalkTime=493}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> Indeed! "},{"selector":"@s"},{"text":"! Your assignment is to befriend Mimi. You can do it!"}]
tellraw @s[scores={DialogueTrigger=177,TalkTime=502}] ["",{"text":"<"},{"text":"...","color":"yellow"},{"text":"> If you wanna make friends with Mimi, you're gonna have to track it down first."}]
tellraw @s[scores={DialogueTrigger=177,TalkTime=511}] ["",{"text":"<"},{"text":"...","color":"yellow"},{"text":"> There's, like, tons of alleys in Lumiose City."}]
tellraw @s[scores={DialogueTrigger=177,TalkTime=520}] ["",{"text":"<"},{"text":"...","color":"yellow"},{"text":"> Mimi wanders all over them on its strolls. If you find it, try talking to it..."}]
tellraw @s[scores={DialogueTrigger=177,TalkTime=530}] ["",{"text":"<"},{"text":"...","color":"yellow"},{"text":"> Or do something to make Mimi like you. We'll help the search, too."}]

