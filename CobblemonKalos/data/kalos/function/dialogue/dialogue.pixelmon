tellraw @s[scores={DialogueTrigger=148,TalkTime=12}] {"text":"<Malva> I am one of the Elite Four. People know me as the Fire-type-Pokémon user, Malva."}
tellraw @s[scores={DialogueTrigger=148,TalkTime=22}] {"text":"<Malva> Here in the Pokémon League, you'll encounter the four of us--the Elite Four--and our Champion."}
tellraw @s[scores={DialogueTrigger=148,TalkTime=32}] {"text":"<Malva> If you hope to meet the Champion and challenge her here, you must first defeat the four of us."}
tellraw @s[scores={DialogueTrigger=148,TalkTime=42}] {"text":"<Malva> Do your best, because if you can't impress us with your real strength, you'll never get to battle her."}
tellraw @s[scores={DialogueTrigger=148,TalkTime=52}] {"text":"<Malva> But it should be a walk in the park for you, right?"}
tellraw @s[scores={DialogueTrigger=148,TalkTime=60}] {"text":"<Malva> The \u201chero\u201d who destroyed big, bad Team Flare."}

#Malva tps off
execute as @s[scores={DialogueTrigger=148,TalkTime=67}] run tp @e[x=-1907,y=31,z=2117,dy=3,type=pixelmon:npc_chatting] -504 171 1284
execute as @s[scores={DialogueTrigger=148,TalkTime=67}] run particle cloud -1907 33 2117 2 2 2 1 100

tag @s[scores={DialogueTrigger=148,TalkTime=67..}] add Dialogue148
scoreboard players set @s[tag=Dialogue148] TalkTime 0
scoreboard players set @s[tag=Dialogue148] DialogueTrigger 0

#----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
#Diantha first time you battle her
#Dialogue149

tellraw @s[scores={DialogueTrigger=149,TalkTime=4}] {"text":"<Diantha> Welcome at last, dear Trainer."}
tellraw @s[scores={DialogueTrigger=149,TalkTime=12}] {"text":"<Diantha> As you must know, I am the Champion, Diantha."}
tellraw @s[scores={DialogueTrigger=149,TalkTime=19}] {"text":"<Diantha> Oh, but you are..."}
tellraw @s[scores={DialogueTrigger=149,TalkTime=25}] {"text":"<Diantha> You're the child I spoke to in Lumiose City and Coumarine City, aren't you?!"}
tellraw @s[scores={DialogueTrigger=149,TalkTime=33}] {"text":"<Diantha> Then that means that you are also the one that dear Augustine said..."}
tellraw @s[scores={DialogueTrigger=149,TalkTime=41}] {"text":"<Diantha> Of course! How could I--?!"}
tellraw @s[scores={DialogueTrigger=149,TalkTime=47}] {"text":"<Diantha> Oh, I must look like such a fool not to recognize you sooner!"}
tellraw @s[scores={DialogueTrigger=149,TalkTime=56}] {"text":"<Diantha> You and your Pokémon are the ones who stopped Team Flare for us all!"}
tellraw @s[scores={DialogueTrigger=149,TalkTime=65}] {"text":"<Diantha> It seems wrong of me to say this, but thank you! You saved us all..."}
tellraw @s[scores={DialogueTrigger=149,TalkTime=74}] {"text":"<Diantha> I can't wait to see what you and your Pokémon are capable of now that I know exactly what it is you've done already!"}

tag @s[scores={DialogueTrigger=149,TalkTime=74..}] add Dialogue149
scoreboard players set @s[tag=Dialogue149] TalkTime 0
scoreboard players set @s[tag=Dialogue149] DialogueTrigger 0

#----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
#Diantha first time post-battle
#/tedit add LOSS /scoreboard players set @pl DialogueTrigger 150
#/tedit add LOSS /scoreboard players set @pl TalkTime 0

#Resets if player beats Diantha more than once

tellraw @s[scores={DialogueTrigger=150,TalkTime=6}] {"text":"<Diantha> I-I'm so choked up that it's hard to know what I should say, but I...I..."}
tellraw @s[scores={DialogueTrigger=150,TalkTime=16}] {"text":"<Diantha> I'm just so glad at this moment that I was good enough to be the Champion..."}
tellraw @s[scores={DialogueTrigger=150,TalkTime=26}] {"text":"<Diantha> After all, it gave me the chance to meet and battle with you and your wonderful Pokémon!"}
tellraw @s[scores={DialogueTrigger=150,TalkTime=36}] {"text":"<Diantha> Now I understand why dear Augustine-- Professor Sycamore-"}
tellraw @s[scores={DialogueTrigger=150,TalkTime=45}] {"text":"<Diantha> said he needed to get Lumiose City ready for the new Champion."}
tellraw @s[scores={DialogueTrigger=150,TalkTime=54}] {"text":"<Diantha> But before I take you there..."}
tellraw @s[scores={DialogueTrigger=150,TalkTime=62}] ["",{"text":"<Diantha> My dear "},{"selector":"@s"},{"text":", would you mind stepping through the door behind me?"}]

tag @s[scores={DialogueTrigger=150,TalkTime=62..}] add Dialogue150
scoreboard players set @s[tag=Dialogue150] TalkTime 0
scoreboard players set @s[tag=Dialogue150] DialogueTrigger 0

#----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
#Diantha second and above time you meet her in the League
#Dialogue151
#REPEATED, Will be reset when player enters the Pokemon League again along with E4 tags

tellraw @s[scores={DialogueTrigger=151,TalkTime=3}] {"text":"<Diantha> Oh, welcome back! I've been hoping that you would visit again!"}
tellraw @s[scores={DialogueTrigger=151,TalkTime=13}] {"text":"<Diantha> Battling against you and your Pokémon, all of you brimming with hope for the future..."}
tellraw @s[scores={DialogueTrigger=151,TalkTime=23}] {"text":"<Diantha> Honestly, it just fills me up with the energy I need to keep facing each new day! It does!"}
tellraw @s[scores={DialogueTrigger=151,TalkTime=33}] {"text":"<Diantha> That positive hope for the future and the warm feelings that fill your heart..."}
tellraw @s[scores={DialogueTrigger=151,TalkTime=43}] {"text":"<Diantha> Those things can never be exhausted. They will never run out. Not ever."}
tellraw @s[scores={DialogueTrigger=151,TalkTime=53}] {"text":"<Diantha> If you just find a way to share them with others, I know you'll have a happy life."}

tag @s[scores={DialogueTrigger=151,TalkTime=53..}] add Dialogue151
scoreboard players set @s[tag=Dialogue151] TalkTime 0
scoreboard players set @s[tag=Dialogue151] DialogueTrigger 0

#----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
#Hall of Fame first time a player beats the League
#Dialogue152

tellraw @s[scores={DialogueTrigger=152,TalkTime=3}] {"text":"<Diantha> Here we are! I'm so glad to welcome you in."}
tellraw @s[scores={DialogueTrigger=152,TalkTime=10}] {"text":"<Diantha> This grand chamber is where you enter the Kalos region's Hall of fame."}
tellraw @s[scores={DialogueTrigger=152,TalkTime=19}] {"text":"<Diantha> This is where Pokémon Trainers will live on forever,"}
tellraw @s[scores={DialogueTrigger=152,TalkTime=27}] {"text":"<Diantha> remembered always for giving their all in battle to the Pokémon League and for the glory and light that they shared with all."}
tellraw @s[scores={DialogueTrigger=152,TalkTime=39}] ["",{"text":"<Diantha> Come, "},{"selector":"@s"},{"text":"\u2026 Your love for your Pokémon\u2026 "}]
tellraw @s[scores={DialogueTrigger=152,TalkTime=48}] {"text":"<Diantha> And the way that those Pokémon gave everything they had in battle for you\u2026"}
tellraw @s[scores={DialogueTrigger=152,TalkTime=57}] {"text":"<Diantha> We'll record them all right here, at this healer, for eternity."}

tag @s[scores={DialogueTrigger=152,TalkTime=57..}] add Dialogue152
scoreboard players set @s[tag=Dialogue152] TalkTime 0
scoreboard players set @s[tag=Dialogue152] DialogueTrigger 0

