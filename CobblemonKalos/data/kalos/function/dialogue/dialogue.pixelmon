tellraw @s[scores={DialogueTrigger=118,TalkTime=5}] {"text":"<Team Flare Xerosic> Wonderful! Amazing! You have tremendous skill and bravery!"}
tellraw @s[scores={DialogueTrigger=118,TalkTime=13}] {"text":"<Team Flare Xerosic> When you add that up, it means I will tell you something very interesting."}
tellraw @s[scores={DialogueTrigger=118,TalkTime=22}] {"text":"<Team Flare Xerosic> It happened 3,000 years ago."}
tellraw @s[scores={DialogueTrigger=118,TalkTime=29}] {"text":"<Team Flare Xerosic> The ultimate weapon was used to put an end to the war in an instant."}
tellraw @s[scores={DialogueTrigger=118,TalkTime=38}] {"text":"<Team Flare Xerosic> If we use that incredible power, we can finally free Kalos of the foolish humans that plague it!"}
tellraw @s[scores={DialogueTrigger=118,TalkTime=48}] ["",{"text":"<Team Flare Xerosic> Behind me you'll find a "},{"text":"red button","color":"red"},{"text":" and a "},{"text":"blue button","color":"dark_aqua"},{"text":"."}]
tellraw @s[scores={DialogueTrigger=118,TalkTime=57}] {"text":"<Team Flare Xerosic> One of them is the button for activating the ultimate weapon."}
tellraw @s[scores={DialogueTrigger=118,TalkTime=65}] {"text":"<Team Flare Xerosic> Push one now! Come on! Push one!"}

execute as @s[scores={DialogueTrigger=118,TalkTime=65}] run advancement grant @s only kalos:flare6

