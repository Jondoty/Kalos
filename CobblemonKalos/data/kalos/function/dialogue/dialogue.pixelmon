#Hotel Guests Tourist Information
#Dialogue221

tellraw @s[scores={DialogueTrigger=221,TalkTime=1,TalkTrigger=36}] {"text":"<Tourist> Oh, Viola! Viola is the Gym Leader of Santalune City."}
tellraw @s[scores={DialogueTrigger=221,TalkTime=10,TalkTrigger=36}] {"text":"<Tourist> Not only is she an expert with Bug-type Pokémon, but she's also an up-and-coming photography pro!"}
tellraw @s[scores={DialogueTrigger=221,TalkTime=20,TalkTrigger=36}] {"text":"<Tourist> Her older sister, Alexa, happens to be a reporter!"}


tellraw @s[scores={DialogueTrigger=221,TalkTime=1,TalkTrigger=37}] {"text":"<Tourist> Korrina! Sweet, sweet Korrina! A first-rate Roller Skater and also the Gym Leader of Shalour City!"}
tellraw @s[scores={DialogueTrigger=221,TalkTime=12,TalkTrigger=37}] {"text":"<Tourist> Keep this between us, but I hear she can use some kind of amazing secret power."}
tellraw @s[scores={DialogueTrigger=221,TalkTime=22,TalkTrigger=37}] {"text":"<Tourist> Let's hear it once more for the spectacular Korrina!"}


tellraw @s[scores={DialogueTrigger=221,TalkTime=1,TalkTrigger=38}] {"text":"<Tourist> Valerie... What to call her? Miss Valerie? Lady Valerie? She definitely needs some kind of title."}
tellraw @s[scores={DialogueTrigger=221,TalkTime=12,TalkTrigger=38}] {"text":"<Tourist> Oh, never mind my rambling! She's a fashion designer from the Johto region and also happens to be the Gym Leader of Laverre City!"}
tellraw @s[scores={DialogueTrigger=221,TalkTime=23,TalkTrigger=38}] {"text":"<Tourist> She's also got this certain mysterious charm about her that's really hard to put into words!"}


tellraw @s[scores={DialogueTrigger=221,TalkTime=1,TalkTrigger=39}] {"text":"<Tourist> Lady Olympia! A mystery wrapped in an enigma! Little is known about the Gym Leader of Anistar City."}
tellraw @s[scores={DialogueTrigger=221,TalkTime=12,TalkTrigger=39}] {"text":"<Tourist> One thing is for sure, though--she's second to none when it comes to fortune-telling!"}
tellraw @s[scores={DialogueTrigger=221,TalkTime=23,TalkTrigger=39}] {"text":"<Tourist> Whether it's predicting one's love prospects or the fate of a corporation, she nails it every time!"}

execute as @s[scores={DialogueTrigger=221,TalkTime=23}] run scoreboard players set @s TalkTrigger 0

