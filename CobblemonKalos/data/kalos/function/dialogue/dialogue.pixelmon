#----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
#https://youtu.be/qEms9_nJ7M0?t=69324
#Xerosic's Notes #1 (-295 32 284)
#/tedit add INTERACT /scoreboard players set @pl TalkTrigger 200
#execute as @s[score_TalkTrigger_min=200,score_TalkTrigger=200,score_TalkTime=0] run scoreboard players set @s DialogueTrigger 202

tellraw @s[scores={DialogueTrigger=202,TalkTime=1}] {"text":"EXPANSION SUIT SPECS","italic":true}
tellraw @s[scores={DialogueTrigger=202,TalkTime=8}] {"text":"1. Physical Enhancement Heightens physical abilities of the wearer with built-in muscle-enhancing technology.","italic":true}
tellraw @s[scores={DialogueTrigger=202,TalkTime=18}] {"text":"2. Poké Ball Jack A hacking cable on the neck piece allows the wearer to upload a computer virus to Poké Balls and override their systems.","italic":true}
tellraw @s[scores={DialogueTrigger=202,TalkTime=30}] {"text":"This provides access to control the Pokémon. The virus also magnifies the Pokémon's power.","italic":true}
tellraw @s[scores={DialogueTrigger=202,TalkTime=39}] {"text":"3. Surface Texturing Optically disguises the wearer,","italic":true}
tellraw @s[scores={DialogueTrigger=202,TalkTime=47}] {"text":"based on the current understanding of Kecleon and Ditto's physical transformations.","italic":true}
tellraw @s[scores={DialogueTrigger=202,TalkTime=56}] {"text":"4. Remote Control Remote control of the suit protects against the risk of its wearer going renegade.","italic":true}
tellraw @s[scores={DialogueTrigger=202,TalkTime=65}] {"text":"AI personalities are preprogrammed, modeled on common Trainer types.","italic":true}
tellraw @s[scores={DialogueTrigger=202,TalkTime=73}] {"text":"When the suit is controlled remotely, the wearer's consciousness is suppressed.","italic":true}
tellraw @s[scores={DialogueTrigger=202,TalkTime=82}] {"text":"The wearer experiences a coma-like state.","italic":true}

tag @s[scores={DialogueTrigger=202,TalkTime=82..}] add Dialogue202
scoreboard players set @s[tag=Dialogue202] TalkTime 0
scoreboard players set @s[tag=Dialogue202] DialogueTrigger 0

#----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
#https://youtu.be/qEms9_nJ7M0?t=69365
#Xerosic's Notes #2 (-289 32 295)
#/tedit add INTERACT /scoreboard players set @pl TalkTrigger 201
#execute as @s[score_TalkTrigger_min=201,score_TalkTrigger=201,score_TalkTime=0] run scoreboard players set @s DialogueTrigger 203

tellraw @s[scores={DialogueTrigger=203,TalkTime=1}] {"text":"Expansion Suit Field Trials Secret Records: Volume 1","italic":true}
tellraw @s[scores={DialogueTrigger=203,TalkTime=10}] {"text":"The XXth day of the XXth month...","italic":true}
tellraw @s[scores={DialogueTrigger=203,TalkTime=17}] {"text":"Posted an advertisement for part-time work at the Lysandre Café to recruit a test subject for the suit's field trials.","italic":true}
tellraw @s[scores={DialogueTrigger=203,TalkTime=29}] {"text":"The Expansion Suit should make even an average Trainer into a superhuman force, a force to be reckoned with...","italic":true}
tellraw @s[scores={DialogueTrigger=203,TalkTime=39}] {"text":"It is the ultimate result of my life's study-- my magnum opus.","italic":true}
tellraw @s[scores={DialogueTrigger=203,TalkTime=47}] {"text":"The trials must be a success! I wait on the appearance of a young, healthy, and ambitious test subject.","italic":true}

tag @s[scores={DialogueTrigger=203,TalkTime=47..}] add Dialogue203
scoreboard players set @s[tag=Dialogue203] TalkTime 0
scoreboard players set @s[tag=Dialogue203] DialogueTrigger 0

#----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
#https://youtu.be/azyrTT_H1E8?t=1272
#Xerosic's Notes #3 (-290 32 301)
#/tedit add INTERACT /scoreboard players set @pl TalkTrigger 202
#execute as @s[score_TalkTrigger_min=202,score_TalkTrigger=202,score_TalkTime=0] run scoreboard players set @s DialogueTrigger 204

tellraw @s[scores={DialogueTrigger=204,TalkTime=1}] {"text":"Expansion Suit Field Trials Secret Records: Volume 2","italic":true}
tellraw @s[scores={DialogueTrigger=204,TalkTime=10}] {"text":"The XXth day of the XXth month...","italic":true}
tellraw @s[scores={DialogueTrigger=204,TalkTime=17}] {"text":"At long last, a response came to my advertisement for part-time work.","italic":true}
tellraw @s[scores={DialogueTrigger=204,TalkTime=25}] {"text":"The subject's name is Emma. She is a healthy girl, 16 years of age.","italic":true}
tellraw @s[scores={DialogueTrigger=204,TalkTime=33}] {"text":"When I attempted to explain the intent of my research, she gave little sign of understanding.","italic":true}
tellraw @s[scores={DialogueTrigger=204,TalkTime=42}] {"text":"She does appear to understand the passion I have put into the suit research,","italic":true}
tellraw @s[scores={DialogueTrigger=204,TalkTime=50}] {"text":"and she showed interest in continuing with the trials.","italic":true}
tellraw @s[scores={DialogueTrigger=204,TalkTime=57}] {"text":"Now that Team Flare has been disbanded, my funds are running severely low.","italic":true}
tellraw @s[scores={DialogueTrigger=204,TalkTime=66}] {"text":"I hired her on the spot. The trials must proceed with no time lost.","italic":true}
tellraw @s[scores={DialogueTrigger=204,TalkTime=74}] {"text":"First, I'll measure Emma's physical and mental abilities to ensure she can complete the trials.","italic":true}
tellraw @s[scores={DialogueTrigger=204,TalkTime=84}] {"text":"The XXth day of the XXth month... I have customized the suit to better fit Emma's frame.","italic":true}
tellraw @s[scores={DialogueTrigger=204,TalkTime=94}] {"text":"The XXth day of the XXth month... ","italic":true}
tellraw @s[scores={DialogueTrigger=204,TalkTime=102}] {"text":"I have designated the code name Essentia to be used when Emma is wearing the Expansion Suit.","italic":true}

tag @s[scores={DialogueTrigger=204,TalkTime=102..}] add Dialogue204
scoreboard players set @s[tag=Dialogue204] TalkTime 0
scoreboard players set @s[tag=Dialogue204] DialogueTrigger 0

#----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
#https://youtu.be/qEms9_nJ7M0?t=69259
#Xerosic's Notes #4 (-301 29 313)
#/tedit add INTERACT /scoreboard players set @pl TalkTrigger 203
#execute as @s[score_TalkTrigger_min=203,score_TalkTrigger=203,score_TalkTime=0] run scoreboard players set @s DialogueTrigger 205

tellraw @s[scores={DialogueTrigger=205,TalkTime=1}] {"text":"Expansion Suit Field Trials Secret Records: Volume 3","italic":true}
tellraw @s[scores={DialogueTrigger=205,TalkTime=10}] {"text":"The XXth day of the XXth month...","italic":true}
tellraw @s[scores={DialogueTrigger=205,TalkTime=17}] {"text":"As we make final preparations for the trials, a new trouble strikes.","italic":true}
tellraw @s[scores={DialogueTrigger=205,TalkTime=25}] {"text":"I have learned that Emma has no experience as a Pokémon Trainer!","italic":true}
tellraw @s[scores={DialogueTrigger=205,TalkTime=33}] {"text":"With little other choice, I am forced to instruct the girl on all the basics.","italic":true}

tag @s[scores={DialogueTrigger=205,TalkTime=33..}] add Dialogue205
scoreboard players set @s[tag=Dialogue205] TalkTime 0
scoreboard players set @s[tag=Dialogue205] DialogueTrigger 0

#----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
#https://youtu.be/qEms9_nJ7M0?t=69298
#Xerosic's Notes #5 (-285 29 313)
#/tedit add INTERACT /scoreboard players set @pl TalkTrigger 204
#execute as @s[score_TalkTrigger_min=204,score_TalkTrigger=204,score_TalkTime=0] run scoreboard players set @s DialogueTrigger 206

tellraw @s[scores={DialogueTrigger=206,TalkTime=1}] {"text":"Expansion Suit Field Trials Secret Records: Volume 4","italic":true}
tellraw @s[scores={DialogueTrigger=206,TalkTime=10}] {"text":"The XXth day of the XXth month... Finally, the trials are underway.","italic":true}
tellraw @s[scores={DialogueTrigger=206,TalkTime=18}] {"text":"The first trial is designed to test the suit's physical capabilities.","italic":true}
tellraw @s[scores={DialogueTrigger=206,TalkTime=26}] {"text":"Using the texturing function, the subject has infiltrated the closely guarded art museum and left an insignia on a historical mural.","italic":true}
tellraw @s[scores={DialogueTrigger=206,TalkTime=38}] {"text":"The remote-control function has worked without complications thus far.","italic":true}
tellraw @s[scores={DialogueTrigger=206,TalkTime=46}] {"text":"Emma shows no ill effects from her time in the suit. Her memory is blank.","italic":true}
tellraw @s[scores={DialogueTrigger=206,TalkTime=54}] {"text":"When questioned, she describes her experience as \u201ctaking a nap.\u201d","italic":true}
tellraw @s[scores={DialogueTrigger=206,TalkTime=62}] {"text":"Perhaps I will give her a bonus in celebration of this successful trial.","italic":true}

tag @s[scores={DialogueTrigger=206,TalkTime=62..}] add Dialogue206
scoreboard players set @s[tag=Dialogue206] TalkTime 0
scoreboard players set @s[tag=Dialogue206] DialogueTrigger 0

#----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
#https://youtu.be/azyrTT_H1E8?t=1316
#Xerosic's Notes #6 (-286 29 318)
#/tedit add INTERACT /scoreboard players set @pl TalkTrigger 205
#execute as @s[score_TalkTrigger_min=205,score_TalkTrigger=205,score_TalkTime=0] run scoreboard players set @s DialogueTrigger 207

tellraw @s[scores={DialogueTrigger=207,TalkTime=1}] {"text":"Expansion Suit Field Trials Secret Records: Volume 5","italic":true}
tellraw @s[scores={DialogueTrigger=207,TalkTime=10}] {"text":"The XXth day of the XXth month...","italic":true}
tellraw @s[scores={DialogueTrigger=207,TalkTime=17}] {"text":"Trials begin of a key part of the Expansion Suit: the hacking cable I've called the Poké Ball Jack.","italic":true}
tellraw @s[scores={DialogueTrigger=207,TalkTime=28}] {"text":"With the texturing function enabled, the subject battles Trainers around the city.","italic":true}
tellraw @s[scores={DialogueTrigger=207,TalkTime=37}] {"text":"She then collects the Poké Balls from Trainers she defeats, so that we may use them in our tests.","italic":true}
tellraw @s[scores={DialogueTrigger=207,TalkTime=47}] {"text":"The results of the tests have been quite favorable thus far.","italic":true}
tellraw @s[scores={DialogueTrigger=207,TalkTime=55}] {"text":"However, these trials have not been entirely free from incident.","italic":true}
tellraw @s[scores={DialogueTrigger=207,TalkTime=63}] {"text":"Some apparent acquaintances of Emma's are proving to be a hindrance to our progress.","italic":true}
tellraw @s[scores={DialogueTrigger=207,TalkTime=72}] {"text":"Among these acquaintances is a Trainer who appears to be the new Champion, but this is not yet confirmed.","italic":true}
tellraw @s[scores={DialogueTrigger=207,TalkTime=83}] {"text":"We encountered a glitch in the remote-control programming, and I lost control for a brief period.","italic":true}
tellraw @s[scores={DialogueTrigger=207,TalkTime=93}] {"text":"Fearing possible effects on Emma, I suspended the trials temporarily.","italic":true}
tellraw @s[scores={DialogueTrigger=207,TalkTime=100}] {"text":"When we returned to the secret base, I examined the girl for signs of damage, but she appeared to be unharmed.","italic":true}
tellraw @s[scores={DialogueTrigger=207,TalkTime=112}] {"text":"She still retains no memories from her intervals in the suit.","italic":true}
tellraw @s[scores={DialogueTrigger=207,TalkTime=120}] {"text":"The one thing she admitted was experiencing \u201ca frightful dream.\u201d","italic":true}

tag @s[scores={DialogueTrigger=207,TalkTime=120..}] add Dialogue207
scoreboard players set @s[tag=Dialogue207] TalkTime 0
scoreboard players set @s[tag=Dialogue207] DialogueTrigger 0

