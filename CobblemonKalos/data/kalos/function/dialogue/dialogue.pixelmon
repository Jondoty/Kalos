tellraw @s[scores={DialogueTrigger=178,TalkTime=29}] [<Looker> Oh! "},{"selector":"@s"},{"text":"! Well done! Mimi seems to have taken a shine to you!"}]
tellraw @s[scores={DialogueTrigger=178,TalkTime=39}] ["",{"text":"<"},{"text":"...","color":"yellow"},{"text":"> Awesome! "},{"selector":"@s"},{"text":", are you wicked or what? "}]
tellraw @s[scores={DialogueTrigger=178,TalkTime=47}] ["",{"text":"<"},{"text":"...","color":"yellow"},{"text":"> How'd you get Mimi to like you so fast?"}]
tellraw @s[scores={DialogueTrigger=178,TalkTime=55}] [<Looker> Thank you, "},{"selector":"@s"},{"text":". You have proven your worth as my partner."}]
tellraw @s[scores={DialogueTrigger=178,TalkTime=65}] [<Looker> Well, friend of Mimi? Problem solved? All set?"}]
tellraw @s[scores={DialogueTrigger=178,TalkTime=73}] [<Looker> Is it time for you to graduate from life on the streets and join the Looker Bureau as my assistant?"}]
tellraw @s[scores={DialogueTrigger=178,TalkTime=84}] ["",{"text":"<"},{"text":"...","color":"yellow"},{"text":"> OK! I'm ready! As long as Mimi's with me!"}]
tellraw @s[scores={DialogueTrigger=178,TalkTime=92}] ["",{"text":"<"},{"text":"...","color":"yellow"},{"text":"> I'm pretty curious to find out what a detective does!"}]
tellraw @s[scores={DialogueTrigger=178,TalkTime=100}] [<Looker> Ha ha! A detective is a hard-boiled kind of person!"}]
tellraw @s[scores={DialogueTrigger=178,TalkTime=107}] [<Looker> "},{"selector":"@s"},{"text":", let us make our way to the Looker Bureau with our new assistant!"}]

