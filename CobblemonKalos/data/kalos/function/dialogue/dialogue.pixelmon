execute as @s[scores={DialogueTrigger=163,TalkTime=201}] run scoreboard players set @s Kangaskhanite 0
execute as @s[scores={DialogueTrigger=163,TalkTime=201}] run scoreboard players set @s Manectite 0
execute as @s[scores={DialogueTrigger=163,TalkTime=201}] run scoreboard players set @s Mawilite 0
