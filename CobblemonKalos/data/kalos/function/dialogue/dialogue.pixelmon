tellraw @s[scores={DialogueTrigger=233,TalkTime=5}] {"text":"<Evelyn> O-oh! Fair play! You're quite strong, aren't you, guest!"}]
tellraw @s[scores={DialogueTrigger=233,TalkTime=14}] {"text":"<Evelyn> Now that I've seen how strong you are, I feel I shouldn't have held back."}]
tellraw @s[scores={DialogueTrigger=233,TalkTime=23}] {"text":"<Evelyn> It's just that my elder sisters had asked me to take it a bit easy on new guests..."}]
tellraw @s[scores={DialogueTrigger=233,TalkTime=33}] {"text":"<Evelyn> The next time that we battle, I will try much harder to beat you!"}]
tellraw @s[scores={DialogueTrigger=233,TalkTime=42}] {"text":"<Evelyn> P-please continue to patronize the Battle Maison... And to challenge me!"}]
