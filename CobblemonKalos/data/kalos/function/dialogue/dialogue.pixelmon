#Sycamore's Introduction
#Dialogue266
#Handled through a 20-tps introduction for custom camera movement

#----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
#Inver Introduction
#

tellraw @s[scores={DialogueTrigger=267,TalkTime=1}] {"text":"<...> Oh... I wasn't expecting a vistor in a place like this."}
tellraw @s[scores={DialogueTrigger=267,TalkTime=8}] {"text":"<...> Hmm... You seem to be a pretty good trainer."}
tellraw @s[scores={DialogueTrigger=267,TalkTime=16}] {"text":"<...> Shall we have a rather strange Pokémon battle?"}
tellraw @s[scores={DialogueTrigger=267,TalkTime=23}] {"text":"<...> I call this an Inverse Battle!"}
tellraw @s[scores={DialogueTrigger=267,TalkTime=30}] {"text":"<Inver> With my mysterious power, I will reverse type matchups for a while..."}
tellraw @s[scores={DialogueTrigger=267,TalkTime=39}] {"text":"<Inver> Supereffective moves will not be very effective. Move that are not very effective will be super effective."}
tellraw @s[scores={DialogueTrigger=267,TalkTime=51}] {"text":"<Inver> What do you think? Does it sound fun?"}
tellraw @s[scores={DialogueTrigger=267,TalkTime=60}] {"text":"<Inver> You may understand it in theory, but when you try it, you'll find that it's more difficult than you thought."}

tag @s[scores={DialogueTrigger=267,TalkTime=60..}] add Dialogue267
scoreboard players set @s[tag=Dialogue267] TalkTime 0
scoreboard players set @s[tag=Dialogue267] DialogueTrigger 0

