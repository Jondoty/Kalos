#tp Viola and Hennessy in
execute as @s[scores={DialogueTrigger=166,TalkTime=1}] run tp @e[x=-504,y=205,z=1284,dy=3,type=pixelmon:npc_chatting] -1534 65 -65
execute as @s[scores={DialogueTrigger=166,TalkTime=1}] run tp @e[x=-504,y=205,z=1286,dy=3,type=pixelmon:npc_chatting] -1531 65 -65
execute as @s[scores={DialogueTrigger=166,TalkTime=1}] run particle cloud -1534 65 -65 2 2 2 1 100
execute as @s[scores={DialogueTrigger=166,TalkTime=1}] run particle cloud -1531 65 -65 2 2 2 1 100

tellraw @s[scores={DialogueTrigger=166,TalkTime=3}] ["",{"text":"<"},{"text":"Viola","color":"green"},{"text":"> Oh, if it isn't "},{"selector":"@s"},{"text":". What is your title in the nobility?"}]
tellraw @s[scores={DialogueTrigger=166,TalkTime=11}] ["",{"text":"<"},{"text":"Viola","color":"green"},{"text":"> What? You don't have a title?!"}]
tellraw @s[scores={DialogueTrigger=166,TalkTime=18}] ["",{"text":"<"},{"text":"Viola","color":"green"},{"text":"> That's a surprise. No one could doubt that a kid as strong as you should have one."}]
tellraw @s[scores={DialogueTrigger=166,TalkTime=27}] ["",{"text":"<"},{"text":"Viola","color":"green"},{"text":"> See, your title here at the Battle Chateau shows everyone just how strong you are."}]
tellraw @s[scores={DialogueTrigger=166,TalkTime=36}] ["",{"text":"<"},{"text":"Viola","color":"green"},{"text":"> Only a handful of Trainers can join the ranks of the nobility and earn these titles!"}]

tellraw @s[scores={DialogueTrigger=166,TalkTime=45,Gender=1}] {"text":"<...> Lady Viola, are you acquainted with the young gentleman?"}
tellraw @s[scores={DialogueTrigger=166,TalkTime=45,Gender=2}] {"text":"<...> Lady Viola, are you acquainted with the young lady?"}
tellraw @s[scores={DialogueTrigger=166,TalkTime=52,Gender=1}] {"text":"<...> Ahh, I see you carry the Bug Badge, young sir."}
tellraw @s[scores={DialogueTrigger=166,TalkTime=52,Gender=2}] {"text":"<...> Ahh, I see you carry the Bug Badge, young miss."}
tellraw @s[scores={DialogueTrigger=166,TalkTime=59}] {"text":"<...> It appears that Lady Viola has recognized your ability as a Trainer, then."}
tellraw @s[scores={DialogueTrigger=166,TalkTime=66,Gender=1}] {"text":"<...> It is a pleasure to meet you, my lord."}
tellraw @s[scores={DialogueTrigger=166,TalkTime=66,Gender=2}] {"text":"<...> It is a pleasure to meet you, my lady."}
tellraw @s[scores={DialogueTrigger=166,TalkTime=73}] {"text":"<Hennessy> My name is Hennessy. Might I ask your name?"}
tellraw @s[scores={DialogueTrigger=166,TalkTime=80,Gender=1}] ["",{"text":"<Hennessy> ... ... ... Sir "},{"selector":"@s"},{"text":"? A fine name."}]
tellraw @s[scores={DialogueTrigger=166,TalkTime=80,Gender=2}] ["",{"text":"<Hennessy> ... ... ... Lady "},{"selector":"@s"},{"text":"? A fine name."}]

tellraw @s[scores={DialogueTrigger=166,TalkTime=87,Gender=1}] ["",{"text":"<"},{"text":"Viola","color":"green"},{"text":"> I will gladly recommend "},{"selector":"@s"},{"text":", so will you grant him a beginning title?"}]
tellraw @s[scores={DialogueTrigger=166,TalkTime=87,Gender=2}] ["",{"text":"<"},{"text":"Viola","color":"green"},{"text":"> I will gladly recommend "},{"selector":"@s"},{"text":", so will you grant her a beginning title?"}]
tellraw @s[scores={DialogueTrigger=166,TalkTime=96,Gender=1}] ["",{"text":"<"},{"text":"Viola","color":"green"},{"text":"> He has the makings of a very strong Trainer, so I'm sure he will contribute to the Battle Chateau."}]
tellraw @s[scores={DialogueTrigger=166,TalkTime=96,Gender=2}] ["",{"text":"<"},{"text":"Viola","color":"green"},{"text":"> She has the makings of a very strong Trainer, so I'm sure she will contribute to the Battle Chateau."}]

tellraw @s[scores={DialogueTrigger=166,TalkTime=106}] {"text":"<Hennessy> Of course, ma'am!"}
tellraw @s[scores={DialogueTrigger=166,TalkTime=113,Gender=1}] {"text":"<Hennessy> If you are willing to speak for him, Lady Viola, then that is more than sufficient."}
tellraw @s[scores={DialogueTrigger=166,TalkTime=113,Gender=2}] {"text":"<Hennessy> If you are willing to speak for her, Lady Viola, then that is more than sufficient."}
tellraw @s[scores={DialogueTrigger=166,TalkTime=122,Gender=1}] ["",{"text":"<Hennessy> And besides... I, too, sense extraordinary potential emanating from young Sir "},{"selector":"@s"},{"text":"."}]
tellraw @s[scores={DialogueTrigger=166,TalkTime=122,Gender=2}] ["",{"text":"<Hennessy> And besides... I, too, sense extraordinary potential emanating from young Lady "},{"selector":"@s"},{"text":"."}]
tellraw @s[scores={DialogueTrigger=166,TalkTime=132,Gender=1}] ["",{"text":"<Hennessy> Sir "},{"selector":"@s"},{"text":"! You are hereby granted the title of Baron!"}]
tellraw @s[scores={DialogueTrigger=166,TalkTime=132,Gender=2}] ["",{"text":"<Hennessy> Lady "},{"selector":"@s"},{"text":"! You are hereby granted the title of Baroness!"}]
tellraw @s[scores={DialogueTrigger=166,TalkTime=141}] {"text":"<Hennessy> Trainers with noble titles can do battle against other Trainers with titles in the nobility here at the Battle Chateau."}
tellraw @s[scores={DialogueTrigger=166,TalkTime=152}] {"text":"<Hennessy> The title of Baron or Baroness places you at the lowest rank of nobility."}
tellraw @s[scores={DialogueTrigger=166,TalkTime=160}] {"text":"<Hennessy> Continue to battle here, and your victories will increase your rank and your title."}
tellraw @s[scores={DialogueTrigger=166,TalkTime=169,Gender=1}] {"text":"<Hennessy> Then it's likely that higher-ranking members of the nobility will appear in hope of fighting you, sir."}
tellraw @s[scores={DialogueTrigger=166,TalkTime=169,Gender=2}] {"text":"<Hennessy> Then it's likely that higher-ranking members of the nobility will appear in hope of fighting you, my lady."}
tellraw @s[scores={DialogueTrigger=166,TalkTime=180}] {"text":"<Hennessy> If you ever have any questions, please direct your inquiries to the two clerks at the door."}
tellraw @s[scores={DialogueTrigger=166,TalkTime=188,Gender=1}] ["",{"text":"<Hennessy> Well then, Sir "},{"selector":"@s"},{"text":", Lady Viola. I will take my leave now."}]
tellraw @s[scores={DialogueTrigger=166,TalkTime=188,Gender=2}] ["",{"text":"<Hennessy> Well then, Lady "},{"selector":"@s"},{"text":", Lady Viola. I will take my leave now."}]

