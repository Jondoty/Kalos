tellraw @s[scores={DialogueTrigger=134,TalkTime=4}] ["",{"text":"<"},{"text":"...","color":"red"},{"text":"> Phew... I'm so glad you're all safe!"}]
tellraw @s[scores={DialogueTrigger=134,TalkTime=12}] ["",{"text":"<"},{"text":"...","color":"red"},{"text":"> I really respect the courage and kindness all of you showed."}]
tellraw @s[scores={DialogueTrigger=134,TalkTime=20}] {"text":"<Serena> Thank you... We're all fine. Are you guys all OK, Tierno?"}]
tellraw @s[scores={DialogueTrigger=134,TalkTime=28}] {"text":"<Tierno> Yep! As you can see, we're doing great! Thanks for asking!"}]
tellraw @s[scores={DialogueTrigger=134,TalkTime=36}] {"text":"<Tierno> We worked together to save the Pokémon connected to the stones on Route 10!"}]
tellraw @s[scores={DialogueTrigger=134,TalkTime=45}] {"text":"<Tierno> I mostly left battling with Team Flare to Sina and Dexio, though..."}]
tellraw @s[scores={DialogueTrigger=134,TalkTime=54}] ["",{"text":"<"},{"text":"...","color":"red"},{"text":"> Who are these Sina and Dexio you speak of? We're the masked heroes!"}]
tellraw @s[scores={DialogueTrigger=134,TalkTime=62}] ["",{"text":"<"},{"text":"...","color":"aqua"},{"text":"> Don't worry about it, Tierno. We were all doing the best we could to stop Team Flare's plans."}]
tellraw @s[scores={DialogueTrigger=134,TalkTime=72}] ["",{"text":"<"},{"text":"...","color":"aqua"},{"text":"> Oh, we have a little bit of news for you all."}]
tellraw @s[scores={DialogueTrigger=134,TalkTime=80}] ["",{"text":"<"},{"text":"...","color":"aqua"},{"text":"> We managed to destroy the machine in Lysandre's lab that was spying on people's Holo Caster transmissions."}]
tellraw @s[scores={DialogueTrigger=134,TalkTime=91}] {"text":"<Trevor> So, we won't have to deal with Team Flare anymore."}]
tellraw @s[scores={DialogueTrigger=134,TalkTime=99}] {"text":"<Trevor> Now, I can go back to filling up my Pokédex!"}]
tellraw @s[scores={DialogueTrigger=134,TalkTime=107}] {"text":"<Shauna> So...it's finally over, right? We can go back to our adventure, right?!"}]
tellraw @s[scores={DialogueTrigger=134,TalkTime=116}] {"text":"<Shauna> Let's go back to Anistar City and start over from where we left off!"}]

