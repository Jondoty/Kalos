tellraw @s[scores={DialogueTrigger=94,TalkTime=210}] {"text":"<Trevor> Um... Is the Professor gone already?"}]
tellraw @s[scores={DialogueTrigger=94,TalkTime=217}] {"text":"<Trevor> I was hoping to have him have a look at my Pokédex in person."}]
tellraw @s[scores={DialogueTrigger=94,TalkTime=225}] {"text":"<Trevor> Oh well, I can still get my Pokédex evaluated at a Pokémon Center's PC..."}]
tellraw @s[scores={DialogueTrigger=94,TalkTime=233}] {"text":"<Trevor> Anyway, I'm heading off to go look for Pokémon in the Frost Cavern and fill up more of my Pokédex!"}]

