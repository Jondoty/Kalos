tellraw @s[scores={DialogueTrigger=212,TalkTime=5}] {"text":"<Team Flare Xerosic> Come, come, we can still go on! Or are you worn out?"}
tellraw @s[scores={DialogueTrigger=212,TalkTime=13}] {"text":"<Team Flare Xerosic> Too bad that Essentia will never experience physical or mental fatigue,"}
tellraw @s[scores={DialogueTrigger=212,TalkTime=22}] {"text":"<Team Flare Xerosic> as long as she wears the Expansion Suit that I designed! Now, battle! Battle on, my Essentia!"}
tellraw @s[scores={DialogueTrigger=212,TalkTime=32}] ["",{"text":"<"},{"text":"...","color":"light_purple"},{"text":"> Mrrraaawwwrrr!!"}]
execute as @s[scores={DialogueTrigger=212,TalkTime=32}] run playsound espurr hostile @s ~ ~ ~ 100 1 1
tellraw @s[scores={DialogueTrigger=212,TalkTime=37}] {"text":"<Team Flare Xerosic> Wha--?!"}

