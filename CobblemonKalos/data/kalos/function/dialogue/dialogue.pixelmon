tellraw @s[scores={DialogueTrigger=182,TalkTime=107}] [<Looker> Ahem... My dear lady..."}]
tellraw @s[scores={DialogueTrigger=182,TalkTime=115}] [<Looker> I am so terribly sorry, but could you speak a bit less quickly?"}]
tellraw @s[scores={DialogueTrigger=182,TalkTime=125}] {"text":"<...> \u3059\u3063 \u3059\u3044\u307e\u305b\u3093\u2026\u2026 \u3067\u3082 \u3044\u305d\u3044\u3067\u308b\u3093\u3067\u3059\u3088\uff01"}
