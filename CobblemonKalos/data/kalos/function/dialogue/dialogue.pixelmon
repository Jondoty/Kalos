#Lysandre Labs Bryony and Celosia first dialogue
#scoreboard players set @a[x=-272,y=140,z=312,dx=20,dy=10,dz=10,tag=!Dialogue111] DialogueTrigger 111

execute as @s[scores={DialogueTrigger=111,TalkTime=1}] run scoreboard players set @s click 1
tellraw @s[scores={DialogueTrigger=111,TalkTime=2}] ["",{"text":"<"},{"text":"Team Flare Bryony","color":"dark_green"},{"text":"> Huh?"}]
tellraw @s[scores={DialogueTrigger=111,TalkTime=5}] ["",{"text":"<"},{"text":"Team Flare Celosia","color":"dark_purple"},{"text":"> Huh?"}]
tellraw @s[scores={DialogueTrigger=111,TalkTime=8}] ["",{"text":"<"},{"text":"Team Flare Bryony","color":"dark_green"},{"text":"> Huh."}]
tellraw @s[scores={DialogueTrigger=111,TalkTime=11}] ["",{"text":"<"},{"text":"Team Flare Celosia","color":"dark_purple"},{"text":"> Huh?"}]
tellraw @s[scores={DialogueTrigger=111,TalkTime=15}] ["",{"text":"<"},{"text":"Team Flare Bryony","color":"dark_green"},{"text":"> I've seen this kid somewhere before."}]
tellraw @s[scores={DialogueTrigger=111,TalkTime=22}] ["",{"text":"<"},{"text":"Team Flare Celosia","color":"dark_purple"},{"text":"> So who are they?"}]
tellraw @s[scores={DialogueTrigger=111,TalkTime=28}] ["",{"text":"<"},{"text":"Team Flare Bryony","color":"dark_green"},{"text":"> I have no idea. But obviously they're not in Team Flare. Let's get them, yeah?"}]
tellraw @s[scores={DialogueTrigger=111,TalkTime=38}] ["",{"text":"<"},{"text":"Team Flare Celosia","color":"dark_purple"},{"text":"> Yup. That sounds good to me. Then I'll get in the first blow!"}]

