tellraw @s[scores={DialogueTrigger=117,TalkTime=3}] {"text":"<...> So the Poké Balls we received and the Pokémon we've gathered are where they need to be."}
tellraw @s[scores={DialogueTrigger=117,TalkTime=12}] {"text":"<...> Add it all up, and it means all preparations are complete!"}
tellraw @s[scores={DialogueTrigger=117,TalkTime=20}] ["",{"text":"<"},{"text":"Lysandre","color":"dark_red"},{"text":"> The only thing left to do is put the plan in motion. I'm counting on you."}]
tellraw @s[scores={DialogueTrigger=117,TalkTime=30}] ["",{"text":"<"},{"text":"Lysandre","color":"dark_red"},{"text":"> One push of a button, and we can activate the ultimate weapon from this room."}]
tellraw @s[scores={DialogueTrigger=117,TalkTime=40}] ["",{"text":"<"},{"text":"Lysandre","color":"dark_red"},{"text":"> I believe being a chosen one means you have the potential to change the future!"}]
tellraw @s[scores={DialogueTrigger=117,TalkTime=50}] ["",{"text":"<"},{"text":"Lysandre","color":"dark_red"},{"text":"> Whether we activate the ultimate weapon or leave it safely underground will rest upon if you actually have this potential or not."}]

