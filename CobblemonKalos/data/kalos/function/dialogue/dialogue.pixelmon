tellraw @s[scores={DialogueTrigger=189,TalkTime=54}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> Wha--?! What is that woman?! She's no Pokémon, yet she can use Transform?"}]
tellraw @s[scores={DialogueTrigger=189,TalkTime=63}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> Oh, what am I doing? This is not a time to stand around being shocked!"}]
tellraw @s[scores={DialogueTrigger=189,TalkTime=72}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> In fact, this is a time to dash off in pursuit! The chase is on!"}]
tellraw @s[scores={DialogueTrigger=189,TalkTime=81}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> Now, considering the direction in which she ran, and the angle...hm..."}]
tellraw @s[scores={DialogueTrigger=189,TalkTime=91}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> "},{"selector":"@s"},{"text":", my brave friend! I suspect she is headed for the alley between the office and Hibernal Avenue!"}]
tellraw @s[scores={DialogueTrigger=189,TalkTime=103}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> Please go ahead without me!"}]
tellraw @s[scores={DialogueTrigger=189,TalkTime=110}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> I will be right behind you, just as soon as I have checked this place for clues!"}]
tellraw @s[scores={DialogueTrigger=189,TalkTime=120}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> But wait! One minute of your time! The great Looker will restore your Pokémon before you go!"}]
