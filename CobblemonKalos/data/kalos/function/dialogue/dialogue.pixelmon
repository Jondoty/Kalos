tellraw @s[scores={DialogueTrigger=182,TalkTime=421}] {"text":"Is this Mimi's mystical power? Somehow you can hear the strange woman's thoughts in your head...","italic":true,"color":"gray"}
tellraw @s[scores={DialogueTrigger=182,TalkTime=431}] {"text":"... ... ... It seems she feels sorry for saying rude things about Looker and Emma.","italic":true,"color":"gray"}
tellraw @s[scores={DialogueTrigger=182,TalkTime=441}] {"text":"... ... ... And the real reason she is so troubled is that her precious Pokémon were stolen!","italic":true,"color":"gray"}
tellraw @s[scores={DialogueTrigger=182,TalkTime=451}] {"text":"<...> \u3053\u306e\u307e\u3061\u306e \u3048\u304d\u3067\uff01 \u30ac\u30e9\u306e \u308f\u308b\u3044 \u308c\u3093\u3061\u3085\u3046\u304c \u3042\u3086\u307f\u3088\u3063\u305f\u3089"}
tellraw @s[scores={DialogueTrigger=182,TalkTime=461}] {"text":"<...> \u3064\u304e\u306e \u3057\u3085\u3093\u304b\u3093\u306b \u30d0\u30c3\u30b0\u3068 \u306a\u304b\u306b \u3044\u308c\u305f \u30dc\u30fc\u30eb\u304c \u306c\u3059\u307e\u308c\u307e\u3057\u305f\uff01"}
tellraw @s[scores={DialogueTrigger=182,TalkTime=471}] {"text":"She was walking through the train station when it happened...","italic":true,"color":"gray"}
tellraw @s[scores={DialogueTrigger=182,TalkTime=479}] {"text":"... ... ... A man sneaked up behind her, and then he stole her Bag.","italic":true,"color":"gray"}
tellraw @s[scores={DialogueTrigger=182,TalkTime=487}] {"text":"... ... ... The woman did her best to chase him, but he got away...","italic":true,"color":"gray"}
tellraw @s[scores={DialogueTrigger=182,TalkTime=495}] ["",{"text":"<"},{"text":"Emma","color":"yellow"},{"text":"> \u2026\u2026\u3048\u304d \u2026\u2026\u30ac\u30e9\u306e \u308f\u308b\u3044 \u308c\u3093\u3061\u3085\u3046 \u3082\u3057\u304b\u3057\u3066\u2026\u2026"}]
tellraw @s[scores={DialogueTrigger=182,TalkTime=505}] ["",{"text":"<"},{"text":"Emma","color":"yellow"},{"text":"> \u3042\u306e\u3053 \u305f\u3061 \u304b\u306a\uff1f"}]
tellraw @s[scores={DialogueTrigger=182,TalkTime=512}] {"text":"... ... ... It seems that Emma has some idea of who the man might have been...","italic":true,"color":"gray"}

#Looker tps in
execute as @s[scores={DialogueTrigger=182,TalkTime=519}] run particle cloud -151 101 382 2 2 2 1 100
execute as @s[scores={DialogueTrigger=182,TalkTime=519}] run tp @e[x=-504,y=230,z=1284,dy=3,type=pixelmon:npc_chatting] -151 101 382

tellraw @s[scores={DialogueTrigger=182,TalkTime=522}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> I return! My apologies for the delay."}]
tellraw @s[scores={DialogueTrigger=182,TalkTime=530}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> I have obtained the finest quality tea, since our guest obviously has exquisite taste!"}]
tellraw @s[scores={DialogueTrigger=182,TalkTime=540}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> Oho! Emma and Mimi are back as well! Yes. Excellent timing all round."}]
tellraw @s[scores={DialogueTrigger=182,TalkTime=550}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> Emma, have you introduced yourself to our visitor from a faraway land?"}]
tellraw @s[scores={DialogueTrigger=182,TalkTime=559}] ["",{"text":"<"},{"text":"Mimi","color":"light_purple"},{"text":"> Murrrr-mrrrawwwr. \u266a"}]
execute as @s[scores={DialogueTrigger=182,TalkTime=559}] run playsound espurr hostile @s ~ ~ ~ 100 1 1
tellraw @s[scores={DialogueTrigger=182,TalkTime=564}] {"text":"Your link to the others' thoughts suddenly disappears.","italic":true,"color":"gray"}
tellraw @s[scores={DialogueTrigger=182,TalkTime=572}] {"text":"It seems Mimi's mysterious power was somehow interrupted.","italic":true,"color":"gray"}
tellraw @s[scores={DialogueTrigger=182,TalkTime=580}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> Oh! What have we here? Mimi! Are you happy to see me come home, too?"}]
tellraw @s[scores={DialogueTrigger=182,TalkTime=589}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> Why... I wondered if it would ever happen. I have won over the hard-boiled Mimi!"}]
tellraw @s[scores={DialogueTrigger=182,TalkTime=599}] ["",{"text":"<"},{"text":"Emma","color":"yellow"},{"text":"> Um, Mr. Looker? This old lady here says her Pokémon were stolen."}]
tellraw @s[scores={DialogueTrigger=182,TalkTime=609}] ["",{"text":"<"},{"text":"Emma","color":"yellow"},{"text":"> I'd guess the thieves are still in Lumiose Station..."}]
tellraw @s[scores={DialogueTrigger=182,TalkTime=617}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> What's that? What's that you're saying? Then it wasn't tea that she was after?"}]
tellraw @s[scores={DialogueTrigger=182,TalkTime=628}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> But I bought this...fancy...expensive..."}]
tellraw @s[scores={DialogueTrigger=182,TalkTime=635}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> No! Hah! Never mind that! Let us focus on what is most important now!"}]
tellraw @s[scores={DialogueTrigger=182,TalkTime=643}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> Come, my friends! We have a case!"}]
tellraw @s[scores={DialogueTrigger=182,TalkTime=650}] ["",{"text":"<"},{"text":"Emma","color":"yellow"},{"text":"> Just a minute, Mr. Looker."}]
tellraw @s[scores={DialogueTrigger=182,TalkTime=657}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> What is it, Emma? Didn't you hear?"}]
tellraw @s[scores={DialogueTrigger=182,TalkTime=664}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> Her Pokémon have been stolen! We must get them back at once!"}]
tellraw @s[scores={DialogueTrigger=182,TalkTime=672}] ["",{"text":"<"},{"text":"Emma","color":"yellow"},{"text":"> I'd bet anything that the guy who stole this old lady's Pokémon was part of the Lumiose Gang."}]
tellraw @s[scores={DialogueTrigger=182,TalkTime=682}] ["",{"text":"<"},{"text":"Emma","color":"yellow"},{"text":"> They're rough types, you know? "}]
tellraw @s[scores={DialogueTrigger=182,TalkTime=690}] ["",{"text":"<"},{"text":"Emma","color":"yellow"},{"text":"> If we stick our noses in, that means a battle for sure..."}]
tellraw @s[scores={DialogueTrigger=182,TalkTime=697}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> Pardon? Whom? The Lumiose Gang?"}]
tellraw @s[scores={DialogueTrigger=182,TalkTime=704}] ["",{"text":"<"},{"text":"Emma","color":"yellow"},{"text":"> Yeah. So let's drop it, OK?"}]
tellraw @s[scores={DialogueTrigger=182,TalkTime=711}] ["",{"text":"<"},{"text":"Emma","color":"yellow"},{"text":"> You know, that old lady was talking trash about you while you were out."}]
tellraw @s[scores={DialogueTrigger=182,TalkTime=720}] ["",{"text":"<"},{"text":"Emma","color":"yellow"},{"text":"> She ain't nice. It's not worth having a great big fight to help a person like her."}]
tellraw @s[scores={DialogueTrigger=182,TalkTime=730}] {"text":"<...> \u305d\u3063 \u305d\u3093\u306a\uff01\uff01"}
tellraw @s[scores={DialogueTrigger=182,TalkTime=737}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> No, Emma."}]
tellraw @s[scores={DialogueTrigger=182,TalkTime=744}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> "},{"text":"That is not on!","bold":true,"italic":true}]
execute as @s[scores={DialogueTrigger=182,TalkTime=751}] run scoreboard players set @s click 1
tellraw @s[scores={DialogueTrigger=182,TalkTime=752}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> If you see someone in trouble, give help. "}]
tellraw @s[scores={DialogueTrigger=182,TalkTime=760}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> If you see a Pokémon in distress, you help!"}]
tellraw @s[scores={DialogueTrigger=182,TalkTime=767}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> That is the policy of the Looker Bureau! And it does not change!"}]
tellraw @s[scores={DialogueTrigger=182,TalkTime=775}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> No matter what this person may have said about me, it does not change what we do!"}]
tellraw @s[scores={DialogueTrigger=182,TalkTime=785}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> Now, wait here, please. I must go to Lumiose Station."}]
tellraw @s[scores={DialogueTrigger=182,TalkTime=793}] ["",{"text":"<"},{"text":"Emma","color":"yellow"},{"text":"> Mr. L-L-Looker... ... ... ..."}]

#tp Looker out
execute as @s[scores={DialogueTrigger=182,TalkTime=798}] run particle cloud -151 101 382 2 2 2 1 100
execute as @s[scores={DialogueTrigger=182,TalkTime=798}] run tp @e[x=-151,y=100,z=382,dy=3,type=pixelmon:npc_chatting] -504 231 1284

tellraw @s[scores={DialogueTrigger=182,TalkTime=801}] ["",{"text":"<"},{"text":"Emma","color":"yellow"},{"text":"> "},{"selector":"@s"},{"text":", help Mr. Looker! Please! He doesn't even have a Pokémon!"}]
tellraw @s[scores={DialogueTrigger=182,TalkTime=811}] ["",{"text":"<"},{"text":"Emma","color":"yellow"},{"text":"> H-he once said something... A long time ago, he had a Pokémon."}]
tellraw @s[scores={DialogueTrigger=182,TalkTime=820}] ["",{"text":"<"},{"text":"Emma","color":"yellow"},{"text":"> A partner that was always with him... But... They were on a case...and...and..."}]
tellraw @s[scores={DialogueTrigger=182,TalkTime=830}] ["",{"text":"<"},{"text":"Emma","color":"yellow"},{"text":"> I don't know what happened, but... his partner didn't make it..."}]
tellraw @s[scores={DialogueTrigger=182,TalkTime=840}] ["",{"text":"<"},{"text":"Emma","color":"yellow"},{"text":"> If he tries to stand up to the Lumiose Gang without a single Pokémon on his side, he doesn't have a chance!"}]
tellraw @s[scores={DialogueTrigger=182,TalkTime=852}] ["",{"text":"<"},{"text":"Emma","color":"yellow"},{"text":"> Oh, please! Oh, please. Go help him!"}]
tellraw @s[scores={DialogueTrigger=182,TalkTime=859}] ["",{"text":"<"},{"text":"Emma","color":"yellow"},{"text":"> You're his partner now, aren't you? Don't let him go alone!"}]
tellraw @s[scores={DialogueTrigger=182,TalkTime=867}] ["",{"text":"<"},{"text":"Emma","color":"yellow"},{"text":"> The Lumiose Gang is always somewhere on the platforms at Lumiose Station, up on North Boulevard..."}]
tellraw @s[scores={DialogueTrigger=182,TalkTime=877}] ["",{"text":"<"},{"text":"Emma","color":"yellow"},{"text":"> I think you're powerful enough to face them, "},{"selector":"@s"},{"text":"..."}]
tellraw @s[scores={DialogueTrigger=182,TalkTime=885}] ["",{"text":"<"},{"text":"Emma","color":"yellow"},{"text":"> But be ready for anything! Just in case!"}]
tellraw @s[scores={DialogueTrigger=182,TalkTime=892}] {"text":"<...> \u3069\u3046\u304b \u304a\u306d\u304c\u3044 \u3057\u307e\u3059\uff01\uff01"}
tellraw @s[scores={DialogueTrigger=182,TalkTime=900}] {"text":"<...> \u3042\u305f\u3057\u306e \u30dd\u30b1\u30e2\u30f3\u3061\u3083\u3093\u3092 \u3068\u308a\u304b\u3048\u3057\u3066 \u304d\u3066 \u304f\u3060\u3055\u3044\uff01\uff01"}
tellraw @s[scores={DialogueTrigger=182,TalkTime=910}] ["",{"text":"<"},{"text":"Mimi","color":"light_purple"},{"text":"> Mrrrawwwrrr!"}]
execute as @s[scores={DialogueTrigger=182,TalkTime=910}] run playsound espurr hostile @s ~ ~ ~ 100 1 1

