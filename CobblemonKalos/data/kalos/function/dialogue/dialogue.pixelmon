tellraw @s[scores={DialogueTrigger=194,TalkTime=5}] {"text":"<Butler Chalmers> Yes, as I suspected..."}
tellraw @s[scores={DialogueTrigger=194,TalkTime=13}] ["",{"text":"<Butler Chalmers> Your abilities and strength are without peer, "},{"selector":"@s"},{"text":"."}]
tellraw @s[scores={DialogueTrigger=194,TalkTime=23}] {"text":"<Butler Chalmers> Even I, a former admin of Team Flare, had no chance against you."}
tellraw @s[scores={DialogueTrigger=194,TalkTime=32}] {"text":"<Butler Chalmers> Please forgive me for testing you."}
tellraw @s[scores={DialogueTrigger=194,TalkTime=40}] {"text":"<Butler Chalmers> I am a mere servant, sent here by order of my mistress."}
tellraw @s[scores={DialogueTrigger=194,TalkTime=48}] {"text":"<Butler Chalmers> She told me to measure your skill, and to proceed only if I judged you to be able."}
tellraw @s[scores={DialogueTrigger=194,TalkTime=58}] {"text":"<Butler Chalmers> Oh goodness! Look at the time! My mistress is not a patient woman!"}
tellraw @s[scores={DialogueTrigger=194,TalkTime=69}] {"text":"<Butler Chalmers> If she is made to wait too long, the consequences will be severe."}
tellraw @s[scores={DialogueTrigger=194,TalkTime=79}] ["",{"text":"<Butler Chalmers> Please, "},{"selector":"@s"},{"text":"! You must hurry to Hotel Richissime's Royal Suite at once!"}]

