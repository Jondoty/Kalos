#----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
#Looker's Note from Mimi
#/tedit add INTERACT /tag @pl remove Dialogue225
#/tedit add INTERACT /scoreboard players set @pl DialogueTrigger 225

tellraw @s[scores={DialogueTrigger=225,TalkTime=1}] {"text":"Mimi is carrying a note.","italic":true,"color":"gray"}
tellraw @s[scores={DialogueTrigger=225,TalkTime=8}] {"text":"\u201cTo my esteemed partner: It is I, the great Looker.\""}
tellraw @s[scores={DialogueTrigger=225,TalkTime=16}] {"text":"\"I must investigate certain matters in regard to the Essentia case, and so I must leave the Looker Bureau for some time.\""}
tellraw @s[scores={DialogueTrigger=225,TalkTime=28}] {"text":"\"While I am away on this important task, I would ask two favors of you.\""}
tellraw @s[scores={DialogueTrigger=225,TalkTime=36}] {"text":"\"First, if you should somehow meet Emma, you must pretend to know nothing of the recent incidents around town.\u201d"}
tellraw @s[scores={DialogueTrigger=225,TalkTime=47}] {"text":"\u201cThe other thing I ask is simply...\""}
tellraw @s[scores={DialogueTrigger=225,TalkTime=54}] {"text":"\"Should Emma ever come to you asking where I have been all this long while...\""}
tellraw @s[scores={DialogueTrigger=225,TalkTime=63}] {"text":"\"Please tell her that I am in the hospital with some minor complaint. She is not to worry.\""}
tellraw @s[scores={DialogueTrigger=225,TalkTime=73}] {"text":"\"I know that this may seem an extreme request, but I trust you to do the right thing.\""}
tellraw @s[scores={DialogueTrigger=225,TalkTime=83}] {"text":"\"-Your partner, Looker\u201d"}

tag @s[scores={DialogueTrigger=225,TalkTime=83..}] add Dialogue225
scoreboard players set @s[tag=Dialogue225] TalkTime 0
scoreboard players set @s[tag=Dialogue225] DialogueTrigger 0

