#After player has found Xerosic's notes
#execute as @s[x=-306,y=28,z=280,dx=22,dy=20,dz=47,score_TalkTime=0,tag=Dialogue202] run execute as @s[tag=Dialogue203] run execute as @s[tag=Dialogue204] run execute as @s[tag=Dialogue205] run execute as @s[tag=Dialogue206] run execute as @s[tag=Dialogue207] run scoreboard players set @s[tag=!Dialogue208] DialogueTrigger 208

tellraw @s[scores={DialogueTrigger=208,TalkTime=10}] ["",{"text":"<"},{"text":"Punk Guy","color":"aqua"},{"text":"> Ermh... So there's just Poké Balls an' papers, like?"}]
tellraw @s[scores={DialogueTrigger=208,TalkTime=17}] ["",{"text":"<"},{"text":"Punk Guy","color":"aqua"},{"text":"> Those Poké Balls got to belong to somebody, stands to reason."}]
tellraw @s[scores={DialogueTrigger=208,TalkTime=25}] ["",{"text":"<"},{"text":"Punk Guy","color":"aqua"},{"text":"> I promised Mr. Looker, an' what's more, I meant it."}]
tellraw @s[scores={DialogueTrigger=208,TalkTime=33}] ["",{"text":"<"},{"text":"Punk Guy","color":"aqua"},{"text":"> I won't never take Poké Balls that aren't mine!"}]

#Intercomm bell
execute as @s[scores={DialogueTrigger=208,TalkTime=39}] run stopsound @s record
execute as @s[scores={DialogueTrigger=208,TalkTime=39}] run scoreboard players set @s MusicCooldown 150
execute as @s[scores={DialogueTrigger=208,TalkTime=41}] run playsound pixelmon:pixelmon.block.bellring ambient @s ~ ~ ~ 1000 0.75
execute as @s[scores={DialogueTrigger=208,TalkTime=43}] run playsound pixelmon:pixelmon.block.bellring ambient @s ~ ~ ~ 1000 0.75

tellraw @s[scores={DialogueTrigger=208,TalkTime=44}] ["",{"text":"<"},{"text":"Punk Guy","color":"aqua"},{"text":"> Waugh, my shift's finally endin'! I'm out, see?"}]
tellraw @s[scores={DialogueTrigger=208,TalkTime=54}] ["",{"text":"<"},{"text":"Punk Guy","color":"aqua"},{"text":"> Later, "},{"selector":"@s"},{"text":"! Be sure an' shut the place when you go!"}]

