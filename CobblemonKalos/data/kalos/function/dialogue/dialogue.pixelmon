tellraw @s[scores={DialogueTrigger=213,TalkTime=342}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> That may be that...but..."}]
tellraw @s[scores={DialogueTrigger=213,TalkTime=350}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> I think it's time you and I have a little chat, Dr. Xerosic."}]
tellraw @s[scores={DialogueTrigger=213,TalkTime=362}] {"text":"<Team Flare Xerosic> Of course. Why would I mind having a chat with you...\u201cLooker,\u201d or so you're apparently called."}


