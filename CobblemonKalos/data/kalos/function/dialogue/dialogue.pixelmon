tellraw @s[scores={DialogueTrigger=179,TalkTime=2}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> You're here, "},{"selector":"@s"},{"text":"! That is good. I need 30 seconds of your time, no more."}]
tellraw @s[scores={DialogueTrigger=179,TalkTime=12}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> It is about our new friend, Emma."}]
tellraw @s[scores={DialogueTrigger=179,TalkTime=20}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> Ever since she started living here at the office, I have detected some signs of stress in her."}]
tellraw @s[scores={DialogueTrigger=179,TalkTime=30}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> This has caused me to worry. What do you think, "},{"selector":"@s"},{"text":"? "}]
tellraw @s[scores={DialogueTrigger=179,TalkTime=40}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> Could it be that there is something wrong?\n["},{"text":"Yes","color":"green","clickEvent":{"action":"run_command","value":"/trigger TalkTrigger set 27"}},{"text":"] \u0020 ["},{"text":"No","color":"red","clickEvent":{"action":"run_command","value":"/trigger TalkTrigger set 28"}},{"text":"]"}]
execute as @s[scores={DialogueTrigger=179,TalkTime=40}] run scoreboard players enable @s TalkTrigger

tag @s[scores={DialogueTrigger=179,TalkTime=40..}] add Dialogue179
scoreboard players set @s[tag=Dialogue179] TalkTime 0
scoreboard players set @s[tag=Dialogue179] DialogueTrigger 0

#----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
#Player selects >Yes

tellraw @s[scores={DialogueTrigger=180,TalkTime=1}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> Interesting, interesting... So, has she confided in you?"}]
tellraw @s[scores={DialogueTrigger=180,TalkTime=9}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> Or did you use some of the brilliant detective skills you learned from my class?"}]
tellraw @s[scores={DialogueTrigger=180,TalkTime=19}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> You're an approachable person, "},{"selector":"@s"},{"text":", which encourages others to open up to you."}]
tellraw @s[scores={DialogueTrigger=180,TalkTime=29}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> You know, when I first invited Emma to live here, my intention was to become a guardian to her."}]
tellraw @s[scores={DialogueTrigger=180,TalkTime=40}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> I promised to do everything for her as a parent would."}]
tellraw @s[scores={DialogueTrigger=180,TalkTime=47}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> I...I do hope my feelings of responsibility are not burdening her."}]

tag @s[scores={DialogueTrigger=180,TalkTime=47..}] add Dialogue180
scoreboard players set @s[tag=Dialogue180] TalkTime 0
scoreboard players set @s[tag=Dialogue180] DialogueTrigger 0

#----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
#Player selects >No

tellraw @s[scores={DialogueTrigger=181,TalkTime=1}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> Of course, of course! If my partner says nothing is wrong, then, indeed, nothing could be wrong."}]
tellraw @s[scores={DialogueTrigger=181,TalkTime=13}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> I was a little worried that living in a strange place and studying all day might be causing her stress..."}]
tellraw @s[scores={DialogueTrigger=181,TalkTime=26}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> Hah! But my concerns prove untrue."}]
tellraw @s[scores={DialogueTrigger=181,TalkTime=33}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> It is just like a grim detective such as myself to see mysteries in everything."}]

tag @s[scores={DialogueTrigger=181,TalkTime=33..}] add Dialogue181
scoreboard players set @s[tag=Dialogue181] TalkTime 0
scoreboard players set @s[tag=Dialogue181] DialogueTrigger 0

