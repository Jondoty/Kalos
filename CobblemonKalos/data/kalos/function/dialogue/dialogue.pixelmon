#----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
#Post-Bryony battle
#/tedit add LOSS /scoreboard players set @pl DialogueTrigger 113
#execute as @s[x=-272,y=140,z=312,dx=20,dy=10,dz=10,tag=Dialogue112,score_TalkTime=0] run execute as @s[tag=!Dialogue113] run tp @e[x=-504,y=235,z=1276,dy=3,type=pixelmon:npc_trainer] -260 141 311

tellraw @s[scores={DialogueTrigger=113,TalkTime=5}] ["",{"text":"<"},{"text":"Team Flare Celosia","color":"dark_purple"},{"text":"> What's this?! Who would have thought a child like you could beat us both?"}]
tellraw @s[scores={DialogueTrigger=113,TalkTime=14}] ["",{"text":"<"},{"text":"Team Flare Celosia","color":"dark_purple"},{"text":"> You and your Pokémon were utterly in sync in that battle, and I know why."}]
tellraw @s[scores={DialogueTrigger=113,TalkTime=23}] ["",{"text":"<"},{"text":"Team Flare Celosia","color":"dark_purple"},{"text":"> You're here for answers, aren't you? I suppose we're at your mercy."}]
tellraw @s[scores={DialogueTrigger=113,TalkTime=34}] ["",{"text":"<"},{"text":"Team Flare Celosia","color":"dark_purple"},{"text":"> I will tell you what I know, at least."}]

tellraw @s[scores={DialogueTrigger=113,TalkTime=42}] ["",{"text":"<"},{"text":"Team Flare Bryony","color":"dark_green"},{"text":"> We've been using the electricity we stole from the Power Plant to get everything prepared for activating the ultimate weapon."}]
tellraw @s[scores={DialogueTrigger=113,TalkTime=54}] ["",{"text":"<"},{"text":"Team Flare Bryony","color":"dark_green"},{"text":"> But it's not like that's all we'll need to use it."}]
tellraw @s[scores={DialogueTrigger=113,TalkTime=62}] ["",{"text":"<"},{"text":"Team Flare Bryony","color":"dark_green"},{"text":"> Are you following me? We'll need energy absorbed from Pokémon to power the device! Yes!"}]
tellraw @s[scores={DialogueTrigger=113,TalkTime=72}] ["",{"text":"<"},{"text":"Team Flare Bryony","color":"dark_green"},{"text":"> It's the stones on Route 10 that will steal that energy for us and power the ultimate weapon!"}]

tellraw @s[scores={DialogueTrigger=113,TalkTime=82}] ["",{"text":"<"},{"text":"Team Flare Celosia","color":"dark_purple"},{"text":"> That's right. The stones on Route 10 normally put out energy, but when the ultimate weapon is activated,"}]
tellraw @s[scores={DialogueTrigger=113,TalkTime=92}] ["",{"text":"<"},{"text":"Team Flare Celosia","color":"dark_purple"},{"text":"> that reverses and they begin to absorb energy from Pokémon!"}]
tellraw @s[scores={DialogueTrigger=113,TalkTime=100}] ["",{"text":"<"},{"text":"Team Flare Celosia","color":"dark_purple"},{"text":"> In reality, those stones that line Route 10 are the graves of Pokémon."}]
tellraw @s[scores={DialogueTrigger=113,TalkTime=108}] ["",{"text":"<"},{"text":"Team Flare Celosia","color":"dark_purple"},{"text":"> When the ultimate weapon was used to end that horrible war over 3,000 years ago, it stole the lives of all those Pokémon."}]
tellraw @s[scores={DialogueTrigger=113,TalkTime=120}] ["",{"text":"<"},{"text":"Team Flare Celosia","color":"dark_purple"},{"text":"> Their lives were the price of peace then."}]
tellraw @s[scores={DialogueTrigger=113,TalkTime=127}] ["",{"text":"<"},{"text":"Team Flare Celosia","color":"dark_purple"},{"text":"> And if we want to make our own wishes come true today, we in Team Flare also have to sacrifice something precious."}]

