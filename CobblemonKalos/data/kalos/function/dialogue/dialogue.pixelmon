tellraw @s[scores={DialogueTrigger=32,TalkTime=126}] {"text":"<Palace Owner> And that was my wonderfrou fireworks show for my Furfrou!"}
tellraw @s[scores={DialogueTrigger=32,TalkTime=132}] {"text":"<Palace Owner> I assume you're satisfied with that."}
tellraw @s[scores={DialogueTrigger=32,TalkTime=139}] {"text":"<Shauna> OH!"}]
tellraw @s[scores={DialogueTrigger=32,TalkTime=142}] {"text":"<Shauna> I almost forgot! The Poké Flute!"}]
tellraw @s[scores={DialogueTrigger=32,TalkTime=150}] {"text":"<Shauna> We need the flute to wake up Snorlax."}]
tellraw @s[scores={DialogueTrigger=32,TalkTime=157}] {"text":"<Palace Owner> Sigh... The Poké Flute, huh..."}
tellraw @s[scores={DialogueTrigger=32,TalkTime=163}] {"text":"<Palace Owner> Go get it."}

