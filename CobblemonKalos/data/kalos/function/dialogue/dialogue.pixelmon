tellraw @s[scores={DialogueTrigger=119,TalkTime=3}] {"text":"<Team Flare Xerosic> You pushed it! Oh ho ho! You pushed the little red button!"}
tellraw @s[scores={DialogueTrigger=119,TalkTime=10}] {"text":"<Team Flare Xerosic> Too bad...for you! Pushing that button has enabled us to use the ultimate weapon!"}
