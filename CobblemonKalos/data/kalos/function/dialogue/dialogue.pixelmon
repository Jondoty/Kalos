scoreboard players set @s[tag=Dialogue168] TalkTime 0
scoreboard players set @s[tag=Dialogue168] DialogueTrigger 0

#----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
#Lumiose Press Volcanion Memo [The secret of the power]

tellraw @s[scores={DialogueTrigger=169,TalkTime=2}] {"text":"<Editor-in-chief> On the XXth day of the XXth month at the Pokémon Day Care on Route 7"}
tellraw @s[scores={DialogueTrigger=169,TalkTime=10}] {"text":"<Editor-in-chief> About the extraordinary power that Volcanion is said to possess."}
tellraw @s[scores={DialogueTrigger=169,TalkTime=18}] {"text":"<Editor-in-chief> Discussed it with a top Breeder who's very familiar with the ecology of Pokémon and drew the following deduction."}
tellraw @s[scores={DialogueTrigger=169,TalkTime=30}] {"text":"<Editor-in-chief> In order to cause a steam explosion powerful enough to blow up mountains,"}
tellraw @s[scores={DialogueTrigger=169,TalkTime=38}] {"text":"<Editor-in-chief> the Pokémon must have an organ with extremely high temperature that can instantly vaporize water to steam."}
tellraw @s[scores={DialogueTrigger=169,TalkTime=49}] {"text":"<Editor-in-chief> That kind of organ is unheard of in the ecology of Pokémon, but Volcanion may have it..."}
tellraw @s[scores={DialogueTrigger=169,TalkTime=58}] ["",{"text":"<Editor-in-chief> Is there another part of the memo you're interested in reading?\n["},{"text":"The secret of the power","color":"red","clickEvent":{"action":"run_command","value":"/trigger TalkTrigger set 22"}},{"text":"] \u0020 ["},{"text":"In the fog","color":"gray","clickEvent":{"action":"run_command","value":"/trigger TalkTrigger set 23"}},{"text":"] \u0020 ["},{"text":"A nation-building...","color":"aqua","clickEvent":{"action":"run_command","value":"/trigger TalkTrigger set 24"}},{"text":"]"}]
execute as @s[scores={DialogueTrigger=169,TalkTime=58}] run scoreboard players enable @s TalkTrigger

tag @s[scores={DialogueTrigger=169,TalkTime=58..}] add Dialogue169
scoreboard players set @s[tag=Dialogue169] TalkTime 0
scoreboard players set @s[tag=Dialogue169] DialogueTrigger 0

#----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
#Lumiose Press Volcanion Memo [In the fog]

tellraw @s[scores={DialogueTrigger=170,TalkTime=2}] {"text":"<Editor-in-chief> On the XXth day of the XXth month at the Pokémon Center in Camphrier Town Interviewed a Trainer,"}
tellraw @s[scores={DialogueTrigger=170,TalkTime=12}] {"text":"<Editor-in-chief> who says he witnessed a Pokémon that could be Volcanion when he was stranded in a mountain."}
tellraw @s[scores={DialogueTrigger=170,TalkTime=22}] {"text":"<Editor-in-chief> According to the Trainer, a huge Pokémon's shadow appeared suddenly."}
tellraw @s[scores={DialogueTrigger=170,TalkTime=31}] {"text":"<Editor-in-chief> Two huge armlike limbs that could crush even the land extended from its back,"}
tellraw @s[scores={DialogueTrigger=170,TalkTime=40}] {"text":"<Editor-in-chief> and from their tips, something that looked like smoke belched out and made the fog around the Pokémon even thicker."}
tellraw @s[scores={DialogueTrigger=170,TalkTime=52}] {"text":"<Editor-in-chief> The Trainer said the Pokémon's shadow slowly disappeared into the fog."}
tellraw @s[scores={DialogueTrigger=170,TalkTime=60}] ["",{"text":"<Editor-in-chief> Is there another part of the memo you're interested in reading?\n["},{"text":"The secret of the power","color":"red","clickEvent":{"action":"run_command","value":"/trigger TalkTrigger set 22"}},{"text":"] \u0020 ["},{"text":"In the fog","color":"gray","clickEvent":{"action":"run_command","value":"/trigger TalkTrigger set 23"}},{"text":"] \u0020 ["},{"text":"A nation-building...","color":"aqua","clickEvent":{"action":"run_command","value":"/trigger TalkTrigger set 24"}},{"text":"]"}]
execute as @s[scores={DialogueTrigger=170,TalkTime=60}] run scoreboard players enable @s TalkTrigger

tag @s[scores={DialogueTrigger=170,TalkTime=60..}] add Dialogue170
scoreboard players set @s[tag=Dialogue170] TalkTime 0
scoreboard players set @s[tag=Dialogue170] DialogueTrigger 0

#----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
#Lumiose Press Volcanion Memo [A nation-building...]

tellraw @s[scores={DialogueTrigger=171,TalkTime=2}] {"text":"<Editor-in-chief> On the XXth day of the XXth month at Café Kizuna in Lumiose City In the southern part of the Kalos region,"}
tellraw @s[scores={DialogueTrigger=171,TalkTime=13}] {"text":"<Editor-in-chief> there seems to be a custom to revere Volcanion as a nation-building Pokémon."}
tellraw @s[scores={DialogueTrigger=171,TalkTime=22}] {"text":"<Editor-in-chief> People seem to believe that a steam explosion caused by Volcanion created the plain where they live."}
tellraw @s[scores={DialogueTrigger=171,TalkTime=34}] {"text":"<Editor-in-chief> As a matter of fact, a huge mountain range suddenly disappeared,"}
tellraw @s[scores={DialogueTrigger=171,TalkTime=42}] {"text":"<Editor-in-chief> due to an unexplained explosion in that part of the region in the past..."}
tellraw @s[scores={DialogueTrigger=171,TalkTime=51}] ["",{"text":"<Editor-in-chief> Is there another part of the memo you're interested in reading?\n["},{"text":"The secret of the power","color":"red","clickEvent":{"action":"run_command","value":"/trigger TalkTrigger set 22"}},{"text":"] \u0020 ["},{"text":"In the fog","color":"gray","clickEvent":{"action":"run_command","value":"/trigger TalkTrigger set 23"}},{"text":"] \u0020 ["},{"text":"A nation-building...","color":"aqua","clickEvent":{"action":"run_command","value":"/trigger TalkTrigger set 24"}},{"text":"]"}]
execute as @s[scores={DialogueTrigger=171,TalkTime=51}] run scoreboard players enable @s TalkTrigger

tag @s[scores={DialogueTrigger=171,TalkTime=51..}] add Dialogue171
scoreboard players set @s[tag=Dialogue171] TalkTime 0
scoreboard players set @s[tag=Dialogue171] DialogueTrigger 0

