tellraw @s[scores={DialogueTrigger=216,TalkTime=10}] {"text":"<Artist> The criminal responsible was caught--did you know?"}
tellraw @s[scores={DialogueTrigger=216,TalkTime=19}] {"text":"<Artist> I overheard the director of the museum talking with the police!"}
tellraw @s[scores={DialogueTrigger=216,TalkTime=28}] {"text":"<Artist> But still...it sure was odd..."}
tellraw @s[scores={DialogueTrigger=216,TalkTime=35}] {"text":"<Artist> Why do you think that police officer looked so sad when he walked out of here?"}

