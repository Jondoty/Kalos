execute as @s[scores={DialogueTrigger=174,TalkTime=1}] run give @s minecraft:ghast_tear{display:{Lore:["A ticket that was handmade","by Looker. It's decorated with","a liberal amount of glittery paint."]},HideFlags:32}
execute as @s[scores={DialogueTrigger=174,TalkTime=1}] run playsound pixelmon:pixelmon.block.pokelootobtained ambient @s ~ ~ ~ 10 1 1
execute as @s[scores={DialogueTrigger=174,TalkTime=1}] run scoreboard players add @s LookerTickets 1

