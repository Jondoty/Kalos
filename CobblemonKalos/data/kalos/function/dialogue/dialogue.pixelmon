#Dendemille Sycamore and Dexio
#scoreboard players set @a[x=638,y=107,z=-431,dx=15,dy=5,dz=17,tag=!Dialogue94,score_TalkTime=0] DialogueTrigger 94

#tps in Sycamore and Dexio
execute as @s[scores={DialogueTrigger=94,TalkTime=1}] run particle cloud 645 108 -420 2 2 2 1 100
execute as @s[scores={DialogueTrigger=94,TalkTime=1}] run particle cloud 645 108 -424 2 2 2 1 100
execute as @s[scores={DialogueTrigger=94,TalkTime=1}] run tp @e[x=-504,y=200,z=1268,dy=3,type=pixelmon:npc_chatting] 645 108 -424
execute as @s[scores={DialogueTrigger=94,TalkTime=1}] run tp @e[x=-504,y=200,z=1270,dy=3,type=pixelmon:npc_chatting] 645 108 -420

execute as @s[scores={DialogueTrigger=94,TalkTime=4}] run scoreboard players set @s click 1
tellraw @s[scores={DialogueTrigger=94,TalkTime=4}] {"text":"<Dexio> Why hello, "},{"selector":"@s"},{"text":"!"}]
tellraw @s[scores={DialogueTrigger=94,TalkTime=11}] {"text":"<Dexio> How have you been?"}]
tellraw @s[scores={DialogueTrigger=94,TalkTime=16}] {"text":"<Sycamore> How's your journey going? You see, when I was younger, I visited many different regions as well."}
tellraw @s[scores={DialogueTrigger=94,TalkTime=25}] {"text":"<Sycamore> I met many kinds of Pokémon and noticed how each place has its own distinct flavors."}
tellraw @s[scores={DialogueTrigger=94,TalkTime=34}] {"text":"<Sycamore> So, I really came to enjoy trying new foods as I traveled."}
tellraw @s[scores={DialogueTrigger=94,TalkTime=42}] {"text":"<Sycamore> Because of my adventures, I'm an expert on the cafés all over Kalos."}
tellraw @s[scores={DialogueTrigger=94,TalkTime=50}] {"text":"<Dexio> Um... Professor..."}]
tellraw @s[scores={DialogueTrigger=94,TalkTime=55}] {"text":"<Sycamore> Come now, Dexio. I'm going somewhere with this."}
tellraw @s[scores={DialogueTrigger=94,TalkTime=63}] {"text":"<Sycamore> Do you remember the Pokémon Lysandre mentioned in that café?"}
tellraw @s[scores={DialogueTrigger=94,TalkTime=70}] {"text":"<Sycamore> Kalos's Legendary Pokémon are called... Xerneas and Yveltal!"}
tellraw @s[scores={DialogueTrigger=94,TalkTime=77}] {"text":"<Sycamore> According to material I've read, those who saw them were so overwhelmed by their power,"}
tellraw @s[scores={DialogueTrigger=94,TalkTime=87}] {"text":"<Sycamore> they were only able to say that these Pokémon resembled the letters X and Y."}
tellraw @s[scores={DialogueTrigger=94,TalkTime=96}] {"text":"<Sycamore> Apparently, these Pokémon can control and absorb energy. "}
tellraw @s[scores={DialogueTrigger=94,TalkTime=104}] {"text":"<Sycamore> Xerneas gives life energy to plants and Pokémon, and makes them full of vitality again."}
tellraw @s[scores={DialogueTrigger=94,TalkTime=114}] {"text":"<Sycamore> Yveltal's life span is said to be 1,000 years."}
tellraw @s[scores={DialogueTrigger=94,TalkTime=122}] {"text":"<Sycamore> When it reaches the end of its life, it steals all of the spirits around it."}
tellraw @s[scores={DialogueTrigger=94,TalkTime=131}] {"text":"<Dexio> Wherever do you think Pokémon that amazing could be now?"}]
tellraw @s[scores={DialogueTrigger=94,TalkTime=139}] {"text":"<Sycamore> When Kalos's Legendary Pokémon lose all of vitality, they go to sleep in a secret place."}
tellraw @s[scores={DialogueTrigger=94,TalkTime=150}] {"text":"<Sycamore> I don't have a clue where they could be. "}
tellraw @s[scores={DialogueTrigger=94,TalkTime=157}] {"text":"<Sycamore> The writings that mention them are also around a thousand years old, so they aren't much help."}
tellraw @s[scores={DialogueTrigger=94,TalkTime=168}] {"text":"<Dexio> It would be absolutely astounding if you found them, "},{"selector":"@s"},{"text":"."}]
tellraw @s[scores={DialogueTrigger=94,TalkTime=176}] {"text":"<Dexio> Maybe I'll look into the legend a little bit. If I find something, I'll let you know!"}]
tellraw @s[scores={DialogueTrigger=94,TalkTime=186}] {"text":"<Sycamore> Ah ha ha! Oh, it would be a thrill if you found them, indeed!"}
tellraw @s[scores={DialogueTrigger=94,TalkTime=193}] {"text":"<Sycamore> But your journey is yours and your Pokémon's alone. I want you to enjoy yourself and do whatever you'd like!"}

