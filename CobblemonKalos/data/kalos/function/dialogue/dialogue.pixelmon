execute as @s[scores={DialogueTrigger=212,TalkTime=224}] run playsound espurr hostile @s ~ ~ ~ 100 1 1
tellraw @s[scores={DialogueTrigger=212,TalkTime=229}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> Mimi! Get back!"}]
tellraw @s[scores={DialogueTrigger=212,TalkTime=236}] ["",{"text":"<"},{"text":"Mimi","color":"light_purple"},{"text":"> Mrawr?!"}]
