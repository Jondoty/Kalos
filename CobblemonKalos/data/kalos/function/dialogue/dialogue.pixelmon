execute as @s[scores={DialogueTrigger=193,TalkTime=1}] run tp @e[x=-504,y=100,z=1300,dy=3,type=pixelmon:npc_chatting] -77 101 383

tellraw @s[scores={DialogueTrigger=193,TalkTime=3}] ["",{"text":"<"},{"text":"Emma","color":"gold"},{"text":"> Oh! You actually showed up!"}]
tellraw @s[scores={DialogueTrigger=193,TalkTime=10}] ["",{"text":"<"},{"text":"Emma","color":"gold"},{"text":"> Hey, "},{"selector":"@s"},{"text":", I was hoping to find Mr. Looker."}]
tellraw @s[scores={DialogueTrigger=193,TalkTime=18}] ["",{"text":"<"},{"text":"Emma","color":"gold"},{"text":"> I've been so busy lately that I'm hardly ever here anymore. Do you have any idea where he is?"}]
tellraw @s[scores={DialogueTrigger=193,TalkTime=30}] ["",{"text":"<"},{"text":"Emma","color":"gold"},{"text":"> Wha...? He's in the hospital?! What's wrong with him?"}]
tellraw @s[scores={DialogueTrigger=193,TalkTime=39}] ["",{"text":"<"},{"text":"Emma","color":"gold"},{"text":"> Now I'm even more worried than before!"}]
tellraw @s[scores={DialogueTrigger=193,TalkTime=47}] ["",{"text":"<"},{"text":"Emma","color":"gold"},{"text":"> B-but... I'd need more money to get to the hospital..."}]
tellraw @s[scores={DialogueTrigger=193,TalkTime=55}] ["",{"text":"<"},{"text":"Emma","color":"gold"},{"text":"> Ah! Is that the time?! I'm gonna be late!"}]
tellraw @s[scores={DialogueTrigger=193,TalkTime=63}] ["",{"text":"<"},{"text":"Emma","color":"gold"},{"text":"> I gotta go, Mimi! We'll talk later, "},{"selector":"@s"},{"text":"!"}]

