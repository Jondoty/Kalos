tellraw @s[scores={DialogueTrigger=104,TalkTime=43}] ["",{"text":"<"},{"text":"Lysandre","color":"dark_red"},{"text":"> Pokémon Trainers. I come to you by the Holo Caster to make an important announcement."}]
tellraw @s[scores={DialogueTrigger=104,TalkTime=52}] ["",{"text":"<"},{"text":"Lysandre","color":"dark_red"},{"text":"> Listen well. Team Flare will revive the ultimate weapon, eliminate everyone who isn't in our group, and return the world to a beautiful, natural state."}]
tellraw @s[scores={DialogueTrigger=104,TalkTime=64}] ["",{"text":"<"},{"text":"Lysandre","color":"dark_red"},{"text":"> Unproductive fools are consuming our future..."}]
tellraw @s[scores={DialogueTrigger=104,TalkTime=72}] ["",{"text":"<"},{"text":"Lysandre","color":"dark_red"},{"text":"> If nothing changes, the world will become ugly and conflicts will raze the land from end to end."}]
tellraw @s[scores={DialogueTrigger=104,TalkTime=81}] ["",{"text":"<"},{"text":"Lysandre","color":"dark_red"},{"text":"> I repeat. We will use the ultimate weapon and wipe the slate clean."}]
tellraw @s[scores={DialogueTrigger=104,TalkTime=90}] ["",{"text":"<"},{"text":"Lysandre","color":"dark_red"},{"text":"> I'm sorry, those of you who are not members of Team Flare, but this is adieu to you all."}]

