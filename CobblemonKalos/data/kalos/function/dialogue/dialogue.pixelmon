tellraw @s[scores={DialogueTrigger=139,TalkTime=5}] {"text":"<Shauna> Wow! Tierny asking someone to battle? What's up with that?"}]
tellraw @s[scores={DialogueTrigger=139,TalkTime=13}] {"text":"<Tierno> Geosenge Town made me think..."}]
tellraw @s[scores={DialogueTrigger=139,TalkTime=20}] {"text":"<Tierno> If "},{"selector":"@s"},{"text":" hadn't been there, I wouldn't be dancing now, that's for sure."}]
tellraw @s[scores={DialogueTrigger=139,TalkTime=30}] {"text":"<Tierno> That made me want to get to know "},{"selector":"@s"},{"text":" better, and I thought a battle would be the best way to do that."}]
tellraw @s[scores={DialogueTrigger=139,TalkTime=40}] {"text":"<Tierno> It's kinda selfish of me, I guess. But it's also a way of thanking you!"}]
tellraw @s[scores={DialogueTrigger=139,TalkTime=50}] {"text":"<Trevor> Tierno... It's great when Pokémon Trainers like us can understand the hearts and minds of other Trainers and their Pokémon through battle."}]
tellraw @s[scores={DialogueTrigger=139,TalkTime=60}] {"text":"<Trevor> But before we do anything else, we should heal your Pokémon."}]
tellraw @s[scores={DialogueTrigger=139,TalkTime=67}] {"text":"<Trevor> Now it's your turn, "},{"selector":"@s"},{"text":"."}]
execute as @a[scores={DialogueTrigger=139,TalkTime=75}] run pokeheal @s
tellraw @s[scores={DialogueTrigger=139,TalkTime=75}] {"text":"<Trevor> I think I will follow the crowd and be your opponent as well."}]
tellraw @s[scores={DialogueTrigger=139,TalkTime=83}] {"text":"<Trevor> But this time, it won't be about the Pokédex. It will be a Pokémon battle!"}]

