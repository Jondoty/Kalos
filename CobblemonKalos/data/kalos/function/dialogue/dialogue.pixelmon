#Nita Introduction
#Dialogue230

tellraw @s[scores={DialogueTrigger=230,TalkTime=5}] ["",{"text":"<"},{"text":"...","color":"yellow"},{"text":"> Hello-how-are-ya? Are ya in good form? "}]
tellraw @s[scores={DialogueTrigger=230,TalkTime=13}] ["",{"text":"<"},{"text":"Nita","color":"yellow"},{"text":"> I'm Nita. Welcome to the Battle Maison, pet."}]
tellraw @s[scores={DialogueTrigger=230,TalkTime=21}] ["",{"text":"<"},{"text":"Nita","color":"yellow"},{"text":"> Sure, I may be the youngest of the Battle Chatelaine sisters, but I'm still a class Trainer."}]
tellraw @s[scores={DialogueTrigger=230,TalkTime=31}] ["",{"text":"<"},{"text":"Nita","color":"yellow"},{"text":"> I've been an owner of the Battle Maison this long while. Honest, I'm not telling fibs!"}]
tellraw @s[scores={DialogueTrigger=230,TalkTime=41}] ["",{"text":"<"},{"text":"Nita","color":"yellow"},{"text":"> I'd be in charge of the Single Battles myself. Would you do me a favor? Of a bit of a match?"}]
tellraw @s[scores={DialogueTrigger=230,TalkTime=51}] ["",{"text":"<"},{"text":"Nita","color":"yellow"},{"text":"> You will? Grand! Then let's begin at once!"}]

tag @s[scores={DialogueTrigger=230,TalkTime=51..}] add Dialogue230
scoreboard players set @s[tag=Dialogue230] TalkTime 0
scoreboard players set @s[tag=Dialogue230] DialogueTrigger 0

#----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
#Nita First Battle Post-Win Dialouge
#Dialogue231
#/tedit add WIN /scoreboard players set @pl DialogueTrigger 231

tellraw @s[scores={DialogueTrigger=231,TalkTime=5}] ["",{"text":"<"},{"text":"Nita","color":"yellow"},{"text":"> Would you look at the cut of me Pokémon!"}]
tellraw @s[scores={DialogueTrigger=231,TalkTime=13}] ["",{"text":"<"},{"text":"Nita","color":"yellow"},{"text":"> What a battle, and me not trying for real even!"}]
tellraw @s[scores={DialogueTrigger=231,TalkTime=21}] ["",{"text":"<"},{"text":"Nita","color":"yellow"},{"text":"> Oh, I'm scarlet for you, pet. Made a complete and utter hash o' that one, didn't you now?"}]
tellraw @s[scores={DialogueTrigger=231,TalkTime=31}] ["",{"text":"<"},{"text":"Nita","color":"yellow"},{"text":"> But get you a bit more training, and you'll be grand. Trust me, training's your only man."}]
tellraw @s[scores={DialogueTrigger=231,TalkTime=41}] ["",{"text":"<"},{"text":"Nita","color":"yellow"},{"text":"> The Battle Maison and Nita are both here and waiting for a challenge every day o' the year!"}]
tellraw @s[scores={DialogueTrigger=231,TalkTime=51}] ["",{"text":"<"},{"text":"Nita","color":"yellow"},{"text":"> We'll always be waiting for you! See you then!"}]
execute as @s[scores={DialogueTrigger=231,TalkTime=59}] run function custom:battlemaisonwin
