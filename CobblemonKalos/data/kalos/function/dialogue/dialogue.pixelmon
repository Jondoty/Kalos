tellraw @s[scores={DialogueTrigger=184,TalkTime=5}] ["",{"text":"<"},{"text":"Emma","color":"yellow"},{"text":"> Stop it, all of you!"}]
tellraw @s[scores={DialogueTrigger=184,TalkTime=10}] [<Looker> Emma!"}]
tellraw @s[scores={DialogueTrigger=184,TalkTime=15}] ["",{"text":"<"},{"text":"Emma","color":"yellow"},{"text":"> Stop it! I mean it! And return those stolen Pokémon!"}]
tellraw @s[scores={DialogueTrigger=184,TalkTime=23}] ["",{"text":"<"},{"text":"Punk Guy","color":"aqua"},{"text":"> Well, if that don't take the biscuit! This is down to you, Emma."}]
tellraw @s[scores={DialogueTrigger=184,TalkTime=31}] ["",{"text":"<"},{"text":"Punk Guy","color":"aqua"},{"text":"> Yer just couldn't be bothered with us no more."}]
tellraw @s[scores={DialogueTrigger=184,TalkTime=38}] ["",{"text":"<"},{"text":"Punk Guy","color":"aqua"},{"text":"> What's the point of us if yer don't show up?"}]
tellraw @s[scores={DialogueTrigger=184,TalkTime=46}] ["",{"text":"<"},{"text":"Punk Guy","color":"aqua"},{"text":"> Yer the boss of this gang! Did yer think how we missed yer?"}]
tellraw @s[scores={DialogueTrigger=184,TalkTime=54}] ["",{"text":"<"},{"text":"Punk Guy","color":"aqua"},{"text":"> Goin' off with this bad news and never a thought to yer old mates. Thanks for nothin'!"}]
tellraw @s[scores={DialogueTrigger=184,TalkTime=66}] ["",{"text":"<"},{"text":"Emma","color":"yellow"},{"text":"> Oh, put a sock in it! I said up front--don't count me in."}]
tellraw @s[scores={DialogueTrigger=184,TalkTime=74}] ["",{"text":"<"},{"text":"Emma","color":"yellow"},{"text":"> You went ahead and called me boss without even asking what I wanted."}]
tellraw @s[scores={DialogueTrigger=184,TalkTime=82}] ["",{"text":"<"},{"text":"Emma","color":"yellow"},{"text":"> I decide for myself! Now, back off before I really lose it!"}]
tellraw @s[scores={DialogueTrigger=184,TalkTime=90}] ["",{"text":"<"},{"text":"Punk Guy","color":"aqua"},{"text":"> N-no! N-n-not that! We got it, boss! We got it!"}]
tellraw @s[scores={DialogueTrigger=184,TalkTime=97}] ["",{"text":"<"},{"text":"Punk Guy","color":"aqua"},{"text":"> Yer don't have to be the boss!"}]
tellraw @s[scores={DialogueTrigger=184,TalkTime=105}] ["",{"text":"<"},{"text":"Punk Guy","color":"aqua"},{"text":"> We've just been missing yer since yer stopped comin' round!"}]
tellraw @s[scores={DialogueTrigger=184,TalkTime=113}] ["",{"text":"<"},{"text":"Punk Guy","color":"aqua"},{"text":"> Here, we'll give yer back the Poké Balls, so forgive us--aight?!"}]
tellraw @s[scores={DialogueTrigger=184,TalkTime=121}] ["",{"text":"<"},{"text":"Emma","color":"yellow"},{"text":"> Right. Well, enough said. I'll let it go this time, but..."}]
tellraw @s[scores={DialogueTrigger=184,TalkTime=130}] ["",{"text":"<"},{"text":"Emma","color":"yellow"},{"text":"> You need to say sorry to the lady you stole from. And to Mr. Looker, too!"}]
tellraw @s[scores={DialogueTrigger=184,TalkTime=138}] ["",{"text":"<"},{"text":"Punk Guy","color":"aqua"},{"text":"> Yes, ma'am! I will! I'm awful sorry for nickin' the Pokémon."}]
tellraw @s[scores={DialogueTrigger=184,TalkTime=147}] ["",{"text":"<"},{"text":"Punk Guy","color":"aqua"},{"text":"> Yer got me bang to rights. Forgive me?"}]
tellraw @s[scores={DialogueTrigger=184,TalkTime=155}] [<Looker> Ahem. Of course."}]
tellraw @s[scores={DialogueTrigger=184,TalkTime=161}] [<Looker> The Pokémon shall be safely restored, so let's call it water under the bridge."}]
tellraw @s[scores={DialogueTrigger=184,TalkTime=170}] [<Looker> A-a-a-a-and...case closed!"}]
tellraw @s[scores={DialogueTrigger=184,TalkTime=177}] [<Looker> Cheers, "},{"selector":"@s"},{"text":", Emma! Let's head back to the Looker Bureau!"}]
tellraw @s[scores={DialogueTrigger=184,TalkTime=187}] ["",{"text":"<"},{"text":"Emma","color":"yellow"},{"text":"> OK!"}]
tellraw @s[scores={DialogueTrigger=184,TalkTime=191}] [<Looker> Oh, I forgot something... Wait. Thirty seconds!"}]
tellraw @s[scores={DialogueTrigger=184,TalkTime=199}] [<Looker> Hey, folks!"}]
tellraw @s[scores={DialogueTrigger=184,TalkTime=204}] ["",{"text":"<"},{"text":"Punk Guy","color":"aqua"},{"text":"> ...Eh?"}]
tellraw @s[scores={DialogueTrigger=184,TalkTime=209}] [<Looker> It's your wish to be friends with Emma, is that correct?"}]
tellraw @s[scores={DialogueTrigger=184,TalkTime=216}] ["",{"text":"<"},{"text":"Punk Guy","color":"aqua"},{"text":"> Yer sussed that out, eh?"}]
execute as @s[scores={DialogueTrigger=184,TalkTime=215}] run scoreboard players set @s click 1
tellraw @s[scores={DialogueTrigger=184,TalkTime=223}] [<Looker> When people behave with evil intentions, I cannot turn away and lightly forgive such."}]
tellraw @s[scores={DialogueTrigger=184,TalkTime=233}] [<Looker> Especially people who do cruel and thoughtless things."}]
tellraw @s[scores={DialogueTrigger=184,TalkTime=240}] [<Looker> For example, stealing the beloved Pokémon of other Trainers..."}]
tellraw @s[scores={DialogueTrigger=184,TalkTime=248}] [<Looker> However... I believe... No. Not just believe. I KNOW..."}]
tellraw @s[scores={DialogueTrigger=184,TalkTime=258}] [<Looker> People and Pokémon are both capable of...evolving. And so..."}]
tellraw @s[scores={DialogueTrigger=184,TalkTime=267}] [<Looker> If you give your word of honor not to ever lift a hand in cruelty again,"}]
tellraw @s[scores={DialogueTrigger=184,TalkTime=277}] [<Looker> then you may come by the Looker Bureau anytime to visit Emma...as her friends."}]
tellraw @s[scores={DialogueTrigger=184,TalkTime=283}] ["",{"text":"<"},{"text":"Emma","color":"yellow"},{"text":"> Mr. L-L-Looker..."}]
tellraw @s[scores={DialogueTrigger=184,TalkTime=290}] ["",{"text":"<"},{"text":"Emma","color":"yellow"},{"text":"> Sir..."}]
tellraw @s[scores={DialogueTrigger=184,TalkTime=295}] [<Looker> Let us now return! Back once more to the Looker Bureau!"}]

