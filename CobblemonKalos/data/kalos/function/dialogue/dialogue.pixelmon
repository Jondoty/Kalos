tellraw @s[scores={DialogueTrigger=177,TalkTime=5}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> Pardon, pardon. It took a while to find you!"}]
tellraw @s[scores={DialogueTrigger=177,TalkTime=12}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> \u0020How's the investigation going, "},{"selector":"@s"},{"text":"? Do you have news to report?"}]
tellraw @s[scores={DialogueTrigger=177,TalkTime=20}] ["",{"text":"<"},{"text":"...","color":"light_purple"},{"text":"> Mrrawwwr!"}]
execute as @s[scores={DialogueTrigger=177,TalkTime=20}] run playsound espurr hostile @s ~ ~ ~ 100 1 1
tellraw @s[scores={DialogueTrigger=177,TalkTime=25}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> Oho! Did you hear that cry? I feel like it came from deeper inside the alley..."}]
tellraw @s[scores={DialogueTrigger=177,TalkTime=32}] ["",{"text":"<"},{"text":"...","color":"light_purple"},{"text":"> Mrrawwwr!"}]


