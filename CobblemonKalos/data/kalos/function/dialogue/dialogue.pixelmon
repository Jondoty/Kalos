execute as @s[scores={DialogueTrigger=215,TalkTime=3}] run data modify entity @e[limit=1,x=-51,y=100,z=397,dy=3,type=pixelmon:npc_chatting] {Rotation:[180.0f,0.0f]}

tellraw @s[scores={DialogueTrigger=215,TalkTime=4}] ["",{"text":"<"},{"text":"Punk Guy","color":"aqua"},{"text":"> Wotcher! How's it going, "},{"selector":"@s"},{"text":"?"}]
tellraw @s[scores={DialogueTrigger=215,TalkTime=12}] ["",{"text":"<"},{"text":"Punk Guy","color":"aqua"},{"text":"> I was bored, so I came over!"}]
tellraw @s[scores={DialogueTrigger=215,TalkTime=19}] ["",{"text":"<"},{"text":"Punk Guy","color":"aqua"},{"text":"> Eh, when I was comin' in just now, Emma were tearin' out in a hurry! Somethink happenin'?"}]
tellraw @s[scores={DialogueTrigger=215,TalkTime=29}] ["",{"text":"<"},{"text":"Punk Guy","color":"aqua"},{"text":"> Now you're gonna up and leave, too?!"}]
tellraw @s[scores={DialogueTrigger=215,TalkTime=37}] ["",{"text":"<"},{"text":"Punk Guy","color":"aqua"},{"text":"> I came all the way over here to visit! Why you all gotta be so cold like that?"}]
tellraw @s[scores={DialogueTrigger=215,TalkTime=47}] ["",{"text":"<"},{"text":"Punk Guy","color":"aqua"},{"text":"> An' even old man Looker!"}]
tellraw @s[scores={DialogueTrigger=215,TalkTime=54}] ["",{"text":"<"},{"text":"Punk Guy","color":"aqua"},{"text":"> When I just ran into him, he said he had to go to the Lumiose Museum and totally blew me off without another word!"}]
tellraw @s[scores={DialogueTrigger=215,TalkTime=65}] ["",{"text":"<"},{"text":"Punk Guy","color":"aqua"},{"text":"> Gah, I'm bored outta me skull."}]
tellraw @s[scores={DialogueTrigger=215,TalkTime=72}] ["",{"text":"<"},{"text":"Punk Guy","color":"aqua"},{"text":"> Happen I shoulda gone to the museum with our Looker, after all..."}]

