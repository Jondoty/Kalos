#Starts Emma's Theme
execute as @s[scores={DialogueTrigger=217,TalkTime=94}] run scoreboard players set @s click 1
tellraw @s[scores={DialogueTrigger=217,TalkTime=96}] {"text":"<Emma> Mr. Looker, I've been searching everywhere for you!"}]
tellraw @s[scores={DialogueTrigger=217,TalkTime=104}] {"text":"<Emma> Please t-tell me why, please..."}]
tellraw @s[scores={DialogueTrigger=217,TalkTime=111}] {"text":"<Emma> Why did you lie to us? Why are you leaving us behind?"}]
tellraw @s[scores={DialogueTrigger=217,TalkTime=119}] [<Looker> I...I'm sorry, Emma..."}]
tellraw @s[scores={DialogueTrigger=217,TalkTime=126}] [<Looker> But my letter explains everything."}]
tellraw @s[scores={DialogueTrigger=217,TalkTime=133}] [<Looker> I work for the International Police! I am a globe-trotting, crime-fighting elite!"}]
tellraw @s[scores={DialogueTrigger=217,TalkTime=144}] [<Looker> Wherever there is a case, I must go! Justice awaits!"}]
tellraw @s[scores={DialogueTrigger=217,TalkTime=153}] {"text":"<Emma> Then take me and Mimi with you. We'll join whatever police!"}]
tellraw @s[scores={DialogueTrigger=217,TalkTime=162}] {"text":"<Emma> We can be police or anything-- if only we can just stay together!"}]
tellraw @s[scores={DialogueTrigger=217,TalkTime=171}] [<Looker> Emma, I wish it could be like that."}]
tellraw @s[scores={DialogueTrigger=217,TalkTime=179}] [<Looker> You can't come. It's not possible at all."}]
tellraw @s[scores={DialogueTrigger=217,TalkTime=187}] {"text":"<Emma> Why not?! Why can't we?!"}]
tellraw @s[scores={DialogueTrigger=217,TalkTime=194}] {"text":"<Emma> I'm part of the Looker Bureau, too! I'm your assistant, aren't I?!"}]
tellraw @s[scores={DialogueTrigger=217,TalkTime=205}] [<Looker> In fact, the time has come for you to graduate from being my assistant."}]
tellraw @s[scores={DialogueTrigger=217,TalkTime=215}] [<Looker> As of this moment, I name you the new head of the Looker Bureau!"}]
tellraw @s[scores={DialogueTrigger=217,TalkTime=224}] {"text":"<Emma> Wh-what?"}]
tellraw @s[scores={DialogueTrigger=217,TalkTime=231}] [<Looker> Listen to me, Emma. You were born and raised in this fair city."}]
tellraw @s[scores={DialogueTrigger=217,TalkTime=240}] [<Looker> Every day of your life, you have been here."}]
tellraw @s[scores={DialogueTrigger=217,TalkTime=247}] [<Looker> You are the only one who knows this city inside and out."}]
tellraw @s[scores={DialogueTrigger=217,TalkTime=255}] [<Looker> No one else could do the things you can do for it!"}]
tellraw @s[scores={DialogueTrigger=217,TalkTime=263}] [<Looker> I pass my torch of brilliant detective-ing to you!"}]
tellraw @s[scores={DialogueTrigger=217,TalkTime=271}] [<Looker> Take my place, and keep protecting the peace of Lumiose City!"}]
tellraw @s[scores={DialogueTrigger=217,TalkTime=280}] {"text":"<Emma> But that's not fair at all!"}]
tellraw @s[scores={DialogueTrigger=217,TalkTime=287}] {"text":"<Emma> Come on, "},{"selector":"@s"},{"text":"! Say something! Tell him he's wrong!"}]
tellraw @s[scores={DialogueTrigger=217,TalkTime=296}] [<Looker> Emma, please. I must ask you to respect the necessity of my decision."}]
tellraw @s[scores={DialogueTrigger=217,TalkTime=305}] [<Looker> "},{"selector":"@s"},{"text":" understands perfectly why I must go. It is the way of partners."}]
tellraw @s[scores={DialogueTrigger=217,TalkTime=316}] [<Looker> They are my partner. We understand each other."}]
tellraw @s[scores={DialogueTrigger=217,TalkTime=323}] {"text":"<Mimi> Mrrrawrrr..."}]
execute as @s[scores={DialogueTrigger=217,TalkTime=323}] run playsound espurr hostile @s ~ ~ ~ 100 1 1
tellraw @s[scores={DialogueTrigger=217,TalkTime=328}] [<Looker> Oh, Mimi... Please don't make a sad face on my account."}]
tellraw @s[scores={DialogueTrigger=217,TalkTime=326}] [<Looker> No matter where I go, our bonds will never change."}]
tellraw @s[scores={DialogueTrigger=217,TalkTime=334}] [<Looker> You will be my dear friends from the Looker Bureau, always and forever."}]
tellraw @s[scores={DialogueTrigger=217,TalkTime=344}] {"text":"<Team Flare Xerosic> Yes! That is it! Bonds!"}
tellraw @s[scores={DialogueTrigger=217,TalkTime=351}] {"text":"<Team Flare Xerosic> The preposterous notion which cannot be seen nor measured!"}
tellraw @s[scores={DialogueTrigger=217,TalkTime=360}] {"text":"<Team Flare Xerosic> And yet I cannot deny that they do still exist!"}
tellraw @s[scores={DialogueTrigger=217,TalkTime=368}] {"text":"<Team Flare Xerosic> Fear not, Emma, for I suspect that you will always be tied to the International Police by your bonds!"}
tellraw @s[scores={DialogueTrigger=217,TalkTime=379}] [<Looker> Dr. Xerosic..."}]
tellraw @s[scores={DialogueTrigger=217,TalkTime=386}] {"text":"<Team Flare Xerosic> Emma! I give you my Expansion Suit!"}
tellraw @s[scores={DialogueTrigger=217,TalkTime=393}] {"text":"<Team Flare Xerosic> I have removed the remote-control functionality, so you needn't worry!"}
tellraw @s[scores={DialogueTrigger=217,TalkTime=402}] {"text":"<Team Flare Xerosic> As the new head detective in town, please use your powers as Essentia to protect your beloved Lumiose City!"}
tellraw @s[scores={DialogueTrigger=217,TalkTime=414}] {"text":"<Team Flare Xerosic> And...and..."}
tellraw @s[scores={DialogueTrigger=217,TalkTime=421}] {"text":"<Team Flare Xerosic> Please take all of the Pokémon that I raised for so long! They are yours now!"}
tellraw @s[scores={DialogueTrigger=217,TalkTime=430}] {"text":"<Emma> Dr. Xerosic... Dr. Xerosic, you've tried to do terrible things to the world, I guess."}]
tellraw @s[scores={DialogueTrigger=217,TalkTime=440}] {"text":"<Emma> I find it hard to see you as that kind of person."}]
tellraw @s[scores={DialogueTrigger=217,TalkTime=448}] {"text":"<Emma> I only became a Pokémon Trainer thanks to your being there for me."}]
tellraw @s[scores={DialogueTrigger=217,TalkTime=456}] {"text":"<Emma> ... ... ... I will always cherish your Pokémon and your suit, Dr. Xerosic."}]
tellraw @s[scores={DialogueTrigger=217,TalkTime=465}] {"text":"<Emma> I won't forget our bonds, either..."}]
tellraw @s[scores={DialogueTrigger=217,TalkTime=473}] [<Looker> Everyone... I'm sorry, but..."}]
tellraw @s[scores={DialogueTrigger=217,TalkTime=480}] [<Looker> We are nearly out of time. Our train is due to depart."}]
tellraw @s[scores={DialogueTrigger=217,TalkTime=489}] {"text":"<Emma> Mr. Looker... I think I understand..."}]
tellraw @s[scores={DialogueTrigger=217,TalkTime=496}] {"text":"<Emma> And I know what I'm gonna do. I'll keep on working hard for you."}]
tellraw @s[scores={DialogueTrigger=217,TalkTime=506}] {"text":"<Emma> I've got Mimi and "},{"selector":"@s"},{"text":" to help me."}]
tellraw @s[scores={DialogueTrigger=217,TalkTime=515}] {"text":"<Emma> With Dr. Xerosic's Pokémon and Expansion Suit, I will become the new head of the Looker Bureau!"}]
tellraw @s[scores={DialogueTrigger=217,TalkTime=526}] [<Looker> I leave it in your hands, Emma!"}]
tellraw @s[scores={DialogueTrigger=217,TalkTime=534}] [<Looker> I'll rest easy, knowing you're on the case!"}]
tellraw @s[scores={DialogueTrigger=217,TalkTime=543}] {"text":"<Team Flare Xerosic> Emma! Don't you mess this up, my girl!"}
tellraw @s[scores={DialogueTrigger=217,TalkTime=551}] [<Looker> Ahem... "},{"selector":"@s"},{"text":"! Emma! Mimi!"}]
tellraw @s[scores={DialogueTrigger=217,TalkTime=560}] [<Looker> I entrust to you three the great task of protecting the peace of Lumiose City!"}]
tellraw @s[scores={DialogueTrigger=217,TalkTime=572}] [<Looker> Thank you for everything! Farewell, my friends!"}]

