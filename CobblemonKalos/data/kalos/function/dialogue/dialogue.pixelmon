tellraw @s[scores={DialogueTrigger=95,TalkTime=1}] {"text":"<Ace Trainer> ??"}
tellraw @s[scores={DialogueTrigger=95,TalkTime=5}] {"text":"<Ace Trainer> Is something wrong in the Frost Cavern, Mamoswine?"}
tellraw @s[scores={DialogueTrigger=95,TalkTime=12}] ["",{"text":"<Mamoswine> "},{"text":"Swi swi...","italic":true}]
execute as @s[scores={DialogueTrigger=95,TalkTime=12}] run playsound pixelmon:pixelmon.mob.mamoswine hostile @s ~ ~ ~ 10 1 1
tellraw @s[scores={DialogueTrigger=95,TalkTime=17}] {"text":"<Ace Trainer> Are you headed to the Frost Cavern, Trainer?"}
tellraw @s[scores={DialogueTrigger=95,TalkTime=24}] {"text":"<Ace Trainer> This Mamoswine here usually can't get enough of giving people rides on Route 17, but..."}
tellraw @s[scores={DialogueTrigger=95,TalkTime=32}] {"text":"<Ace Trainer> These days, it seems to be too worried about something in the Frost Cavern to give rides."}

#Trevor tps in on bridge
execute as @s[scores={DialogueTrigger=95,TalkTime=37}] run particle cloud 733 119 -660 2 2 2 1 100
execute as @s[scores={DialogueTrigger=95,TalkTime=37}] run tp @e[x=-504,y=205,z=1270,dy=3,type=pixelmon:npc_chatting] 733 119 -660

tellraw @s[scores={DialogueTrigger=95,TalkTime=40}] {"text":"<Trevor> Mamoswine is a Pokémon that loves cold climates."}]
tellraw @s[scores={DialogueTrigger=95,TalkTime=47}] {"text":"<Trevor> So, maybe it has sensed something amiss in the Frost Cavern."}]
tellraw @s[scores={DialogueTrigger=95,TalkTime=54}] {"text":"<Ace Trainer> And you are?"}
tellraw @s[scores={DialogueTrigger=95,TalkTime=60}] {"text":"<Trevor> My name is Trevor. I'm researching the distribution of Pokémon in the Kalos region at Professor Sycamore's request."}]
tellraw @s[scores={DialogueTrigger=95,TalkTime=70}] {"text":"<Ace Trainer> I see. So that's why you're walking clear out to the Frost Cavern, then."}
tellraw @s[scores={DialogueTrigger=95,TalkTime=77}] {"text":"<Ace Trainer> Mamoswine seems concerned about something over there, so be careful."}
tellraw @s[scores={DialogueTrigger=95,TalkTime=85}] {"text":"<Trevor> I will. Thank you."}]
tellraw @s[scores={DialogueTrigger=95,TalkTime=91}] {"text":"<Trevor> What are you going to do, "},{"selector":"@s"},{"text":"? I'm going to prepare for my expedition."}]

