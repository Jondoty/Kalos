tellraw @s[scores={DialogueTrigger=147,TalkTime=43}] {"text":"<Serena> I'm renewing my rivalry with you!"}]
tellraw @s[scores={DialogueTrigger=147,TalkTime=50}] {"text":"<Serena> Since you're my rival, I want you to become a stronger and stronger Pokémon Trainer."}]
tellraw @s[scores={DialogueTrigger=147,TalkTime=60}] {"text":"<Serena> We'll keep getting stronger, too, of course!"}]
tellraw @s[scores={DialogueTrigger=147,TalkTime=67}] {"text":"<Serena> I suppose the first step is mastering the power that comes from the bond between me and my Pokémon, just like you did!"}]
tellraw @s[scores={DialogueTrigger=147,TalkTime=78}] {"text":"<Serena> Do your best at the Pokémon League! An awesome Trainer like you can handle it!"}]

