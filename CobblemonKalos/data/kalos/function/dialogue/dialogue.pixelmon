tellraw @s[scores={DialogueTrigger=172,TalkTime=5}] ["",{"text":"<"},{"text":"...","color":"gray"},{"text":"> It was good of you to come."}]
tellraw @s[scores={DialogueTrigger=172,TalkTime=11}] ["",{"text":"<"},{"text":"...","color":"gray"},{"text":"> Yes... I need 30 seconds of your time. Or--three minutes only. Thirty minutes, maybe."}]
tellraw @s[scores={DialogueTrigger=172,TalkTime=21}] ["",{"text":"<"},{"text":"...","color":"gray"},{"text":"> First, you must know that I have taken the liberty of investigating you, "},{"selector":"@s"},{"text":"."}]
tellraw @s[scores={DialogueTrigger=172,TalkTime=32}] ["",{"text":"<"},{"text":"...","color":"gray"},{"text":"> For example, I can say that you're the newest Champion of the Kalos region."}]
tellraw @s[scores={DialogueTrigger=172,TalkTime=41}] ["",{"text":"<"},{"text":"...","color":"gray"},{"text":"> Also, I can say that you were the one to save our world from the group known as Team Flare. Good. Very good."}]
execute as @s[scores={DialogueTrigger=172,TalkTime=50}] run scoreboard players set @s click 1
tellraw @s[scores={DialogueTrigger=172,TalkTime=52}] ["",{"text":"<"},{"text":"...","color":"gray"},{"text":"> I have delayed in giving my introduction. My code name is--no! Hah!"}]
tellraw @s[scores={DialogueTrigger=172,TalkTime=60}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> I mean to say, my name is Looker. "}]
tellraw @s[scores={DialogueTrigger=172,TalkTime=67}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> I'm no more than a grim, middle-aged man who works in this town as a detective."}]
tellraw @s[scores={DialogueTrigger=172,TalkTime=77}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> And now, let us approach the real subject, "},{"selector":"@s"},{"text":", my friend."}]
tellraw @s[scores={DialogueTrigger=172,TalkTime=87}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> I investigated you, yes. I called you here today, yes."}]
tellraw @s[scores={DialogueTrigger=172,TalkTime=95}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> The reasons for these actions? Listen well..."}]
tellraw @s[scores={DialogueTrigger=172,TalkTime=103}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> Lumiose City... It is a tourist destination whose name is known all over the world."}]
tellraw @s[scores={DialogueTrigger=172,TalkTime=113}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> Many kinds of people live here, and even more come to visit and enjoy the atmosphere."}]
tellraw @s[scores={DialogueTrigger=172,TalkTime=123}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> The fact is, wherever there are so many people in one place, trouble is never far behind."}]
tellraw @s[scores={DialogueTrigger=172,TalkTime=133}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> Trouble beckons me. Yes. Trouble troubles me. "}]
tellraw @s[scores={DialogueTrigger=172,TalkTime=140}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> And so I arrive, and so I open this agency."}]
tellraw @s[scores={DialogueTrigger=172,TalkTime=147}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> Being a detective and doing such work requires a person with a hard-boiled heart."}]
tellraw @s[scores={DialogueTrigger=172,TalkTime=157}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> But even a heart that embraces the loneliness can sometimes stumble, falter, doubt."}]
tellraw @s[scores={DialogueTrigger=172,TalkTime=167}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> And that's where you come in, kid. I want you to be my assistant. No, more than that!"}]
tellraw @s[scores={DialogueTrigger=172,TalkTime=177}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> I want you to be my partner."}]
tellraw @s[scores={DialogueTrigger=172,TalkTime=185}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> If a Champion like you and an iron-jawed detective like me join forces, I promise we can bring peace to Lumiose City!"}]

#Apply this to portal as well if player leaves and comes back without answering
tellraw @s[scores={DialogueTrigger=172,TalkTime=197}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> What does your heart say, "},{"selector":"@s"},{"text":"? Will you partner with me and fight crime?\n["},{"text":"Yes","color":"green","clickEvent":{"action":"run_command","value":"/trigger TalkTrigger set 25"}},{"text":"]"}]
execute as @s[scores={DialogueTrigger=172,TalkTime=197}] run scoreboard players enable @s TalkTrigger

tag @s[scores={DialogueTrigger=172,TalkTime=197..}] add Dialogue172
scoreboard players set @s[tag=Dialogue172] TalkTime 0
scoreboard players set @s[tag=Dialogue172] DialogueTrigger 0

#----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
#Looker after Player agrees to be his partner

tellraw @s[scores={DialogueTrigger=173,TalkTime=2}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> For your brave answer, I thank you. Lumiose City will regain its tranquillity!"}]
tellraw @s[scores={DialogueTrigger=173,TalkTime=12}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> Well, I wish it could be that easy. "}]
tellraw @s[scores={DialogueTrigger=173,TalkTime=20}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> Because even though you are Champion, you're still a rookie when it comes to detective work."}]
tellraw @s[scores={DialogueTrigger=173,TalkTime=31}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> And that's why I must ask you to enroll in my class in detective and espionage skills:"}]
tellraw @s[scores={DialogueTrigger=173,TalkTime=41}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> \u201cThe Looker Method: Yes, even YOU can become a detective in five easy steps!\u201d"}]
tellraw @s[scores={DialogueTrigger=173,TalkTime=52}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> Allow me to explain what you will be doing."}]
tellraw @s[scores={DialogueTrigger=173,TalkTime=60}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> You will need to find five Looker Tickets that have been sprinkled about Lumiose City, and then bring them back to me!"}]
tellraw @s[scores={DialogueTrigger=173,TalkTime=73}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> There's nothing more to it! Simple as can be!"}]
tellraw @s[scores={DialogueTrigger=173,TalkTime=80}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> The Looker Tickets will be sure to catch your eye with their glitter and sparkles."}]
tellraw @s[scores={DialogueTrigger=173,TalkTime=89}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> I want you to succeed, so I have left some hints in my notebook about where to find the tickets!"}]
tellraw @s[scores={DialogueTrigger=173,TalkTime=100}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> Just give it a click any time to read it! It's on the table on my desk."}]

tag @s[scores={DialogueTrigger=173,TalkTime=100..}] add Dialogue173
scoreboard players set @s[tag=Dialogue173] TalkTime 0
scoreboard players set @s[tag=Dialogue173] DialogueTrigger 0

