#Wulfric when you enter the Pokemon Village
#execute as @s[x=951,y=93,z=664,r=20,tag=!Wulfric] run scoreboard players set @s[tag=Dialogue140] DialogueTrigger 141

#tp Wulfric in
execute as @s[scores={DialogueTrigger=141,TalkTime=1}] run tp @e[x=-504,y=150,z=1284,dy=3,type=pixelmon:npc_chatting] 951 93 664
execute as @s[scores={DialogueTrigger=141,TalkTime=1}] run particle cloud 951 93 664 2 2 2 1 100

tellraw @s[scores={DialogueTrigger=141,TalkTime=3}] {"text":"<...> You know what this place is?"}
tellraw @s[scores={DialogueTrigger=141,TalkTime=10}] {"text":"<...> Welcome to the Pokémon Village. This place is a secret, y'know?"}
tellraw @s[scores={DialogueTrigger=141,TalkTime=19}] {"text":"<...> Most of the Pokémon here are runaways--escaped from bad people who did awful things to them."}
tellraw @s[scores={DialogueTrigger=141,TalkTime=20}] {"text":"<...> It's a shame how many heartless Trainers who can't bother to care for their Pokémon are out there."}
tellraw @s[scores={DialogueTrigger=141,TalkTime=31}] {"text":"<...> Some of these Pokémon, though..."}
tellraw @s[scores={DialogueTrigger=141,TalkTime=37}] {"text":"<...> Some of 'em are just too strong and found they didn't really have a place in the outside world, so they came here."}
tellraw @s[scores={DialogueTrigger=141,TalkTime=48}] {"text":"<...> Hmm... I see. Your Pokémon sure seem to think highly of you. You've had some good times together, haven't you?"}
tellraw @s[scores={DialogueTrigger=141,TalkTime=59}] {"text":"<...> Sometimes I get worried and come here to check on everyone."}
tellraw @s[scores={DialogueTrigger=141,TalkTime=66}] {"text":"<...> Oh--excuse my manners. We haven't even had a proper introduction yet."}
tellraw @s[scores={DialogueTrigger=141,TalkTime=74}] {"text":"<Wulfric> The name's Wulfric. I'm usually over at the Gym in Snowbelle City, since I'm the Gym Leader and all."}
tellraw @s[scores={DialogueTrigger=141,TalkTime=85}] {"text":"<Wulfric> Let me guess--you want to challenge me?"}
tellraw @s[scores={DialogueTrigger=141,TalkTime=93}] {"text":"<Wulfric> I thought so. Sorry to inconvenience you like this."}
tellraw @s[scores={DialogueTrigger=141,TalkTime=100}] {"text":"<Wulfric> I'll be waiting for you back at the Gym, then."}
tellraw @s[scores={DialogueTrigger=141,TalkTime=107}] {"text":"<Wulfric> Before you come by, I think it would do you good to spend some time with the Pokémon here."}

