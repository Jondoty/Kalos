tellraw @s[scores={DialogueTrigger=182,TalkTime=145}] {"text":"<...> \u3072\u3053\u3046\u304d\u306e \u3058\u304b\u3093 \u3060\u3063\u3066 \u305b\u307e\u3063\u3066 \u304d\u3066\u3044\u308b\u3093\u3067\u3059\u3088\uff01"}
tellraw @s[scores={DialogueTrigger=182,TalkTime=155}] [<Looker> Ahem... From what I can gather, it seems that this lady has been given sore offense."}]
tellraw @s[scores={DialogueTrigger=182,TalkTime=165}] [<Looker> And do you know why that would be, "},{"selector":"@s"},{"text":", my friend?"}]
tellraw @s[scores={DialogueTrigger=182,TalkTime=175}] [<Looker> Well, thanks to my gift for languages-- I've traveled all over the world, you know..."}]
tellraw @s[scores={DialogueTrigger=182,TalkTime=186}] [<Looker> It seems she is highly offended that she has come as a guest and not yet been offered tea! Yes! Case closed!"}]
tellraw @s[scores={DialogueTrigger=182,TalkTime=198}] [<Looker> Which means, my friend, I must make haste to obtain the requisite tea!"}]
tellraw @s[scores={DialogueTrigger=182,TalkTime=207}] [<Looker> "},{"selector":"@s"},{"text":", please keep our guest company until my return from this vital mission."}]

