tellraw @s[scores={DialogueTrigger=212,TalkTime=40}] [<Looker> That is enough."}]
tellraw @s[scores={DialogueTrigger=212,TalkTime=46}] {"text":"<Team Flare Xerosic> What?!"}
tellraw @s[scores={DialogueTrigger=212,TalkTime=51}] {"text":"<Team Flare Xerosic> Who are you two? Why are you here?"}
tellraw @s[scores={DialogueTrigger=212,TalkTime=59}] [<Looker> Mimi is a Psychic-type Pokémon."}]
tellraw @s[scores={DialogueTrigger=212,TalkTime=66}] [<Looker> It is only natural that it could find the friend to whom it has opened its heart."}]
tellraw @s[scores={DialogueTrigger=212,TalkTime=78}] {"text":"<Team Flare Xerosic> You can't just barge into a private residence like this! This is a crime!"}
tellraw @s[scores={DialogueTrigger=212,TalkTime=88}] [<Looker> That may have been true had we forced our way onto the property."}]
tellraw @s[scores={DialogueTrigger=212,TalkTime=97}] [<Looker> However, all we did was step into a wide-open elevator."}]
tellraw @s[scores={DialogueTrigger=212,TalkTime=105}] [<Looker> Notwithstanding that, "},{"selector":"@s"},{"text":" is the partner of the great Looker!"}]
tellraw @s[scores={DialogueTrigger=212,TalkTime=115}] [<Looker> Were they in trouble, I would follow to the highest heights and the fathomless depths!"}]
tellraw @s[scores={DialogueTrigger=212,TalkTime=125}] {"text":"<Team Flare Xerosic> Grrr... Still, you will not capture me! Go, Essentia! Get them all!"}
