tellraw @s[scores={DialogueTrigger=122,TalkTime=27}] {"text":"<Serena> We're not going to let you use the ultimate weapon!"}]
tellraw @s[scores={DialogueTrigger=122,TalkTime=35}] ["",{"text":"<"},{"text":"Lysandre","color":"dark_red"},{"text":"> Even though resources, space, and energy on this planet are limited,"}]
tellraw @s[scores={DialogueTrigger=122,TalkTime=43}] ["",{"text":"<"},{"text":"Lysandre","color":"dark_red"},{"text":"> the number of people and Pokémon has increased to an unsustainable level."}]
tellraw @s[scores={DialogueTrigger=122,TalkTime=51}] ["",{"text":"<"},{"text":"Lysandre","color":"dark_red"},{"text":"> Whether it's money or energy, the ones who steal are the ones who win in this world."}]
tellraw @s[scores={DialogueTrigger=122,TalkTime=61}] {"text":"<Serena> But that doesn't give you the right to destroy everyone but the ones Team Flare chooses!"}]
tellraw @s[scores={DialogueTrigger=122,TalkTime=71}] ["",{"text":"<"},{"text":"Lysandre","color":"dark_red"},{"text":"> So, tell me. The Mega Ring, did you share it?"}]
tellraw @s[scores={DialogueTrigger=122,TalkTime=78}] {"text":"<Serena> That's different! We competed for it, but..."}]
tellraw @s[scores={DialogueTrigger=122,TalkTime=85}] ["",{"text":"<"},{"text":"Lysandre","color":"dark_red"},{"text":"> When there is only one of something, it can't be shared."}]
tellraw @s[scores={DialogueTrigger=122,TalkTime=93}] ["",{"text":"<"},{"text":"Lysandre","color":"dark_red"},{"text":"> When something can't be shared, it will be fought over."}]
tellraw @s[scores={DialogueTrigger=122,TalkTime=100}] ["",{"text":"<"},{"text":"Lysandre","color":"dark_red"},{"text":"> And when something is fought over, some must survive without it."}]
tellraw @s[scores={DialogueTrigger=122,TalkTime=109}] ["",{"text":"<"},{"text":"Lysandre","color":"dark_red"},{"text":"> The only way to create a world where people live in beauty,"}]
tellraw @s[scores={DialogueTrigger=122,TalkTime=118}] ["",{"text":"<"},{"text":"Lysandre","color":"dark_red"},{"text":"> a world without conflict or theft, is to reduce the number of living things."}]
tellraw @s[scores={DialogueTrigger=122,TalkTime=128}] {"text":"<Serena> What about Pokémon?"}]
tellraw @s[scores={DialogueTrigger=122,TalkTime=135}] ["",{"text":"<"},{"text":"Lysandre","color":"dark_red"},{"text":"> ..."}]
execute as @s[scores={DialogueTrigger=122,TalkTime=137}] run execute at @e[x=-2336,y=69,z=-990,dy=3,type=pixelmon:npc_chatting] run particle minecraft:dripping_water ~0.15 ~1.55 ~0.5 0 0 0 3 1 normal
tellraw @s[scores={DialogueTrigger=122,TalkTime=139}] {"text":"<Serena> Tears... Why?!"}]
tellraw @s[scores={DialogueTrigger=122,TalkTime=145}] ["",{"text":"<"},{"text":"Lysandre","color":"dark_red"},{"text":"> Pokémon..."}]
tellraw @s[scores={DialogueTrigger=122,TalkTime=150}] ["",{"text":"<"},{"text":"Lysandre","color":"dark_red"},{"text":"> Shall no longer exist."}]
tellraw @s[scores={DialogueTrigger=122,TalkTime=157}] ["",{"text":"<"},{"text":"Lysandre","color":"dark_red"},{"text":"> Pokémon are wonderful beings."}]
tellraw @s[scores={DialogueTrigger=122,TalkTime=164}] ["",{"text":"<"},{"text":"Lysandre","color":"dark_red"},{"text":"> Humans have worked with Pokémon, and we have helped each other flourish."}]
tellraw @s[scores={DialogueTrigger=122,TalkTime=173}] ["",{"text":"<"},{"text":"Lysandre","color":"dark_red"},{"text":"> But precisely because of that, they will inevitably become tools for war and theft!"}]
tellraw @s[scores={DialogueTrigger=122,TalkTime=183}] ["",{"text":"<"},{"text":"Lysandre","color":"dark_red"},{"text":"> Enough of this. You want to stop the ultimate weapon, and I refuse to do so."}]
tellraw @s[scores={DialogueTrigger=122,TalkTime=192}] ["",{"text":"<"},{"text":"Lysandre","color":"dark_red"},{"text":"> So, I will keep you busy for just a moment..."}]

