tellraw @s[scores={DialogueTrigger=132,TalkTime=43,Xerneas=1..}] ["",{"text":"<"},{"text":"Lysandre","color":"dark_red"},{"text":"> So THIS is the mighty Xerneas?!"}]
tellraw @s[scores={DialogueTrigger=132,TalkTime=43,Yveltal=1..}] ["",{"text":"<"},{"text":"Lysandre","color":"dark_red"},{"text":"> So THIS is the mighty Yveltal?!"}]
tellraw @s[scores={DialogueTrigger=132,TalkTime=50}] ["",{"text":"<"},{"text":"Lysandre","color":"dark_red"},{"text":"> I expected more from a Pokémon called a legend!"}]
tellraw @s[scores={DialogueTrigger=132,TalkTime=57}] ["",{"text":"<"},{"text":"Lysandre","color":"dark_red"},{"text":"> You desire help from people? YOU need help from a human?"}]
tellraw @s[scores={DialogueTrigger=132,TalkTime=64}] {"text":"<Shauna> Oh, whatever! "},{"selector":"@s"},{"text":" already beat you! What are you doing here?"}]
tellraw @s[scores={DialogueTrigger=132,TalkTime=73}] ["",{"text":"<"},{"text":"Lysandre","color":"dark_red"},{"text":"> For me, victory is using the ultimate weapon."}]
tellraw @s[scores={DialogueTrigger=132,TalkTime=80}] ["",{"text":"<"},{"text":"Lysandre","color":"dark_red"},{"text":"> In order to do that, I need to reclaim the Legendary Pokémon's power and send it to that weapon once again."}]
tellraw @s[scores={DialogueTrigger=132,TalkTime=91}] ["",{"text":"<"},{"text":"Lysandre","color":"dark_red"},{"text":"> I'll be taking the Legendary Pokémon back now!"}]
tellraw @s[scores={DialogueTrigger=132,TalkTime=98}] ["",{"text":"<"},{"text":"Lysandre","color":"dark_red"},{"text":"> This time, I won't lose."}]
tellraw @s[scores={DialogueTrigger=132,TalkTime=104}] ["",{"text":"<"},{"text":"Lysandre","color":"dark_red"},{"text":"> I, too, shall use the Mega Ring and Mega Stone that you researched during your travels."}]

