tellraw @s[scores={DialogueTrigger=182,TalkTime=411}] {"text":"<...> \u304d\u3082\u3061\u306b \u3088\u3086\u3046\u304c \u306a\u304b\u3063\u305f\u3093\u3067\u3059 \u3044\u306e\u3061\u3088\u308a \u3060\u3044\u3058\u306a \u30dd\u30b1\u30e2\u30f3\u3061\u3083\u3093\u3092 \u306c\u3059\u307e\u308c\u3066 \u3053\u3093\u3089\u3093 \u3057\u3066\u3057\u307e\u3063\u3066\u2026\u2026"}
tellraw @s[scores={DialogueTrigger=182,TalkTime=421}] {"text":"Is this Mimi's mystical power? Somehow you can hear the strange woman's thoughts in your head...","italic":true,"color":"gray"}
tellraw @s[scores={DialogueTrigger=182,TalkTime=431}] {"text":"... ... ... It seems she feels sorry for saying rude things about Looker and Emma.","italic":true,"color":"gray"}
tellraw @s[scores={DialogueTrigger=182,TalkTime=441}] {"text":"... ... ... And the real reason she is so troubled is that her precious Pokémon were stolen!","italic":true,"color":"gray"}
tellraw @s[scores={DialogueTrigger=182,TalkTime=451}] {"text":"<...> \u3053\u306e\u307e\u3061\u306e \u3048\u304d\u3067\uff01 \u30ac\u30e9\u306e \u308f\u308b\u3044 \u308c\u3093\u3061\u3085\u3046\u304c \u3042\u3086\u307f\u3088\u3063\u305f\u3089"}
tellraw @s[scores={DialogueTrigger=182,TalkTime=461}] {"text":"<...> \u3064\u304e\u306e \u3057\u3085\u3093\u304b\u3093\u306b \u30d0\u30c3\u30b0\u3068 \u306a\u304b\u306b \u3044\u308c\u305f \u30dc\u30fc\u30eb\u304c \u306c\u3059\u307e\u308c\u307e\u3057\u305f\uff01"}
tellraw @s[scores={DialogueTrigger=182,TalkTime=471}] {"text":"She was walking through the train station when it happened...","italic":true,"color":"gray"}
tellraw @s[scores={DialogueTrigger=182,TalkTime=479}] {"text":"... ... ... A man sneaked up behind her, and then he stole her Bag.","italic":true,"color":"gray"}
tellraw @s[scores={DialogueTrigger=182,TalkTime=487}] {"text":"... ... ... The woman did her best to chase him, but he got away...","italic":true,"color":"gray"}
tellraw @s[scores={DialogueTrigger=182,TalkTime=495}] ["",{"text":"<"},{"text":"Emma","color":"yellow"},{"text":"> \u2026\u2026\u3048\u304d \u2026\u2026\u30ac\u30e9\u306e \u308f\u308b\u3044 \u308c\u3093\u3061\u3085\u3046 \u3082\u3057\u304b\u3057\u3066\u2026\u2026"}]
tellraw @s[scores={DialogueTrigger=182,TalkTime=505}] ["",{"text":"<"},{"text":"Emma","color":"yellow"},{"text":"> \u3042\u306e\u3053 \u305f\u3061 \u304b\u306a\uff1f"}]
tellraw @s[scores={DialogueTrigger=182,TalkTime=512}] {"text":"... ... ... It seems that Emma has some idea of who the man might have been...","italic":true,"color":"gray"}

