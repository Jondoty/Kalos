tellraw @s[scores={DialogueTrigger=235,TalkTime=24}] ["",{"text":"<"},{"text":"Nita","color":"yellow"},{"text":"> It's been a long time since I've been defeated like that!"}]
tellraw @s[scores={DialogueTrigger=235,TalkTime=32}] ["",{"text":"<"},{"text":"Nita","color":"yellow"},{"text":"> So... I can hardly wait myself for the next battle between us, you bold thing!"}]
tellraw @s[scores={DialogueTrigger=235,TalkTime=42}] ["",{"text":"<"},{"text":"Nita","color":"yellow"},{"text":"> The Battle Maison and Nita will always be here and waiting for your visit!"}]
tellraw @s[scores={DialogueTrigger=235,TalkTime=52}] ["",{"text":"<"},{"text":"Nita","color":"yellow"},{"text":"> You'd better come again--and no guff!"}]
