tellraw @s[scores={DialogueTrigger=237,TalkTime=13}] ["",{"text":"<"},{"text":"Evelyn","color":"aqua"},{"text":"> I can't take any more... Um... Dear guest... I'm s-so sorry..."}]
tellraw @s[scores={DialogueTrigger=237,TalkTime=22}] ["",{"text":"<"},{"text":"Evelyn","color":"aqua"},{"text":"> I...I tried as hard I could, but... I'm so knackered..."}]
tellraw @s[scores={DialogueTrigger=237,TalkTime=31}] ["",{"text":"<"},{"text":"Evelyn","color":"aqua"},{"text":"> I'll keep trying harder, so...please..."}]
tellraw @s[scores={DialogueTrigger=237,TalkTime=39}] ["",{"text":"<"},{"text":"Evelyn","color":"aqua"},{"text":"> You must challenge me to a Double Battle again..."}]
