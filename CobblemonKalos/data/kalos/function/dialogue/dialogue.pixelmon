#Looker starting Chapter 4

tellraw @s[scores={DialogueTrigger=185,TalkTime=3}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> Ah, "},{"selector":"@s"},{"text":", thank you so much for your time. I need three minutes only."}]
tellraw @s[scores={DialogueTrigger=185,TalkTime=11}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> Emma is on my mind. Recently, she has been running off somewhere on her own. And often."}]
tellraw @s[scores={DialogueTrigger=185,TalkTime=22}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> I was hoping to ask her to watch the office for me today, and once again, nowhere can she be found."}]
tellraw @s[scores={DialogueTrigger=185,TalkTime=33}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> It even seems as if she did not return here last night..."}]
tellraw @s[scores={DialogueTrigger=185,TalkTime=40}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> Her friends from the former gang seem to be on the straight and narrow,"}]
tellraw @s[scores={DialogueTrigger=185,TalkTime=48}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> so I hope this is not anything bad, but..."}]
tellraw @s[scores={DialogueTrigger=185,TalkTime=56}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> Hm? What's this? A Holo Caster clip?"}]

