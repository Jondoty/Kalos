tellraw @s[scores={DialogueTrigger=272,TalkTime=1}] {"text":"<Tourist> A bit of excitement makes the world a brighter place!"}
tellraw @s[scores={DialogueTrigger=272,TalkTime=9}] {"text":"<Tourist> Just admire a Shock Ribbon whenever you want to experience a thrill."}

tag @s[scores={DialogueTrigger=272,TalkTime=9..}] add Dialogue272
