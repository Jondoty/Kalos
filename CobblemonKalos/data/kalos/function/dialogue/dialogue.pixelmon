tellraw @s[scores={DialogueTrigger=232,TalkTime=13}] ["",{"text":"<"},{"text":"Evelyn","color":"aqua"},{"text":"> My name is Evelyn... I'll t-try t-t-to serve you as a Battle Chatelaine like my sisters, so..."}]
tellraw @s[scores={DialogueTrigger=232,TalkTime=24}] ["",{"text":"<"},{"text":"Evelyn","color":"aqua"},{"text":"> I'm the th-third of us four. M-my specialty is... Double Battles... I guess..."}]
tellraw @s[scores={DialogueTrigger=232,TalkTime=34}] ["",{"text":"<"},{"text":"Evelyn","color":"aqua"},{"text":"> Umm... ... ... ..."}]
tellraw @s[scores={DialogueTrigger=232,TalkTime=41}] ["",{"text":"<"},{"text":"Evelyn","color":"aqua"},{"text":"> Th-the weather is in a lovely way today, isn't it? ... ... ..."}]
