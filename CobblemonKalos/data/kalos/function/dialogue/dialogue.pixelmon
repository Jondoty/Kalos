execute as @s[scores={DialogueTrigger=184,TalkTime=303}] run tp @s -73 101 437 155 8
execute as @s[scores={DialogueTrigger=184,TalkTime=303}] run scoreboard players set @s click 1

tellraw @s[scores={DialogueTrigger=184,TalkTime=306}] ["",{"text":"<"},{"text":"Emma","color":"yellow"},{"text":"> Mr. Looker... I'm really sorry about what happened earlier..."}]
tellraw @s[scores={DialogueTrigger=184,TalkTime=315}] ["",{"text":"<"},{"text":"Emma","color":"yellow"},{"text":"> When that woman insulted you, I just saw red and I... I..."}]
tellraw @s[scores={DialogueTrigger=184,TalkTime=323}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> If you learned something from it, that is all I need to hear, Emma."}]
tellraw @s[scores={DialogueTrigger=184,TalkTime=331}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> But that is not what concerns me now."}]
tellraw @s[scores={DialogueTrigger=184,TalkTime=338}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> Imagine how I felt to discover that you were the boss of that gang!"}]
tellraw @s[scores={DialogueTrigger=184,TalkTime=348}] ["",{"text":"<"},{"text":"Emma","color":"yellow"},{"text":"> Oh, it's just silly. I wasn't in the gang for real!"}]
tellraw @s[scores={DialogueTrigger=184,TalkTime=356}] ["",{"text":"<"},{"text":"Emma","color":"yellow"},{"text":"> I had a big fight with them one time, and after I took them down, they figured I was their boss."}]
tellraw @s[scores={DialogueTrigger=184,TalkTime=367}] ["",{"text":"<"},{"text":"Emma","color":"yellow"},{"text":"> It was all their idea, not mine!"}]

#Punk guy tps in
execute as @s[scores={DialogueTrigger=184,TalkTime=374}] run tp @e[x=-504,y=240,z=1286,dy=3,type=pixelmon:npc_chatting] -76 101 442
execute as @s[scores={DialogueTrigger=184,TalkTime=374}] run particle cloud -76 101 442 2 2 2 1 100

tellraw @s[scores={DialogueTrigger=184,TalkTime=378}] ["",{"text":"<"},{"text":"Punk Guy","color":"aqua"},{"text":"> She may look like a cute kid, but Emma is crazy strong!"}]
tellraw @s[scores={DialogueTrigger=184,TalkTime=386}] ["",{"text":"<"},{"text":"Punk Guy","color":"aqua"},{"text":"> Sh-she really is, Looker, sir. And "},{"selector":"@s"},{"text":"!"}]
tellraw @s[scores={DialogueTrigger=184,TalkTime=395}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> Well, it's the lad from the gang. You're here for a visit already?"}]
tellraw @s[scores={DialogueTrigger=184,TalkTime=404}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> Good. Ahem. You can drop that \u201csir\u201d business. Call me Looker."}]
tellraw @s[scores={DialogueTrigger=184,TalkTime=413}] ["",{"text":"<"},{"text":"Punk Guy","color":"aqua"},{"text":"> As yer say, sir. ...Looker. Here's the thing, see."}]
tellraw @s[scores={DialogueTrigger=184,TalkTime=422}] ["",{"text":"<"},{"text":"Punk Guy","color":"aqua"},{"text":"> Us in the Lumiose Gang are gonna evolve, just like yer said!"}]
tellraw @s[scores={DialogueTrigger=184,TalkTime=431}] ["",{"text":"<"},{"text":"Punk Guy","color":"aqua"},{"text":"> We're all done wi' chorin' an' cheatin'. We're lookin' for honest work."}]
tellraw @s[scores={DialogueTrigger=184,TalkTime=441}] ["",{"text":"<"},{"text":"Punk Guy","color":"aqua"},{"text":"> So please let us come round an' see our Emma, won't yer?"}]
tellraw @s[scores={DialogueTrigger=184,TalkTime=450}] ["",{"text":"<"},{"text":"Emma","color":"yellow"},{"text":"> ... ... ..."}]
tellraw @s[scores={DialogueTrigger=184,TalkTime=455}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> That's excellent. Deciding to change your course in life is more than an Evolution!"}]
tellraw @s[scores={DialogueTrigger=184,TalkTime=465}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> It is a Mega Evolution!"}]
tellraw @s[scores={DialogueTrigger=184,TalkTime=472}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> There is no substitute for honest work if you want to make a difference in this world."}]
tellraw @s[scores={DialogueTrigger=184,TalkTime=481}] ["",{"text":"<"},{"text":"Punk Guy","color":"aqua"},{"text":"> Yeah, that's right, then. See yer later, eh, Emma?"}]

#tps Nix out
execute as @s[scores={DialogueTrigger=184,TalkTime=486}] run tp @e[x=-76,y=100,z=442,dy=3,type=pixelmon:npc_chatting] -504 241 1286
execute as @s[scores={DialogueTrigger=184,TalkTime=486}] run particle cloud -76 101 442 2 2 2 1 100

execute as @s[scores={DialogueTrigger=184,TalkTime=487}] run scoreboard players set @s click 1
tellraw @s[scores={DialogueTrigger=184,TalkTime=488}] ["",{"text":"<"},{"text":"Emma","color":"yellow"},{"text":"> Hey, Mr. Looker?"}]
tellraw @s[scores={DialogueTrigger=184,TalkTime=493}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> Hm? What is it, Emma?"}]
tellraw @s[scores={DialogueTrigger=184,TalkTime=499}] ["",{"text":"<"},{"text":"Emma","color":"yellow"},{"text":"> Mr. Looker... You said there is no substitute for honest work if you want to make a difference in this world."}]
tellraw @s[scores={DialogueTrigger=184,TalkTime=511}] ["",{"text":"<"},{"text":"Emma","color":"yellow"},{"text":"> But I don't do any work at all... You asked me to be your assistant."}]
tellraw @s[scores={DialogueTrigger=184,TalkTime=519}] ["",{"text":"<"},{"text":"Emma","color":"yellow"},{"text":"> But I've never done any work the whole time I've been staying here."}]
tellraw @s[scores={DialogueTrigger=184,TalkTime=527}] ["",{"text":"<"},{"text":"Emma","color":"yellow"},{"text":"> All I've done is learn things from you... Is that really enough?"}]
tellraw @s[scores={DialogueTrigger=184,TalkTime=535}] ["",{"text":"<"},{"text":"Emma","color":"yellow"},{"text":"> Is it really OK for me to be here?"}]
tellraw @s[scores={DialogueTrigger=184,TalkTime=541}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> These are good questions, Emma. You have been learning nonstop since you came here, have you not?"}]
tellraw @s[scores={DialogueTrigger=184,TalkTime=551}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> Learning is very important work at any age, and especially for you now."}]
tellraw @s[scores={DialogueTrigger=184,TalkTime=558}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> Continue to pour your heart into your studies. You have no need to worry."}]
tellraw @s[scores={DialogueTrigger=184,TalkTime=567}] ["",{"text":"<"},{"text":"Emma","color":"yellow"},{"text":"> But, Mr. Looker... We're always here in the Looker Bureau. And there's almost never any clients!"}]
tellraw @s[scores={DialogueTrigger=184,TalkTime=578}] ["",{"text":"<"},{"text":"Emma","color":"yellow"},{"text":"> Are Mimi and I just getting in your way?"}]
tellraw @s[scores={DialogueTrigger=184,TalkTime=585}] ["",{"text":"<"},{"text":"Emma","color":"yellow"},{"text":"> I mean, you went and turned down taking money from that tourist lady."}]
tellraw @s[scores={DialogueTrigger=184,TalkTime=594}] ["",{"text":"<"},{"text":"Emma","color":"yellow"},{"text":"> Be straight with me, Mr. Looker."}]
tellraw @s[scores={DialogueTrigger=184,TalkTime=600}] ["",{"text":"<"},{"text":"Emma","color":"yellow"},{"text":"> I'm asking, really, if it's really OK for Mimi and I to stay here...moneywise?"}]
tellraw @s[scores={DialogueTrigger=184,TalkTime=610}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> Y-you have no need to worry!"}]
tellraw @s[scores={DialogueTrigger=184,TalkTime=617}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> One would expect that a hard-boiled detective has savings set aside, indeed!"}]
tellraw @s[scores={DialogueTrigger=184,TalkTime=626}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> Yes, indeed, Looker's savings are as lofty as Sinnoh's own Mt. Coronet!"}]
tellraw @s[scores={DialogueTrigger=184,TalkTime=635}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> Hm. Perhaps you have not met up with Mt. Coronet in your studies yet, Emma?"}]
tellraw @s[scores={DialogueTrigger=184,TalkTime=644}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> Ha...hahaha! I ask you to leave such worries to me."}]
tellraw @s[scores={DialogueTrigger=184,TalkTime=653}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> Your part is to study hard, so you can become my trusted assistant. Deal? Good."}]

