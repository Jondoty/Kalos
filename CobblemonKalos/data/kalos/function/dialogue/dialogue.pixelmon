tellraw @s[scores={DialogueTrigger=269,TalkTime=1}] {"text":"<Tourist> Today is Monday! I'm going to help you shift gears and perk right up by giving your Pokémon an Alert Ribbon!"}
tellraw @s[scores={DialogueTrigger=269,TalkTime=12}] {"text":"<Tourist> Send out your Pokémon and I'll pin a ribbon on them!"}

