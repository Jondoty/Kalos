tellraw @s[scores={DialogueTrigger=182,TalkTime=522}] [<Looker> I return! My apologies for the delay."}]
tellraw @s[scores={DialogueTrigger=182,TalkTime=530}] [<Looker> I have obtained the finest quality tea, since our guest obviously has exquisite taste!"}]
tellraw @s[scores={DialogueTrigger=182,TalkTime=540}] [<Looker> Oho! Emma and Mimi are back as well! Yes. Excellent timing all round."}]
tellraw @s[scores={DialogueTrigger=182,TalkTime=550}] [<Looker> Emma, have you introduced yourself to our visitor from a faraway land?"}]
tellraw @s[scores={DialogueTrigger=182,TalkTime=559}] ["",{"text":"<"},{"text":"Mimi","color":"light_purple"},{"text":"> Murrrr-mrrrawwwr. \u266a"}]
execute as @s[scores={DialogueTrigger=182,TalkTime=559}] run playsound espurr hostile @s ~ ~ ~ 100 1 1
tellraw @s[scores={DialogueTrigger=182,TalkTime=564}] {"text":"Your link to the others' thoughts suddenly disappears.","italic":true,"color":"gray"}
tellraw @s[scores={DialogueTrigger=182,TalkTime=572}] {"text":"It seems Mimi's mysterious power was somehow interrupted.","italic":true,"color":"gray"}
tellraw @s[scores={DialogueTrigger=182,TalkTime=580}] [<Looker> Oh! What have we here? Mimi! Are you happy to see me come home, too?"}]
tellraw @s[scores={DialogueTrigger=182,TalkTime=589}] [<Looker> Why... I wondered if it would ever happen. I have won over the hard-boiled Mimi!"}]
tellraw @s[scores={DialogueTrigger=182,TalkTime=599}] ["",{"text":"<"},{"text":"Emma","color":"yellow"},{"text":"> Um, Mr. Looker? This old lady here says her Pokémon were stolen."}]
tellraw @s[scores={DialogueTrigger=182,TalkTime=609}] ["",{"text":"<"},{"text":"Emma","color":"yellow"},{"text":"> I'd guess the thieves are still in Lumiose Station..."}]
tellraw @s[scores={DialogueTrigger=182,TalkTime=617}] [<Looker> What's that? What's that you're saying? Then it wasn't tea that she was after?"}]
tellraw @s[scores={DialogueTrigger=182,TalkTime=628}] [<Looker> But I bought this...fancy...expensive..."}]
tellraw @s[scores={DialogueTrigger=182,TalkTime=635}] [<Looker> No! Hah! Never mind that! Let us focus on what is most important now!"}]
tellraw @s[scores={DialogueTrigger=182,TalkTime=643}] [<Looker> Come, my friends! We have a case!"}]
tellraw @s[scores={DialogueTrigger=182,TalkTime=650}] ["",{"text":"<"},{"text":"Emma","color":"yellow"},{"text":"> Just a minute, Mr. Looker."}]
tellraw @s[scores={DialogueTrigger=182,TalkTime=657}] [<Looker> What is it, Emma? Didn't you hear?"}]
tellraw @s[scores={DialogueTrigger=182,TalkTime=664}] [<Looker> Her Pokémon have been stolen! We must get them back at once!"}]
tellraw @s[scores={DialogueTrigger=182,TalkTime=672}] ["",{"text":"<"},{"text":"Emma","color":"yellow"},{"text":"> I'd bet anything that the guy who stole this old lady's Pokémon was part of the Lumiose Gang."}]
tellraw @s[scores={DialogueTrigger=182,TalkTime=682}] ["",{"text":"<"},{"text":"Emma","color":"yellow"},{"text":"> They're rough types, you know? "}]
tellraw @s[scores={DialogueTrigger=182,TalkTime=690}] ["",{"text":"<"},{"text":"Emma","color":"yellow"},{"text":"> If we stick our noses in, that means a battle for sure..."}]
tellraw @s[scores={DialogueTrigger=182,TalkTime=697}] [<Looker> Pardon? Whom? The Lumiose Gang?"}]
tellraw @s[scores={DialogueTrigger=182,TalkTime=704}] ["",{"text":"<"},{"text":"Emma","color":"yellow"},{"text":"> Yeah. So let's drop it, OK?"}]
tellraw @s[scores={DialogueTrigger=182,TalkTime=711}] ["",{"text":"<"},{"text":"Emma","color":"yellow"},{"text":"> You know, that old lady was talking trash about you while you were out."}]
tellraw @s[scores={DialogueTrigger=182,TalkTime=720}] ["",{"text":"<"},{"text":"Emma","color":"yellow"},{"text":"> She ain't nice. It's not worth having a great big fight to help a person like her."}]
tellraw @s[scores={DialogueTrigger=182,TalkTime=730}] {"text":"<...> \u305d\u3063 \u305d\u3093\u306a\uff01\uff01"}
tellraw @s[scores={DialogueTrigger=182,TalkTime=737}] [<Looker> No, Emma."}]
tellraw @s[scores={DialogueTrigger=182,TalkTime=744}] [<Looker> "},{"text":"That is not on!","bold":true,"italic":true}]
execute as @s[scores={DialogueTrigger=182,TalkTime=751}] run scoreboard players set @s click 1
tellraw @s[scores={DialogueTrigger=182,TalkTime=752}] [<Looker> If you see someone in trouble, give help. "}]
tellraw @s[scores={DialogueTrigger=182,TalkTime=760}] [<Looker> If you see a Pokémon in distress, you help!"}]
tellraw @s[scores={DialogueTrigger=182,TalkTime=767}] [<Looker> That is the policy of the Looker Bureau! And it does not change!"}]
tellraw @s[scores={DialogueTrigger=182,TalkTime=775}] [<Looker> No matter what this person may have said about me, it does not change what we do!"}]
tellraw @s[scores={DialogueTrigger=182,TalkTime=785}] [<Looker> Now, wait here, please. I must go to Lumiose Station."}]
tellraw @s[scores={DialogueTrigger=182,TalkTime=793}] ["",{"text":"<"},{"text":"Emma","color":"yellow"},{"text":"> Mr. L-L-Looker... ... ... ..."}]

