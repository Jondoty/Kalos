#/tedit add LOSS /scoreboard players set @pl TalkTime 0
#execute as @s[x=-2336,y=42,z=-997,r=20,score_TalkTime=0,tag=!Dialogue133] run execute as @s[tag=Dialogue132] run tp @e[x=-504,y=130,z=1290,dy=3,type=pixelmon:npc_trainer] -2336 42 -997

tellraw @s[scores={DialogueTrigger=133,TalkTime=5}] ["",{"text":"<"},{"text":"Lysandre","color":"dark_red"},{"text":"> "},{"text":"Whaugh!","bold":true,"italic":true}]
tellraw @s[scores={DialogueTrigger=133,TalkTime=11}] {"text":"<Shauna> Um... Know what I think?"}]
tellraw @s[scores={DialogueTrigger=133,TalkTime=17}] {"text":"<Shauna> Even if there's only a little bit of something, it's still best to share it."}]
tellraw @s[scores={DialogueTrigger=133,TalkTime=26}] {"text":"<Shauna> Even you managed to use Mega Evolution..."}]
tellraw @s[scores={DialogueTrigger=133,TalkTime=33}] {"text":"<Shauna> That's because Gyarados shared its power with you, didn't it?"}]
tellraw @s[scores={DialogueTrigger=133,TalkTime=40}] {"text":"<Shauna> And not just Gyarados, but your other Pokémon, too..."}]
tellraw @s[scores={DialogueTrigger=133,TalkTime=47}] ["",{"text":"<"},{"text":"Lysandre","color":"dark_red"},{"text":"> ..."}]
tellraw @s[scores={DialogueTrigger=133,TalkTime=52}] {"text":"<Serena> The Legendary Pokémon is gone, so you can't use the ultimate weapon anymore, right?"}]
tellraw @s[scores={DialogueTrigger=133,TalkTime=61}] {"text":"<Serena> You don't have to worry about the future all by yourself..."}]
tellraw @s[scores={DialogueTrigger=133,TalkTime=68}] {"text":"<Serena> I think everyone should work together to make a better, beautiful world..."}]
tellraw @s[scores={DialogueTrigger=133,TalkTime=77}] ["",{"text":"<"},{"text":"Lysandre","color":"dark_red"},{"text":"> If that were possible, all wars would have ended long ago!"}]
tellraw @s[scores={DialogueTrigger=133,TalkTime=85}] ["",{"text":"<"},{"text":"Lysandre","color":"dark_red"},{"text":"> I can only see one future!"}]
tellraw @s[scores={DialogueTrigger=133,TalkTime=92}] ["",{"text":"<"},{"text":"Lysandre","color":"dark_red"},{"text":"> One where selfish, foolish humans think about nothing other than themselves and steal more and more from one another..."}]
tellraw @s[scores={DialogueTrigger=133,TalkTime=102}] ["",{"text":"<"},{"text":"Lysandre","color":"dark_red"},{"text":"> It's a tragic future!"}]
tellraw @s[scores={DialogueTrigger=133,TalkTime=110}] ["",{"text":"<"},{"text":"Lysandre","color":"dark_red"},{"text":"> The original purpose of this device was to bring a Pokémon back to life."}]
tellraw @s[scores={DialogueTrigger=133,TalkTime=117}] ["",{"text":"<"},{"text":"Lysandre","color":"dark_red"},{"text":"> But the ancient king transformed it into this ultimate weapon..."}]
tellraw @s[scores={DialogueTrigger=133,TalkTime=125}] ["",{"text":"<"},{"text":"Lysandre","color":"dark_red"},{"text":"> Hmm. When the Legendary Pokémon awakened,"}]
tellraw @s[scores={DialogueTrigger=133,TalkTime=132}] ["",{"text":"<"},{"text":"Lysandre","color":"dark_red"},{"text":"> it took back much of its energy--its power-- that had been sent to the ultimate weapon."}]
tellraw @s[scores={DialogueTrigger=133,TalkTime=141}] ["",{"text":"<"},{"text":"Lysandre","color":"dark_red"},{"text":"> There's not much power left... But there IS enough to use it once..."}]

