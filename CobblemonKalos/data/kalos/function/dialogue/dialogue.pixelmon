#tp Xerosic and Looker in
execute as @s[scores={DialogueTrigger=217,TalkTime=1}] run tp @e[x=-504,y=120,z=1300,dy=4,type=pixelmon:npc_chatting] -297 108 440
execute as @s[scores={DialogueTrigger=217,TalkTime=1}] run tp @e[x=-504,y=120,z=1302,dy=4,type=pixelmon:npc_chatting] -294 108 440

tellraw @s[scores={DialogueTrigger=217,TalkTime=2}] {"text":"<Team Flare Xerosic> I'm telling you I gave them back! Every last one of them!"}
tellraw @s[scores={DialogueTrigger=217,TalkTime=11}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> ...Fine. If you really say that you returned all the Poké Balls that Essentia stole..."}]
tellraw @s[scores={DialogueTrigger=217,TalkTime=21}] {"text":"<Team Flare Xerosic> And I did! I returned them!"}
tellraw @s[scores={DialogueTrigger=217,TalkTime=28}] {"text":"<Team Flare Xerosic> And I'm turning myself in without a fight, so just give me a minute!"}
tellraw @s[scores={DialogueTrigger=217,TalkTime=38}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> There is no minute to give you! Our train is about to depart!"}]
tellraw @s[scores={DialogueTrigger=217,TalkTime=48}] {"text":"<Team Flare Xerosic> Haha! Here they come!"}
tellraw @s[scores={DialogueTrigger=217,TalkTime=55}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> What? "},{"selector":"@s"},{"text":"! Wh-why are you here?!"}]
tellraw @s[scores={DialogueTrigger=217,TalkTime=64}] {"text":"<Team Flare Xerosic> Because I contacted Emma, of course!"}
tellraw @s[scores={DialogueTrigger=217,TalkTime=71}] {"text":"<Team Flare Xerosic> I'm sure she'll be here any minute, too!"}
tellraw @s[scores={DialogueTrigger=217,TalkTime=79}] ["",{"text":"<"},{"text":"...","color":"gold"},{"text":"> Where is he? Hold on! Wait for me, Mr. Looker!"}]

#https://youtu.be/qEms9_nJ7M0?t=70618

#tp Emma and Mimi in
execute as @s[scores={DialogueTrigger=217,TalkTime=85}] run particle cloud -294 108 443 2 2 2 1 100
execute as @s[scores={DialogueTrigger=217,TalkTime=85}] run particle cloud -296 108 444 2 2 2 1 100
execute as @s[scores={DialogueTrigger=217,TalkTime=85}] run tp @e[x=-504,y=120,z=1304,dy=4,type=pixelmon:npc_chatting] -294 108 443
execute as @s[scores={DialogueTrigger=217,TalkTime=85}] run tp @e[x=-504,y=121,z=1306,dy=4,type=pixelmon:statue] -296 108 444

tellraw @s[scores={DialogueTrigger=217,TalkTime=88}] {"text":"<Team Flare Xerosic> Good timing, Emma!"}

#https://youtu.be/qEms9_nJ7M0?t=70623

#Starts Emma's Theme
execute as @s[scores={DialogueTrigger=217,TalkTime=94}] run scoreboard players set @s click 1
tellraw @s[scores={DialogueTrigger=217,TalkTime=96}] ["",{"text":"<"},{"text":"Emma","color":"gold"},{"text":"> Mr. Looker, I've been searching everywhere for you!"}]
tellraw @s[scores={DialogueTrigger=217,TalkTime=104}] ["",{"text":"<"},{"text":"Emma","color":"gold"},{"text":"> Please t-tell me why, please..."}]
tellraw @s[scores={DialogueTrigger=217,TalkTime=111}] ["",{"text":"<"},{"text":"Emma","color":"gold"},{"text":"> Why did you lie to us? Why are you leaving us behind?"}]
tellraw @s[scores={DialogueTrigger=217,TalkTime=119}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> I...I'm sorry, Emma..."}]
tellraw @s[scores={DialogueTrigger=217,TalkTime=126}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> But my letter explains everything."}]
tellraw @s[scores={DialogueTrigger=217,TalkTime=133}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> I work for the International Police! I am a globe-trotting, crime-fighting elite!"}]
tellraw @s[scores={DialogueTrigger=217,TalkTime=144}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> Wherever there is a case, I must go! Justice awaits!"}]
tellraw @s[scores={DialogueTrigger=217,TalkTime=153}] ["",{"text":"<"},{"text":"Emma","color":"gold"},{"text":"> Then take me and Mimi with you. We'll join whatever police!"}]
tellraw @s[scores={DialogueTrigger=217,TalkTime=162}] ["",{"text":"<"},{"text":"Emma","color":"gold"},{"text":"> We can be police or anything-- if only we can just stay together!"}]
tellraw @s[scores={DialogueTrigger=217,TalkTime=171}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> Emma, I wish it could be like that."}]
tellraw @s[scores={DialogueTrigger=217,TalkTime=179}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> You can't come. It's not possible at all."}]
tellraw @s[scores={DialogueTrigger=217,TalkTime=187}] ["",{"text":"<"},{"text":"Emma","color":"gold"},{"text":"> Why not?! Why can't we?!"}]
tellraw @s[scores={DialogueTrigger=217,TalkTime=194}] ["",{"text":"<"},{"text":"Emma","color":"gold"},{"text":"> I'm part of the Looker Bureau, too! I'm your assistant, aren't I?!"}]
tellraw @s[scores={DialogueTrigger=217,TalkTime=205}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> In fact, the time has come for you to graduate from being my assistant."}]
tellraw @s[scores={DialogueTrigger=217,TalkTime=215}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> As of this moment, I name you the new head of the Looker Bureau!"}]
tellraw @s[scores={DialogueTrigger=217,TalkTime=224}] ["",{"text":"<"},{"text":"Emma","color":"gold"},{"text":"> Wh-what?"}]
tellraw @s[scores={DialogueTrigger=217,TalkTime=231}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> Listen to me, Emma. You were born and raised in this fair city."}]
tellraw @s[scores={DialogueTrigger=217,TalkTime=240}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> Every day of your life, you have been here."}]
tellraw @s[scores={DialogueTrigger=217,TalkTime=247}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> You are the only one who knows this city inside and out."}]
tellraw @s[scores={DialogueTrigger=217,TalkTime=255}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> No one else could do the things you can do for it!"}]
tellraw @s[scores={DialogueTrigger=217,TalkTime=263}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> I pass my torch of brilliant detective-ing to you!"}]
tellraw @s[scores={DialogueTrigger=217,TalkTime=271}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> Take my place, and keep protecting the peace of Lumiose City!"}]
tellraw @s[scores={DialogueTrigger=217,TalkTime=280}] ["",{"text":"<"},{"text":"Emma","color":"gold"},{"text":"> But that's not fair at all!"}]
tellraw @s[scores={DialogueTrigger=217,TalkTime=287}] ["",{"text":"<"},{"text":"Emma","color":"gold"},{"text":"> Come on, "},{"selector":"@s"},{"text":"! Say something! Tell him he's wrong!"}]
tellraw @s[scores={DialogueTrigger=217,TalkTime=296}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> Emma, please. I must ask you to respect the necessity of my decision."}]
tellraw @s[scores={DialogueTrigger=217,TalkTime=305}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> "},{"selector":"@s"},{"text":" understands perfectly why I must go. It is the way of partners."}]
tellraw @s[scores={DialogueTrigger=217,TalkTime=316}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> They are my partner. We understand each other."}]
tellraw @s[scores={DialogueTrigger=217,TalkTime=323}] ["",{"text":"<"},{"text":"Mimi","color":"light_purple"},{"text":"> Mrrrawrrr..."}]
execute as @s[scores={DialogueTrigger=217,TalkTime=323}] run playsound espurr hostile @s ~ ~ ~ 100 1 1
tellraw @s[scores={DialogueTrigger=217,TalkTime=328}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> Oh, Mimi... Please don't make a sad face on my account."}]
tellraw @s[scores={DialogueTrigger=217,TalkTime=326}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> No matter where I go, our bonds will never change."}]
tellraw @s[scores={DialogueTrigger=217,TalkTime=334}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> You will be my dear friends from the Looker Bureau, always and forever."}]
tellraw @s[scores={DialogueTrigger=217,TalkTime=344}] {"text":"<Team Flare Xerosic> Yes! That is it! Bonds!"}
tellraw @s[scores={DialogueTrigger=217,TalkTime=351}] {"text":"<Team Flare Xerosic> The preposterous notion which cannot be seen nor measured!"}
tellraw @s[scores={DialogueTrigger=217,TalkTime=360}] {"text":"<Team Flare Xerosic> And yet I cannot deny that they do still exist!"}
tellraw @s[scores={DialogueTrigger=217,TalkTime=368}] {"text":"<Team Flare Xerosic> Fear not, Emma, for I suspect that you will always be tied to the International Police by your bonds!"}
tellraw @s[scores={DialogueTrigger=217,TalkTime=379}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> Dr. Xerosic..."}]
tellraw @s[scores={DialogueTrigger=217,TalkTime=386}] {"text":"<Team Flare Xerosic> Emma! I give you my Expansion Suit!"}
tellraw @s[scores={DialogueTrigger=217,TalkTime=393}] {"text":"<Team Flare Xerosic> I have removed the remote-control functionality, so you needn't worry!"}
tellraw @s[scores={DialogueTrigger=217,TalkTime=402}] {"text":"<Team Flare Xerosic> As the new head detective in town, please use your powers as Essentia to protect your beloved Lumiose City!"}
tellraw @s[scores={DialogueTrigger=217,TalkTime=414}] {"text":"<Team Flare Xerosic> And...and..."}
tellraw @s[scores={DialogueTrigger=217,TalkTime=421}] {"text":"<Team Flare Xerosic> Please take all of the Pokémon that I raised for so long! They are yours now!"}
tellraw @s[scores={DialogueTrigger=217,TalkTime=430}] ["",{"text":"<"},{"text":"Emma","color":"gold"},{"text":"> Dr. Xerosic... Dr. Xerosic, you've tried to do terrible things to the world, I guess."}]
tellraw @s[scores={DialogueTrigger=217,TalkTime=440}] ["",{"text":"<"},{"text":"Emma","color":"gold"},{"text":"> I find it hard to see you as that kind of person."}]
tellraw @s[scores={DialogueTrigger=217,TalkTime=448}] ["",{"text":"<"},{"text":"Emma","color":"gold"},{"text":"> I only became a Pokémon Trainer thanks to your being there for me."}]
tellraw @s[scores={DialogueTrigger=217,TalkTime=456}] ["",{"text":"<"},{"text":"Emma","color":"gold"},{"text":"> ... ... ... I will always cherish your Pokémon and your suit, Dr. Xerosic."}]
tellraw @s[scores={DialogueTrigger=217,TalkTime=465}] ["",{"text":"<"},{"text":"Emma","color":"gold"},{"text":"> I won't forget our bonds, either..."}]
tellraw @s[scores={DialogueTrigger=217,TalkTime=473}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> Everyone... I'm sorry, but..."}]
tellraw @s[scores={DialogueTrigger=217,TalkTime=480}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> We are nearly out of time. Our train is due to depart."}]
tellraw @s[scores={DialogueTrigger=217,TalkTime=489}] ["",{"text":"<"},{"text":"Emma","color":"gold"},{"text":"> Mr. Looker... I think I understand..."}]
tellraw @s[scores={DialogueTrigger=217,TalkTime=496}] ["",{"text":"<"},{"text":"Emma","color":"gold"},{"text":"> And I know what I'm gonna do. I'll keep on working hard for you."}]
tellraw @s[scores={DialogueTrigger=217,TalkTime=506}] ["",{"text":"<"},{"text":"Emma","color":"gold"},{"text":"> I've got Mimi and "},{"selector":"@s"},{"text":" to help me."}]
tellraw @s[scores={DialogueTrigger=217,TalkTime=515}] ["",{"text":"<"},{"text":"Emma","color":"gold"},{"text":"> With Dr. Xerosic's Pokémon and Expansion Suit, I will become the new head of the Looker Bureau!"}]
tellraw @s[scores={DialogueTrigger=217,TalkTime=526}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> I leave it in your hands, Emma!"}]
tellraw @s[scores={DialogueTrigger=217,TalkTime=534}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> I'll rest easy, knowing you're on the case!"}]
tellraw @s[scores={DialogueTrigger=217,TalkTime=543}] {"text":"<Team Flare Xerosic> Emma! Don't you mess this up, my girl!"}
tellraw @s[scores={DialogueTrigger=217,TalkTime=551}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> Ahem... "},{"selector":"@s"},{"text":"! Emma! Mimi!"}]
tellraw @s[scores={DialogueTrigger=217,TalkTime=560}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> I entrust to you three the great task of protecting the peace of Lumiose City!"}]
tellraw @s[scores={DialogueTrigger=217,TalkTime=572}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> Thank you for everything! Farewell, my friends!"}]

