tellraw @s[scores={DialogueTrigger=182,TalkTime=316}] ["",{"text":"<"},{"text":"Emma","color":"yellow"},{"text":"> \u3042\u305f\u3057\u306e\u3053\u3068\u306f \u3069\u3046\u3067\u3082 \u3044\u3044\u2026\u2026 \u3051\u3069 \u30eb\u30c3\u30ab\u30fc\u304a\u3058\u3055\u3093 \u306e\u3053\u3068 \u308f\u308b\u304f \u3044\u3046\u306e\u306f \u3086\u308b\u3055\u306a\u3044\u2026\u2026"}]
tellraw @s[scores={DialogueTrigger=182,TalkTime=326}] ["",{"text":"<"},{"text":"Emma","color":"yellow"},{"text":"> \u2026\u2026\u305d\u308c\u306b\u3055 \u3042\u305f\u3057\u304c \u304a\u3058\u3055\u3093\u306e \u3053\u3069\u3082\u306e \u308f\u3051 \u306a\u3044\u3088 \u2026\u2026\u304a\u3058\u3055\u3093\u306b \u3057\u3064\u308c\u3044 \u3060\u3088"}]
