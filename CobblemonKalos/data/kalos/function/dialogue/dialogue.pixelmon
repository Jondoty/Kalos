tellraw @s[scores={DialogueTrigger=153,TalkTime=15}] {"text":"<Diantha> This will be your--and your Pokémon's--legacy!"}
tellraw @s[scores={DialogueTrigger=153,TalkTime=23}] ["",{"text":"<Diantha> Come, "},{"selector":"@s"},{"text":"\u2026 Your love for your Pokémon\u2026 "}]
tellraw @s[scores={DialogueTrigger=153,TalkTime=30}] {"text":"<Diantha> And the way that those Pokémon gave everything they had in battle for you\u2026"}
tellraw @s[scores={DialogueTrigger=153,TalkTime=40}] {"text":"<Diantha> We'll record them all right here, at this healer, for eternity."}

