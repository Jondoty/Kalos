tellraw @s[scores={DialogueTrigger=168,TalkTime=1}] {"text":"<Editor-in-chief> Whoa!"}
tellraw @s[scores={DialogueTrigger=168,TalkTime=6}] {"text":"<Editor-in-chief> S-sorry! I was so surprised!"}
tellraw @s[scores={DialogueTrigger=168,TalkTime=12}] {"text":"<Editor-in-chief> I've been looking for Volcanion for 15 years."}
tellraw @s[scores={DialogueTrigger=168,TalkTime=20}] {"text":"<Editor-in-chief> And finally, finally, I met a Trainer who managed to catch it!"}
tellraw @s[scores={DialogueTrigger=168,TalkTime=28}] {"text":"<Editor-in-chief> I traveled everywhere to gather the information about Volcanion and put together a memo."}
tellraw @s[scores={DialogueTrigger=168,TalkTime=38}] {"text":"<Editor-in-chief> I'll let you read the memo. But just for you, because it's top secret."}
#tellraw @s[score_DialogueTrigger_min=168,score_DialogueTrigger=168,tag=!Dialogue168,score_TalkTime_min=47,score_TalkTime=47] ["",{"text":"<Editor-in-chief> Do you want to read the top- secret memo about Volcanion?\n["},{"text":"Yes","color":"green","clickEvent":{"action":"run_command","value":"/trigger TalkTrigger set 20"}},{"text":"] \u0020 \u0020 \u0020["},{"text":"No","color":"red","clickEvent":{"action":"run_command","value":"/trigger TalkTrigger set 21"}},{"text":"]"}]
#execute as @s[score_DialogueTrigger_min=168,score_DialogueTrigger=168,tag=!Dialogue168,score_TalkTime_min=46,score_TalkTime=47] run scoreboard players enable @s TalkTrigger

