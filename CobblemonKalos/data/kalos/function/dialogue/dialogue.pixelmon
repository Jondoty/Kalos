tellraw @s[scores={DialogueTrigger=88,TalkTime=2}] ["",{"text":"<"},{"text":"...","color":"dark_green"},{"text":"> Come now. Work for Team Flare!"}]
tellraw @s[scores={DialogueTrigger=88,TalkTime=9}] ["",{"text":"<"},{"text":"...","color":"dark_green"},{"text":"> If you'd just help out, we wouldn't have to carry all these Poké Balls by ourselves."}]
tellraw @s[scores={DialogueTrigger=88,TalkTime=18}] ["",{"text":"<"},{"text":"...","color":"light_purple"},{"text":"> Or, with a contribution of just $5,000,000, you could become a member of Team Flare. It's a no-brainer!"}]
tellraw @s[scores={DialogueTrigger=88,TalkTime=27}] {"text":"<Factory President> What in the world are you Team Flare fools thinking?!"}
tellraw @s[scores={DialogueTrigger=88,TalkTime=35}] {"text":"<Factory President> I'll never forgive any group that tries to take all the Poké Balls for itself!"}
tellraw @s[scores={DialogueTrigger=88,TalkTime=43}] ["",{"text":"<"},{"text":"...","color":"dark_green"},{"text":"> Forget it. Quit wasting your time with this person."}]
tellraw @s[scores={DialogueTrigger=88,TalkTime=50}] ["",{"text":"<"},{"text":"...","color":"red"},{"text":"> I agree. There's no one we can use here. Let's blow this place to smithereens."}]
tellraw @s[scores={DialogueTrigger=88,TalkTime=60}] ["",{"text":"<"},{"text":"...","color":"red"},{"text":"> Well, what do we have here? An intruder?"}]
tellraw @s[scores={DialogueTrigger=88,TalkTime=67}] {"text":"<Factory President> You're one to talk! You! Please! Help me!"}
tellraw @s[scores={DialogueTrigger=88,TalkTime=75}] ["",{"text":"<"},{"text":"...","color":"red"},{"text":"> My oh my. Getting a little desperate, are we, Mr. Company President?"}]
tellraw @s[scores={DialogueTrigger=88,TalkTime=83}] ["",{"text":"<"},{"text":"...","color":"red"},{"text":"> Well, I guess I'll just have to extinguish your little glimmer of hope."}]

