tellraw @s[scores={DialogueTrigger=98,TalkTime=21}] {"text":"<Trevor> Doesn't battling with Team Flare scare you, "},{"selector":"@s"},{"text":"?"}]
tellraw @s[scores={DialogueTrigger=98,TalkTime=28}] {"text":"<Trevor> I'll admit it scares me. I don't like battling them..."}]
tellraw @s[scores={DialogueTrigger=98,TalkTime=36}] {"text":"<Trevor> But we managed to protect Abomasnow by pitching in there."}]
tellraw @s[scores={DialogueTrigger=98,TalkTime=44}] {"text":"<Trevor> I know I'm the reserved type, and I'm OK with that, but it's important to be bold when necessary."}]
tellraw @s[scores={DialogueTrigger=98,TalkTime=54}] {"text":"<Trevor> Mamoswine doesn't have to worry about Abomasnow anymore, and that's what matters. All's well that ends well!"}]

