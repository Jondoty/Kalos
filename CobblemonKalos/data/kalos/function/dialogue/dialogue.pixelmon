tellraw @s[scores={DialogueTrigger=191,TalkTime=30}] {"text":"<Black Belt> ...It was over in a flash."}
tellraw @s[scores={DialogueTrigger=191,TalkTime=37}] {"text":"<Black Belt> I was training here in the alley when an enchanting young lady challenged me to battle... And then she..."}
tellraw @s[scores={DialogueTrigger=191,TalkTime=47}] [<Looker> What did she do?"}]
tellraw @s[scores={DialogueTrigger=191,TalkTime=55}] {"text":"<Black Belt> She utterly destroyed me!"}
tellraw @s[scores={DialogueTrigger=191,TalkTime=63}] {"text":"<Black Belt> My heart was stolen by those brunette locks and the intensity of those glittering eyes!"}
