#Lumiose Museum after vandalization
#execute as @s[x=-83,y=77,z=355,r=7,score_TalkTime=0,tag=Dialogue185] run scoreboard players set @s[tag=!Dialogue186] DialogueTrigger 186

tellraw @s[scores={DialogueTrigger=186,TalkTime=3}] {"text":"<Artist> Hey, kid! Listen to this!"}
tellraw @s[scores={DialogueTrigger=186,TalkTime=8}] {"text":"<Artist> You've got some timing, picking today of all days to come to the museum..."}
tellraw @s[scores={DialogueTrigger=186,TalkTime=18}] {"text":"<Artist> Or are you here because you heard about what happened?"}
tellraw @s[scores={DialogueTrigger=186,TalkTime=26}] {"text":"<Artist> Someone went and left some crazy graffiti on a piece on the third floor!"}
tellraw @s[scores={DialogueTrigger=186,TalkTime=35}] {"text":"<Artist> Some kind of depraved criminal, I guess, sabotaging a historic and valuable artwork!"}
tellraw @s[scores={DialogueTrigger=186,TalkTime=45}] {"text":"<Artist> You know, this place is supposed to have the strictest security."}
tellraw @s[scores={DialogueTrigger=186,TalkTime=54}] {"text":"<Artist> I wonder how a criminal would get access..."}
tellraw @s[scores={DialogueTrigger=186,TalkTime=62}] {"text":"<Artist> Head up to the top floor, and you can see the outrage."}
tellraw @s[scores={DialogueTrigger=186,TalkTime=70}] {"text":"<Artist> Believe me, it's unbelievable."}
tellraw @s[scores={DialogueTrigger=186,TalkTime=77}] {"text":"<Artist> The museum director's up there, too. Maybe he can tell you more."}

