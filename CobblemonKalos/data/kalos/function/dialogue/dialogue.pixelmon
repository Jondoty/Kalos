scoreboard players set @s[tag=Dialogue175] TalkTime 0
scoreboard players set @s[tag=Dialogue175] DialogueTrigger 0

#----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
#Looker starting Chapter 2 after Holo Call
#execute as @s[x=-191,y=101,z=-637,dy=5,dz=6,tag=Call14,scores={TalkTime=0}] run scoreboard players set @s[tag=!Dialogue176] DialogueTrigger 176

tellraw @s[scores={DialogueTrigger=176,TalkTime=2}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> "},{"selector":"@s"},{"text":", you're here! You got my message on the Holo Caster, in fact?"}]
tellraw @s[scores={DialogueTrigger=176,TalkTime=11}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> Then I need three minutes only. It is this. We have a case to solve!"}]
tellraw @s[scores={DialogueTrigger=176,TalkTime=21}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> I count on your help, "},{"selector":"@s"},{"text":"! Let us put our partnership to the test!"}]
tellraw @s[scores={DialogueTrigger=176,TalkTime=31}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> Here are some of my notes for this case."}]
tellraw @s[scores={DialogueTrigger=176,TalkTime=39}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> Client: A rep from a Lumiose City mothers' group"}]
tellraw @s[scores={DialogueTrigger=176,TalkTime=47}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> Details: \u201cKids in Lumiose City seem to be spending a lot of time in back alleys recently.\u201d"}]
tellraw @s[scores={DialogueTrigger=176,TalkTime=57}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> \u201cWhat are they up to in these shadowy, suspicious places? Inquiring mothers want to know!\u201d"}]
tellraw @s[scores={DialogueTrigger=176,TalkTime=67}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> \u201cMy son is about to take the entrance exam for an elite school for future Ace Trainers!\u201d"}]
tellraw @s[scores={DialogueTrigger=176,TalkTime=77}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> \u201cI can't have him do anything stupid and get a black mark on his academic record!\u201d"}]
tellraw @s[scores={DialogueTrigger=176,TalkTime=87}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> \u201cYou must do something to make kids stop hanging out in those suspicious alleys!\u201d"}]
tellraw @s[scores={DialogueTrigger=176,TalkTime=97}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> Reward: Enough dough to last for a week"}]
tellraw @s[scores={DialogueTrigger=176,TalkTime=105}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> All ready to go? Good! The first thing I want you to do is to visit those dark alleys in Lumiose City."}]
tellraw @s[scores={DialogueTrigger=176,TalkTime=116}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> Find where kids are hanging out, and get the lowdown on the situation."}]
tellraw @s[scores={DialogueTrigger=176,TalkTime=124}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> Got it? Think you can handle it, partner?"}]
tellraw @s[scores={DialogueTrigger=176,TalkTime=132}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> I am counting on you, "},{"selector":"@s"},{"text":". There are a number of alleys here in Lumiose City."}]
execute as @s[scores={DialogueTrigger=176,TalkTime=131}] run scoreboard players set @s click 1
tellraw @s[scores={DialogueTrigger=176,TalkTime=142}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> Somewhere, in one of them, you should find those kids! Yes. Yes, indeed."}]
tellraw @s[scores={DialogueTrigger=176,TalkTime=151}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> Hmm... My gut tells me there's something fishy about the alleys leading off Estival Avenue."}]
tellraw @s[scores={DialogueTrigger=176,TalkTime=161}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> When you've got a gut boiled as hard as mine, it's worth paying attention to!"}]
tellraw @s[scores={DialogueTrigger=176,TalkTime=171}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> Start your investigations on Estival Avenue.. I'll join you when I can."}]

