tellraw @s[scores={DialogueTrigger=233,TalkTime=14}] ["",{"text":"<"},{"text":"Evelyn","color":"aqua"},{"text":"> Now that I've seen how strong you are, I feel I shouldn't have held back."}]
tellraw @s[scores={DialogueTrigger=233,TalkTime=23}] ["",{"text":"<"},{"text":"Evelyn","color":"aqua"},{"text":"> It's just that my elder sisters had asked me to take it a bit easy on new guests..."}]
tellraw @s[scores={DialogueTrigger=233,TalkTime=33}] ["",{"text":"<"},{"text":"Evelyn","color":"aqua"},{"text":"> The next time that we battle, I will try much harder to beat you!"}]
tellraw @s[scores={DialogueTrigger=233,TalkTime=42}] ["",{"text":"<"},{"text":"Evelyn","color":"aqua"},{"text":"> P-please continue to patronize the Battle Maison... And to challenge me!"}]
