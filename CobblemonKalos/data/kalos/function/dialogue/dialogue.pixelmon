tellraw @s[scores={DialogueTrigger=213,TalkTime=175}] {"text":"<Emma> Huh? Wait? Why is everyone here?"}]
tellraw @s[scores={DialogueTrigger=213,TalkTime=184}] {"text":"<Emma> I thought it was a secret that I was working here!"}]
tellraw @s[scores={DialogueTrigger=213,TalkTime=193}] [<Looker> E-Emma... Are you...all right?"}]
tellraw @s[scores={DialogueTrigger=213,TalkTime=200}] {"text":"<Emma> Hm? What do you mean? I've just been taking a nap."}]
tellraw @s[scores={DialogueTrigger=213,TalkTime=209}] {"text":"<Emma> My job here was really easy. All I had to do was wear this suit while I snoozed away."}]
tellraw @s[scores={DialogueTrigger=213,TalkTime=220}] {"text":"<Emma> What are you doing here, Mr. Looker? I thought you were in the hospital!"}]
tellraw @s[scores={DialogueTrigger=213,TalkTime=230}] [<Looker> Uh... Ahem. N-no... You see..."}]
tellraw @s[scores={DialogueTrigger=213,TalkTime=239}] [<Looker> I got, uh, special permission to check myself out of the...hospital..."}]
tellraw @s[scores={DialogueTrigger=213,TalkTime=249}] [<Looker> I had to make sure you were OK, Emma."}]
tellraw @s[scores={DialogueTrigger=213,TalkTime=257}] [<Looker> I had to see you, so I found out where you worked and came to find you."}]
tellraw @s[scores={DialogueTrigger=213,TalkTime=267}] {"text":"<Emma> Oh, I see. I was afraid you might be mad because I started working without telling you."}]
tellraw @s[scores={DialogueTrigger=213,TalkTime=279}] {"text":"<Emma> I kept it a secret all this time..."}]
tellraw @s[scores={DialogueTrigger=213,TalkTime=287}] {"text":"<Emma> You really are a great detective, aren't you, Mr. Looker? You found me anyway!"}]
tellraw @s[scores={DialogueTrigger=213,TalkTime=298}] [<Looker> Naturally! Now, Emma, how about you go and get some dinner?"}]
