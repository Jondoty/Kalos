tellraw @s[scores={DialogueTrigger=191,TalkTime=87}] {"text":"<Black Belt> The memory is enough to make me start crying again..."}
tellraw @s[scores={DialogueTrigger=191,TalkTime=95}] [<Looker> Argh! So we were too late... And where did the woman go?!"}]
tellraw @s[scores={DialogueTrigger=191,TalkTime=103}] {"text":"<Black Belt> Sniffle...sniffle... She went running off toward Estival Avenue, I guess..."}
tellraw @s[scores={DialogueTrigger=191,TalkTime=113}] {"text":"<Black Belt> Ugh... What possessed that... svelte siren..."}
