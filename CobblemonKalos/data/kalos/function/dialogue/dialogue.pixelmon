tellraw @s[scores={DialogueTrigger=185,TalkTime=101}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> Did you see that, "},{"selector":"@s"},{"text":"?! Where trouble goes, Looker must follow!"}]
tellraw @s[scores={DialogueTrigger=185,TalkTime=111}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> I am on my way to the Lumiose Museum to begin my investigations! Most urgently!"}]
tellraw @s[scores={DialogueTrigger=185,TalkTime=121}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> It is straight to the scene of the crime for us!"}]
tellraw @s[scores={DialogueTrigger=185,TalkTime=128}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> ...Oh, wouldn't it be nice if that were true?"}]
tellraw @s[scores={DialogueTrigger=185,TalkTime=135}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> But I actually have an appointment soon that I cannot possibly miss, so I am stuck here..."}]
tellraw @s[scores={DialogueTrigger=185,TalkTime=145}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> I hate to ask this of you, but I need you to start the investigation without me, "},{"selector":"@s"},{"text":"!"}]

