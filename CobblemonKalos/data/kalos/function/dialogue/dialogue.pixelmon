tellraw @s[scores={DialogueTrigger=236,TalkTime=12}] {"text":"<Evelyn> You don't...do you... Of course... I-I'm Evelyn..."}]
tellraw @s[scores={DialogueTrigger=236,TalkTime=21}] {"text":"<Evelyn> U-um... You really are a strong Trainer, aren't you, dear guest?"}]
