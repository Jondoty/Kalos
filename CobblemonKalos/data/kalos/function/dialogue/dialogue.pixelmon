tellraw @s[scores={DialogueTrigger=143,TalkTime=17}] ["",{"text":"<"},{"text":"Gym Guide","color":"gray"},{"text":"> It's never a bad thing to test the limits of your strength."}]
tellraw @s[scores={DialogueTrigger=143,TalkTime=25}] ["",{"text":"<"},{"text":"Gym Guide","color":"gray"},{"text":"> Am I right or am I right?"}]
tellraw @s[scores={DialogueTrigger=143,TalkTime=31}] ["",{"text":"<"},{"text":"Gym Guide","color":"gray"},{"text":"> And since you're such a star, I guess that means you're off to the Pokémon League!"}]

