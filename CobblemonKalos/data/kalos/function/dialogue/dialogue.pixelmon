#----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
#Scary House Story
#scoreboard players set @a[x=-233,y=100,z=-1225,dx=4,dy=5,tag=Dialogue82] DialogueTrigger 83

#tp gang in
execute as @s[scores={DialogueTrigger=83,TalkTime=1}] run tp @e[x=-504,y=160,z=1276,dy=3,type=pixelmon:npc_chatting] -229 88 -1238
execute as @s[scores={DialogueTrigger=83,TalkTime=1}] run tp @e[x=-504,y=160,z=1278,dy=3,type=pixelmon:npc_chatting] -232 88 -1238
execute as @s[scores={DialogueTrigger=83,TalkTime=1}] run tp @e[x=-504,y=160,z=1280,dy=3,type=pixelmon:npc_chatting] -233 88 -1236

tellraw @s[scores={DialogueTrigger=83,TalkTime=5}] {"text":"<...> Let's get started, then..."}
tellraw @s[scores={DialogueTrigger=83,TalkTime=12}] {"text":"<...> It was a dark and stormy night many years ago."}
tellraw @s[scores={DialogueTrigger=83,TalkTime=20}] {"text":"<...> Lost, I arrived at this house and went inside."}
tellraw @s[scores={DialogueTrigger=83,TalkTime=27}] {"text":"<...> The lights would not turn on, so I fearfully looked around the house."}
tellraw @s[scores={DialogueTrigger=83,TalkTime=36}] {"text":"<...> Eventually, I made my way into the kitchen. There was no sign of anyone being there..."}
tellraw @s[scores={DialogueTrigger=83,TalkTime=46}] {"text":"<...> I found the fridge, and when I opened it, a faint light leaked out."}
tellraw @s[scores={DialogueTrigger=83,TalkTime=53}] {"text":"<...> I could finally make out my surroundings."}
tellraw @s[scores={DialogueTrigger=83,TalkTime=60}] {"text":"<...> And I saw the faint outline of a man huddling in the corner of the room."}
tellraw @s[scores={DialogueTrigger=83,TalkTime=68}] {"text":"<...> I tried to tell him that I was lost and I was hoping he'd let me stay until morning, but when I approached him..."}
tellraw @s[scores={DialogueTrigger=83,TalkTime=78}] {"text":"<...> The man suddenly screamed, \u201cStay back!\u201d I apologized and continued to plead my case."}
tellraw @s[scores={DialogueTrigger=83,TalkTime=88}] {"text":"<...> \u201cPlease, can't you help me?\u201d"}
tellraw @s[scores={DialogueTrigger=83,TalkTime=95}] {"text":"<...> \u201cI'm not talking to you!\u201d he shouted."}
tellraw @s[scores={DialogueTrigger=83,TalkTime=102}] {"text":"<...> I looked at the man in surprise."}
tellraw @s[scores={DialogueTrigger=83,TalkTime=110}] {"text":"<...> When I did this, the man asked me... \u201cCan't you see them? Behind you!\u201d"}
tellraw @s[scores={DialogueTrigger=83,TalkTime=120}] {"text":"<...> \u201cA horde of faceless men!\u201d"}
execute as @s[scores={DialogueTrigger=83,TalkTime=124}] run playsound minecraft:entity.generic.explode ambient @s ~ ~ ~ 10 1 1

tellraw @s[scores={DialogueTrigger=83,TalkTime=133}] {"text":"<...> Now then... Since I told a wonderful story that will always haunt you..."}
tellraw @s[scores={DialogueTrigger=83,TalkTime=142}] {"text":"<...> Would you be so kind as to tip me? If you don't, you might see something really scary."}
tellraw @s[scores={DialogueTrigger=83,TalkTime=152}] {"text":"<Shauna> You're charging us?!"}
tellraw @s[scores={DialogueTrigger=83,TalkTime=160}] {"text":"<...> Even haunted houses aren't free, you know!"}
tellraw @s[scores={DialogueTrigger=83,TalkTime=167}] {"text":"<Shauna> Sheesh! Let's get out of here!"}
tellraw @s[scores={DialogueTrigger=83,TalkTime=175}] {"text":"<Tierno> Huh? Is it over already? I wasn't really listening."}
tellraw @s[scores={DialogueTrigger=83,TalkTime=183}] {"text":"<Trevor> Was that story you just told really true?"}
tellraw @s[scores={DialogueTrigger=83,TalkTime=190}] {"text":"<...> Some things are best left unknown... The truth is best carried to the grave..."}

