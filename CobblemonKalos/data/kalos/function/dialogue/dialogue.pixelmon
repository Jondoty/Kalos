tellraw @s[scores={DialogueTrigger=232,TalkTime=13}] {"text":"<Evelyn> My name is Evelyn... I'll t-try t-t-to serve you as a Battle Chatelaine like my sisters, so..."}]
tellraw @s[scores={DialogueTrigger=232,TalkTime=24}] {"text":"<Evelyn> I'm the th-third of us four. M-my specialty is... Double Battles... I guess..."}]
tellraw @s[scores={DialogueTrigger=232,TalkTime=34}] {"text":"<Evelyn> Umm... ... ... ..."}]
tellraw @s[scores={DialogueTrigger=232,TalkTime=41}] {"text":"<Evelyn> Th-the weather is in a lovely way today, isn't it? ... ... ..."}]
