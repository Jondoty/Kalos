tellraw @s[scores={DialogueTrigger=182,TalkTime=13}] {"text":"<...> \u304a\u306d\u304c\u3044\u3067\u3059\uff01 \u305f\u3059\u3051\u3066\u304f\u3060\u3055\u3044\uff01"}
tellraw @s[scores={DialogueTrigger=182,TalkTime=20}] {"text":"<...> \u305f\u3044\u305b\u3064\u306a \u30dd\u30b1\u30e2\u30f3\u3061\u3083\u3093\u304c \u306c\u3059\u307e\u308c\u3066 \u3057\u307e\u3063\u305f\u3093\u3067\u3059\uff01"}
tellraw @s[scores={DialogueTrigger=182,TalkTime=30}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> Oho! What have we here? One of our fair city's famous tourists!"}]
tellraw @s[scores={DialogueTrigger=182,TalkTime=40}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> From your manner of speaking, madame, I deduce that you have traveled far indeed!"}]
tellraw @s[scores={DialogueTrigger=182,TalkTime=50}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> I am...Looker. What may I do for you?"}]
tellraw @s[scores={DialogueTrigger=182,TalkTime=57}] {"text":"<...> \u308f\u305f\u3057\u306e \u3053\u3068\u3070\u304c \u308f\u304b\u308b\u3093\u3067\u3059\u306d \u3042\u3042 \u3088\u304b\u3063\u305f\uff01 \u305f\u3059\u304b\u308a\u307e\u3059\uff01"}
tellraw @s[scores={DialogueTrigger=182,TalkTime=67}] {"text":"<...> \u308f\u305f\u3057 \u3053\u306e\u304f\u306b\u306e \u3053\u3068\u3070\u306f \u30d2\u30a2\u30ea\u30f3\u30b0\u3057\u304b \u3067\u304d\u306a\u304f\u3066\uff01"}
tellraw @s[scores={DialogueTrigger=182,TalkTime=77}] {"text":"<...> \u3058\u3064\u306f \u3048\u304d\u3067 \u308f\u305f\u3057\u306e \u305f\u3044\u305b\u3064\u306a \u30dd\u30b1\u30e2\u30f3\u3061\u3083\u3093\u305f\u3061\u304c \u306c\u3059\u307e\u308c\u3066\uff01"}
tellraw @s[scores={DialogueTrigger=182,TalkTime=87}] {"text":"<...> \u305d\u308c\u3067 \u3053\u3053\u304c \u305f\u3093\u3066\u3044\u3058\u3080\u3057\u3087 \u3060\u3063\u3066 \u304d\u3044\u305f\u304b\u3089 \u3046\u304b\u304c\u3063\u305f\u3093\u3067\u3059\u3088\uff01"}
tellraw @s[scores={DialogueTrigger=182,TalkTime=97}] {"text":"<...> \u3069\u3046\u304b \u304a\u306d\u304c\u3044\u3057\u307e\u3059\uff01 \u3044\u307e\u3059\u3050 \u308f\u305f\u3057\u306e \u30dd\u30b1\u30e2\u30f3\u3061\u3083\u3093\u3092 \u3068\u308a\u304b\u3048\u3057\u3066 \u3044\u305f\u3060\u3051\u307e\u305b\u3093\u304b\uff1f"}
tellraw @s[scores={DialogueTrigger=182,TalkTime=107}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> Ahem... My dear lady..."}]
tellraw @s[scores={DialogueTrigger=182,TalkTime=115}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> I am so terribly sorry, but could you speak a bit less quickly?"}]
tellraw @s[scores={DialogueTrigger=182,TalkTime=125}] {"text":"<...> \u3059\u3063 \u3059\u3044\u307e\u305b\u3093\u2026\u2026 \u3067\u3082 \u3044\u305d\u3044\u3067\u308b\u3093\u3067\u3059\u3088\uff01"}
tellraw @s[scores={DialogueTrigger=182,TalkTime=135}] {"text":"<...> \u305f\u3044\u305b\u3064\u306a \u30dd\u30b1\u30e2\u30f3\u3061\u3083\u3093\u3092 \u3068\u308a\u304b\u3048\u3055\u306a\u3044\u3068 \u305d\u3053\u304f \u306b \u304b\u3048\u308b\u3053\u3068\u3082 \u3067\u304d\u307e\u305b\u3093\uff01"}
tellraw @s[scores={DialogueTrigger=182,TalkTime=145}] {"text":"<...> \u3072\u3053\u3046\u304d\u306e \u3058\u304b\u3093 \u3060\u3063\u3066 \u305b\u307e\u3063\u3066 \u304d\u3066\u3044\u308b\u3093\u3067\u3059\u3088\uff01"}
tellraw @s[scores={DialogueTrigger=182,TalkTime=155}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> Ahem... From what I can gather, it seems that this lady has been given sore offense."}]
tellraw @s[scores={DialogueTrigger=182,TalkTime=165}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> And do you know why that would be, "},{"selector":"@s"},{"text":", my friend?"}]
tellraw @s[scores={DialogueTrigger=182,TalkTime=175}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> Well, thanks to my gift for languages-- I've traveled all over the world, you know..."}]
tellraw @s[scores={DialogueTrigger=182,TalkTime=186}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> It seems she is highly offended that she has come as a guest and not yet been offered tea! Yes! Case closed!"}]
tellraw @s[scores={DialogueTrigger=182,TalkTime=198}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> Which means, my friend, I must make haste to obtain the requisite tea!"}]
tellraw @s[scores={DialogueTrigger=182,TalkTime=207}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> "},{"selector":"@s"},{"text":", please keep our guest company until my return from this vital mission."}]

