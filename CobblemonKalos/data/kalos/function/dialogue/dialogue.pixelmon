tellraw @s[scores={DialogueTrigger=96,TalkTime=3}] {"text":"<Trevor> It's really cold in here, isn't it, "},{"selector":"@s"},{"text":"?"}]
tellraw @s[scores={DialogueTrigger=96,TalkTime=10}] {"text":"<Trevor> Is there something going on up ahead?"}]

execute as @s[scores={DialogueTrigger=96,TalkTime=16}] run scoreboard players set @s click 1
tellraw @s[scores={DialogueTrigger=96,TalkTime=16}] ["",{"text":"<"},{"text":"...","color":"dark_aqua"},{"text":"> This Abomasnow is a fine specimen! It's absolutely brimming with energy."}]
tellraw @s[scores={DialogueTrigger=96,TalkTime=25}] ["",{"text":"<"},{"text":"...","color":"dark_aqua"},{"text":"> The more we agitate it, the stronger its Snow Warning Ability becomes, making the snow fall even more furiously."}]
tellraw @s[scores={DialogueTrigger=96,TalkTime=35}] ["",{"text":"<"},{"text":"...","color":"dark_aqua"},{"text":"> Let's catch it swiftly and get out of here."}]
tellraw @s[scores={DialogueTrigger=96,TalkTime=43}] ["",{"text":"<Abomasnow> "},{"text":"Snowww...","italic":true}]
execute as @s[scores={DialogueTrigger=96,TalkTime=43}] run playsound pixelmon:pixelmon.mob.abomasnow hostile @s ~ ~ ~ 10 1 1
tellraw @s[scores={DialogueTrigger=96,TalkTime=47}] {"text":"<Trevor> Hey!"}]

#tp trevor closer
execute as @s[scores={DialogueTrigger=96,TalkTime=50}] run particle cloud 676 85 -1297 2 2 2 1 100
execute as @s[scores={DialogueTrigger=96,TalkTime=50}] run particle cloud 673 85 -1353 2 2 2 1 100
execute as @s[scores={DialogueTrigger=96,TalkTime=50}] run tp @e[x=676,y=84,z=-1297,dy=3,type=pixelmon:npc_chatting] -504 211 1268
execute as @s[scores={DialogueTrigger=96,TalkTime=50}] run tp @e[x=-504,y=210,z=1270,dy=3,type=pixelmon:npc_chatting] 673 85 -1353

tellraw @s[scores={DialogueTrigger=96,TalkTime=55}] {"text":"<Trevor> Hey, you Poké Ball thieves! What are you doing here?!"}]
tellraw @s[scores={DialogueTrigger=96,TalkTime=63}] ["",{"text":"<"},{"text":"...","color":"dark_aqua"},{"text":"> What does it look like? We're catching Pokémon. Why else would we have grabbed all of those Poké Balls?"}]
tellraw @s[scores={DialogueTrigger=96,TalkTime=73}] ["",{"text":"<"},{"text":"...","color":"dark_aqua"},{"text":"> It was all so we could catch powerful Pokémon like this Abomasnow. It's full of potent energy!"}]
tellraw @s[scores={DialogueTrigger=96,TalkTime=83}] {"text":"<Trevor> Energy?"}]
tellraw @s[scores={DialogueTrigger=96,TalkTime=88}] ["",{"text":"<"},{"text":"...","color":"dark_aqua"},{"text":"> You're not the brightest one, are you? Whoever has the most Pokémon and the most energy will come out on top!"}]
tellraw @s[scores={DialogueTrigger=96,TalkTime=99}] ["",{"text":"<"},{"text":"...","color":"dark_aqua"},{"text":"> Lazy people who just wait for things to be handed to them don't get to have these resources!"}]
tellraw @s[scores={DialogueTrigger=96,TalkTime=109}] {"text":"<Trevor> But why is Team Flare amassing Pokémon, energy, and money?"}]
tellraw @s[scores={DialogueTrigger=96,TalkTime=117}] {"text":"<Trevor> To put it another way, why is Team Flare always trying to take everything for itself?"}]
tellraw @s[scores={DialogueTrigger=96,TalkTime=126}] ["",{"text":"<"},{"text":"...","color":"dark_aqua"},{"text":"> Allow me to spell it out for you! It's so Team Flare--and only Team Flare--can survive!"}]
tellraw @s[scores={DialogueTrigger=96,TalkTime=136}] ["",{"text":"<"},{"text":"...","color":"dark_aqua"},{"text":"> After all, why should we care about saving people who aren't on our side?"}]
tellraw @s[scores={DialogueTrigger=96,TalkTime=145}] ["",{"text":"<"},{"text":"...","color":"dark_aqua"},{"text":"> Anyway, I don't mind a healthy curiosity, but I'm afraid I just don't have any more time for you."}]
tellraw @s[scores={DialogueTrigger=96,TalkTime=155}] {"text":"<Trevor> "},{"selector":"@s"},{"text":"... Did they say only Team Flare will survive? These people have a few screws loose..."}]
tellraw @s[scores={DialogueTrigger=96,TalkTime=166}] ["",{"text":"<"},{"text":"...","color":"dark_aqua"},{"text":"> You two--hurry up and send these kids packing!"}]
tellraw @s[scores={DialogueTrigger=96,TalkTime=173}] ["",{"text":"<"},{"text":"Team Flare Grunt","color":"red"},{"text":"> Yes, ma'am!"}]
tellraw @s[scores={DialogueTrigger=96,TalkTime=176}] {"text":"<Team Flare Grunt> Right away!"}
tellraw @s[scores={DialogueTrigger=96,TalkTime=185}] ["",{"text":"<"},{"text":"Team Flare Grunt","color":"red"},{"text":"> Let's go! Team Flare! This is the trademark pose of Team Flare! It's the very definition of fashionable!"}]

