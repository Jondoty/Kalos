tellraw @s[scores={DialogueTrigger=195,TalkTime=10}] {"text":"<Malva> It may happen that I have need of your services,"}
tellraw @s[scores={DialogueTrigger=195,TalkTime=17}] {"text":"<Malva> but I expect you to keep in mind how valuable my time is!"}
tellraw @s[scores={DialogueTrigger=195,TalkTime=26}] {"text":"<Malva> Oh, never mind! Just fight me!"}
