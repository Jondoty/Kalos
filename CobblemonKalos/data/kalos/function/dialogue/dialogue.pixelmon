tellraw @s[scores={DialogueTrigger=179,TalkTime=2}] [<Looker> You're here, "},{"selector":"@s"},{"text":"! That is good. I need 30 seconds of your time, no more."}]
tellraw @s[scores={DialogueTrigger=179,TalkTime=12}] [<Looker> It is about our new friend, Emma."}]
tellraw @s[scores={DialogueTrigger=179,TalkTime=20}] [<Looker> Ever since she started living here at the office, I have detected some signs of stress in her."}]
tellraw @s[scores={DialogueTrigger=179,TalkTime=30}] [<Looker> This has caused me to worry. What do you think, "},{"selector":"@s"},{"text":"? "}]
tellraw @s[scores={DialogueTrigger=179,TalkTime=40}] [<Looker> Could it be that there is something wrong?\n["},{"text":"Yes","color":"green","clickEvent":{"action":"run_command","value":"/trigger TalkTrigger set 27"}},{"text":"] \u0020 ["},{"text":"No","color":"red","clickEvent":{"action":"run_command","value":"/trigger TalkTrigger set 28"}},{"text":"]"}]
