tellraw @s[scores={DialogueTrigger=193,TalkTime=100}] {"text":"<...> I am terribly sorry to intrude upon you, but I have a request."}
tellraw @s[scores={DialogueTrigger=193,TalkTime=109}] ["",{"text":"<...> But before we discuss the reason for my visit today, would you allow me to verify your strength, "},{"selector":"@s"},{"text":"?"}]

