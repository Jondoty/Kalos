#Nita Introduction
#Dialogue230

tellraw @s[scores={DialogueTrigger=230,TalkTime=5}] ["",{"text":"<"},{"text":"...","color":"yellow"},{"text":"> Hello-how-are-ya? Are ya in good form? "}]
tellraw @s[scores={DialogueTrigger=230,TalkTime=13}] {"text":"<Nita> I'm Nita. Welcome to the Battle Maison, pet."}]
tellraw @s[scores={DialogueTrigger=230,TalkTime=21}] {"text":"<Nita> Sure, I may be the youngest of the Battle Chatelaine sisters, but I'm still a class Trainer."}]
tellraw @s[scores={DialogueTrigger=230,TalkTime=31}] {"text":"<Nita> I've been an owner of the Battle Maison this long while. Honest, I'm not telling fibs!"}]
tellraw @s[scores={DialogueTrigger=230,TalkTime=41}] {"text":"<Nita> I'd be in charge of the Single Battles myself. Would you do me a favor? Of a bit of a match?"}]
tellraw @s[scores={DialogueTrigger=230,TalkTime=51}] {"text":"<Nita> You will? Grand! Then let's begin at once!"}]

