tellraw @s[scores={DialogueTrigger=133,TalkTime=158,Xerneas=1..}] ["",{"text":"<"},{"text":"Lysandre","color":"dark_red"},{"text":"> That's right! I shall grant you eternal life!"}]
tellraw @s[scores={DialogueTrigger=133,TalkTime=165,Xerneas=1..}] ["",{"text":"<"},{"text":"Lysandre","color":"dark_red"},{"text":"> I'll give you the pain of endlessly waiting for a beautiful world to finally be built!"}]

