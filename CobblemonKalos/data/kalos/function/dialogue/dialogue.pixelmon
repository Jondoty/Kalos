#----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
#Professor Sycamore in Anistar City post-game & post-Serena battle
#execute as @s[x=1179,y=110,z=-276,r=20,tag=Dialogue162] run scoreboard players set @s[tag=!Dialogue163] DialogueTrigger 163

#tp Sycamore in
execute as @s[scores={DialogueTrigger=163,TalkTime=1}] run tp @e[x=-504,y=195,z=1284,dy=3,type=pixelmon:npc_chatting] 1179 110 -276
execute as @s[scores={DialogueTrigger=163,TalkTime=1}] run particle cloud 1179 110 -276 2 2 2 1 100

tellraw @s[scores={DialogueTrigger=163,TalkTime=4}] {"text":"<Sycamore> Why, hello, "},{"selector":"@s"},{"text":"!"}]
tellraw @s[scores={DialogueTrigger=163,TalkTime=10}] {"text":"<Sycamore> Running around all over Kalos is actually rather tiring, is it not?"}]
tellraw @s[scores={DialogueTrigger=163,TalkTime=17}] {"text":"<Sycamore> Oh yeah, I'm the one making you do that, aren't I? Terribly sorry about that!"}]
tellraw @s[scores={DialogueTrigger=163,TalkTime=25}] {"text":"<Sycamore> Well, Serena may have already told you, but I found a way to power up the Mega Ring!"}]
tellraw @s[scores={DialogueTrigger=163,TalkTime=34}] {"text":"<Sycamore> Before we get to that, however..."}]
tellraw @s[scores={DialogueTrigger=163,TalkTime=41}] {"text":"<Sycamore> Let's talk about Mega Stones briefly."}]
tellraw @s[scores={DialogueTrigger=163,TalkTime=47}] {"text":"<Sycamore> My theory is that they're special stones irradiated by the light--"}]
tellraw @s[scores={DialogueTrigger=163,TalkTime=54,Xerneas=1..}] {"text":"<Sycamore> the energy of the Legendary Pokémon Xerneas--fired from the ultimate weapon 3,000 years ago."}]
tellraw @s[scores={DialogueTrigger=163,TalkTime=54,Yveltal=1..}] {"text":"<Sycamore> the energy of the Legendary Pokémon Yveltal--fired from the ultimate weapon 3,000 years ago."}]
tellraw @s[scores={DialogueTrigger=163,TalkTime=64}] {"text":"<Sycamore> And that's what I think they are."}]
tellraw @s[scores={DialogueTrigger=163,TalkTime=72}] {"text":"<Sycamore> It's even possible that stones like Fire Stones were what turned into these Mega Stones."}]
tellraw @s[scores={DialogueTrigger=163,TalkTime=81}] {"text":"<Sycamore> So, what's the Mega Ring that you are holding?"}]
tellraw @s[scores={DialogueTrigger=163,TalkTime=88}] {"text":"<Sycamore> That mysterious stone transforms feelings felt toward Pokémon into some kind of wavelength."}]
tellraw @s[scores={DialogueTrigger=163,TalkTime=97}] {"text":"<Sycamore> The Mega Ring works in a similar way to how this object over here works."}]
tellraw @s[scores={DialogueTrigger=163,TalkTime=105}] {"text":"<Sycamore> It's an object that changes sunlight into a mysterious light."}]
tellraw @s[scores={DialogueTrigger=163,TalkTime=112}] {"text":"<Sycamore> During the sunset, this sundial starts emitting light."}]
tellraw @s[scores={DialogueTrigger=163,TalkTime=120}] {"text":"<Sycamore> This mysterious object has towered over the city here for over 3,000 years."}]
tellraw @s[scores={DialogueTrigger=163,TalkTime=128}] {"text":"<Sycamore> It's relationship to the Mega Ring isn't understood at all yet."}]
tellraw @s[scores={DialogueTrigger=163,TalkTime=136}] {"text":"<Sycamore> Now, let's get down to the heart of the matter!"}]
tellraw @s[scores={DialogueTrigger=163,TalkTime=143}] {"text":"<Sycamore> "},{"selector":"@s"},{"text":"! Try touching the sundial!"}]
#some kind of sun-ray sound effect

tellraw @s[scores={DialogueTrigger=163,TalkTime=150}] {"text":"<Sycamore> You were exposed to the Legendary Pokémon's energy in Team Flare's secret HQ."}]
tellraw @s[scores={DialogueTrigger=163,TalkTime=159}] {"text":"<Sycamore> And the Mega Ring has absorbed the power of the sundial."}]
tellraw @s[scores={DialogueTrigger=163,TalkTime=166}] {"text":"<Sycamore> These two powers have combined to upgrade your Mega Ring."}]
tellraw @s[scores={DialogueTrigger=163,TalkTime=174}] {"text":"<Sycamore> Now, it will react to underground Mega Stones, but only when the sundial is emitting light."}]
tellraw @s[scores={DialogueTrigger=163,TalkTime=184}] {"text":"<Sycamore> I'm sure these stones hide in every corner of Kalos! Use this power to find them!"}]

#tp Sycamore out
execute as @s[scores={DialogueTrigger=163,TalkTime=194}] run particle cloud 1179 110 -276 2 2 2 1 100
execute as @s[scores={DialogueTrigger=163,TalkTime=194}] run tp @e[x=1179,y=109,z=-276,dy=3,type=pixelmon:npc_chatting] -504 196 1284

