#----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
#Lysandre's Labs Lysandre post-battle
#/tedit add LOSS /scoreboard players set @pl DialogueTrigger 109
#/tedit add LOSS /scoreboard players set @pl TalkTime 0
#execute as @s[x=-304,y=140,z=388,dx=16,dy=5,dz=12,tag=!Dialogue109,score_TalkTime=0] run execute as @s[tag=Dialogue108] run tp @e[x=-504,y=230,z=1268,dy=3,type=pixelmon:npc_trainer] -296 141 393

#Lose dialogue:
#Excellent! I can feel the fire of your convictions burning deep within your heart!

tellraw @s[scores={DialogueTrigger=109,TalkTime=6}] ["",{"text":"<"},{"text":"Lysandre","color":"dark_red"},{"text":"> Wah ha ha! Your convictions, and those of your Pokémon, please me!"}]
tellraw @s[scores={DialogueTrigger=109,TalkTime=14}] ["",{"text":"<"},{"text":"Lysandre","color":"dark_red"},{"text":"> You are here to stop me. But I ask you to wait."}]
tellraw @s[scores={DialogueTrigger=109,TalkTime=22}] ["",{"text":"<"},{"text":"Lysandre","color":"dark_red"},{"text":"> I tried to save people--and the world--with the profit from this lab."}]
tellraw @s[scores={DialogueTrigger=109,TalkTime=32}] ["",{"text":"<"},{"text":"Lysandre","color":"dark_red"},{"text":"> But my efforts had no effect..."}]
tellraw @s[scores={DialogueTrigger=109,TalkTime=40}] ["",{"text":"<"},{"text":"Lysandre","color":"dark_red"},{"text":"> The world was just too vast...and too full of fools that I couldn't save through my hard work alone..."}]
tellraw @s[scores={DialogueTrigger=109,TalkTime=50}] ["",{"text":"<"},{"text":"Lysandre","color":"dark_red"},{"text":"> That's why I decided the only way to save the world was to take it all for myself."}]
tellraw @s[scores={DialogueTrigger=109,TalkTime=59}] ["",{"text":"<"},{"text":"Lysandre","color":"dark_red"},{"text":"> I don't expect that I will ever make you understand how I think and feel..."}]
tellraw @s[scores={DialogueTrigger=109,TalkTime=68}] ["",{"text":"<"},{"text":"Lysandre","color":"dark_red"},{"text":"> Try to stop the ultimate weapon if you must, but to do so,"}]
tellraw @s[scores={DialogueTrigger=109,TalkTime=76}] ["",{"text":"<"},{"text":"Lysandre","color":"dark_red"},{"text":"> you will have to explore our lab and have Pokémon battles with all you meet."}]
tellraw @s[scores={DialogueTrigger=109,TalkTime=85}] ["",{"text":"<"},{"text":"Lysandre","color":"dark_red"},{"text":"> Oh, and as for the Elevator Key, one of the Team Flare Scientists you've met on your journey has it."}]
tellraw @s[scores={DialogueTrigger=109,TalkTime=96}] ["",{"text":"<"},{"text":"Lysandre","color":"dark_red"},{"text":"> Saving everything... The world is suffering because of this absurd dream..."}]

