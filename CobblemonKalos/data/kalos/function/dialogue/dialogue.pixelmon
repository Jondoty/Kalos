tellraw @s[scores={DialogueTrigger=189,TalkTime=54}] [<Looker> Wha--?! What is that woman?! She's no Pokémon, yet she can use Transform?"}]
tellraw @s[scores={DialogueTrigger=189,TalkTime=63}] [<Looker> Oh, what am I doing? This is not a time to stand around being shocked!"}]
tellraw @s[scores={DialogueTrigger=189,TalkTime=72}] [<Looker> In fact, this is a time to dash off in pursuit! The chase is on!"}]
tellraw @s[scores={DialogueTrigger=189,TalkTime=81}] [<Looker> Now, considering the direction in which she ran, and the angle...hm..."}]
tellraw @s[scores={DialogueTrigger=189,TalkTime=91}] [<Looker> "},{"selector":"@s"},{"text":", my brave friend! I suspect she is headed for the alley between the office and Hibernal Avenue!"}]
tellraw @s[scores={DialogueTrigger=189,TalkTime=103}] [<Looker> Please go ahead without me!"}]
tellraw @s[scores={DialogueTrigger=189,TalkTime=110}] [<Looker> I will be right behind you, just as soon as I have checked this place for clues!"}]
tellraw @s[scores={DialogueTrigger=189,TalkTime=120}] [<Looker> But wait! One minute of your time! The great Looker will restore your Pokémon before you go!"}]
