tellraw @s[scores={DialogueTrigger=208,TalkTime=10}] ["",{"text":"<"},{"text":"Punk Guy","color":"aqua"},{"text":"> Ermh... So there's just Poké Balls an' papers, like?"}]
tellraw @s[scores={DialogueTrigger=208,TalkTime=17}] ["",{"text":"<"},{"text":"Punk Guy","color":"aqua"},{"text":"> Those Poké Balls got to belong to somebody, stands to reason."}]
tellraw @s[scores={DialogueTrigger=208,TalkTime=25}] ["",{"text":"<"},{"text":"Punk Guy","color":"aqua"},{"text":"> I promised Mr. Looker, an' what's more, I meant it."}]
tellraw @s[scores={DialogueTrigger=208,TalkTime=33}] ["",{"text":"<"},{"text":"Punk Guy","color":"aqua"},{"text":"> I won't never take Poké Balls that aren't mine!"}]

