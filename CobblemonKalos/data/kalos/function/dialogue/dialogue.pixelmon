#----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
#Team Flare Mable pre-battle
#scoreboard players set @a[x=-225,y=140,z=348,dx=17,dy=10,dz=10,tag=!Dialogue114] DialogueTrigger 114

execute as @s[scores={DialogueTrigger=114,TalkTime=1}] run scoreboard players set @s click 1
tellraw @s[scores={DialogueTrigger=114,TalkTime=2}] ["",{"text":"<"},{"text":"Team Flare Mable","color":"dark_aqua"},{"text":"> Oh, oh, oh, oh? You're that kid from the Frost Cavern... On your lonesome this time?"}]
tellraw @s[scores={DialogueTrigger=114,TalkTime=12}] ["",{"text":"<"},{"text":"Team Flare Mable","color":"dark_aqua"},{"text":"> We gather data about all the Trainers in the region through the Holo Caster, so we know all about you guys."}]
tellraw @s[scores={DialogueTrigger=114,TalkTime=22}] ["",{"text":"<"},{"text":"Team Flare Mable","color":"dark_aqua"},{"text":"> And you know how the Mega Ring is used to awaken a Pokémon's power, right?"}]
tellraw @s[scores={DialogueTrigger=114,TalkTime=32}] ["",{"text":"<"},{"text":"Team Flare Mable","color":"dark_aqua"},{"text":"> Just like how the ultimate weapon can max out a Pokémon's power."}]
tellraw @s[scores={DialogueTrigger=114,TalkTime=41}] ["",{"text":"<"},{"text":"Team Flare Mable","color":"dark_aqua"},{"text":"> Heheh... Looks like you and me are practically after the same thing, yeah?"}]

