tellraw @s[scores={DialogueTrigger=217,TalkTime=617}] ["",{"text":"<"},{"text":"Emma","color":"gold"},{"text":"> Hey, Mimi?"}]
tellraw @s[scores={DialogueTrigger=217,TalkTime=624}] ["",{"text":"<"},{"text":"Emma","color":"gold"},{"text":"> You know, we've made a lot of really good friends since we left the alleys..."}]
tellraw @s[scores={DialogueTrigger=217,TalkTime=635}] ["",{"text":"<"},{"text":"Emma","color":"gold"},{"text":"> "},{"selector":"@s"},{"text":" and Mr. Looker... And Dr. Xerosic, too..."}]
tellraw @s[scores={DialogueTrigger=217,TalkTime=645}] ["",{"text":"<"},{"text":"Mimi","color":"light_purple"},{"text":"> Mrawr! Mrawwwr!"}]
execute as @s[scores={DialogueTrigger=217,TalkTime=645}] run playsound espurr hostile @s ~ ~ ~ 100 1 1
tellraw @s[scores={DialogueTrigger=217,TalkTime=651}] ["",{"text":"<"},{"text":"Emma","color":"gold"},{"text":"> Mimi... Those two old guys really did everything for us..."}]
tellraw @s[scores={DialogueTrigger=217,TalkTime=660}] ["",{"text":"<"},{"text":"Emma","color":"gold"},{"text":"> Do you think that's what it's like...to have a father?"}]
tellraw @s[scores={DialogueTrigger=217,TalkTime=670}] ["",{"text":"<"},{"text":"Mimi","color":"light_purple"},{"text":"> Mrawr?"}]
execute as @s[scores={DialogueTrigger=217,TalkTime=670}] run playsound espurr hostile @s ~ ~ ~ 100 1 1
tellraw @s[scores={DialogueTrigger=217,TalkTime=676}] ["",{"text":"<"},{"text":"Emma","color":"gold"},{"text":"> Hehehe... Nothing. Never mind."}]
tellraw @s[scores={DialogueTrigger=217,TalkTime=683}] ["",{"text":"<"},{"text":"Emma","color":"gold"},{"text":"> Of course you wouldn't know any better than me, Mimi."}]
tellraw @s[scores={DialogueTrigger=217,TalkTime=691}] ["",{"text":"<"},{"text":"Emma","color":"gold"},{"text":"> But...I'm still glad. I'm glad we got to meet them."}]
tellraw @s[scores={DialogueTrigger=217,TalkTime=700}] ["",{"text":"<"},{"text":"Mimi","color":"light_purple"},{"text":"> Mrrrrrrawr!"}]
