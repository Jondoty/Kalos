tellraw @s[scores={DialogueTrigger=213,TalkTime=12}] [<Looker> There are no more Poké Balls! You must stop fighting!! EMMA!!!"}]
tellraw @s[scores={DialogueTrigger=213,TalkTime=22}] ["",{"text":"<"},{"text":"Essentia","color":"gold"},{"text":"> ... ... ..."}]
tellraw @s[scores={DialogueTrigger=213,TalkTime=26}] ["",{"text":"<"},{"text":"Essentia","color":"gold"},{"text":"> GRAAAUUUGGGHHH! AUUUGGGHHH!!"}]
tellraw @s[scores={DialogueTrigger=213,TalkTime=33}] [<Looker> No... Emma! What can I do?!"}]
tellraw @s[scores={DialogueTrigger=213,TalkTime=40}] {"text":"<Team Flare Xerosic> ... ... ..."}
tellraw @s[scores={DialogueTrigger=213,TalkTime=46}] ["",{"text":"<"},{"text":"Essentia","color":"gold"},{"text":"> AAAUUUGGGHHHHH!!"}]
tellraw @s[scores={DialogueTrigger=213,TalkTime=53}] {"text":"<Team Flare Xerosic> Remote control... Power down. Deactivate."}
tellraw @s[scores={DialogueTrigger=213,TalkTime=60}] ["",{"text":"<"},{"text":"Essentia","color":"gold"},{"text":"> GAAAHHH!!"}]
tellraw @s[scores={DialogueTrigger=213,TalkTime=66}] ["",{"text":"<"},{"text":"Essentia","color":"gold"},{"text":"> ... ... ..."}]
tellraw @s[scores={DialogueTrigger=213,TalkTime=73}] [<Looker> E-Emma!! Are you all right?!"}]
tellraw @s[scores={DialogueTrigger=213,TalkTime=80}] ["",{"text":"<"},{"text":"Essentia","color":"gold"},{"text":"> ... ... ..."}]
tellraw @s[scores={DialogueTrigger=213,TalkTime=86}] {"text":"<Team Flare Xerosic> All I did was turn off the remote-control capability."}
tellraw @s[scores={DialogueTrigger=213,TalkTime=95}] {"text":"<Team Flare Xerosic> There was never any danger to the girl."}
tellraw @s[scores={DialogueTrigger=213,TalkTime=103}] [<Looker> What?!"}]
tellraw @s[scores={DialogueTrigger=213,TalkTime=110}] ["",{"text":"<"},{"text":"Emma","color":"yellow"},{"text":"> Mmh... Mmm..."}]
execute as @s[scores={DialogueTrigger=213,TalkTime=113}] run data modify entity @e[limit=1,x=-295,y=31,z=297,dy=3] {Rotation:[45.0f,0.0f]}
tellraw @s[scores={DialogueTrigger=213,TalkTime=116}] ["",{"text":"<"},{"text":"Emma","color":"yellow"},{"text":"> Yawwwn! Hm?"}]
tellraw @s[scores={DialogueTrigger=213,TalkTime=122}] ["",{"text":"<"},{"text":"Emma","color":"yellow"},{"text":"> Oh, Dr. Xerosic..."}]
tellraw @s[scores={DialogueTrigger=213,TalkTime=130}] ["",{"text":"<"},{"text":"Emma","color":"yellow"},{"text":"> Are we all done for today?"}]
tellraw @s[scores={DialogueTrigger=213,TalkTime=138}] {"text":"<Team Flare Xerosic> Yes, my girl... We're done..."}
tellraw @s[scores={DialogueTrigger=213,TalkTime=146}] {"text":"<Team Flare Xerosic> You did a good job, Emma."}
tellraw @s[scores={DialogueTrigger=213,TalkTime=154}] {"text":"<Team Flare Xerosic> The trials are now complete. I'm afraid your job is all over."}
tellraw @s[scores={DialogueTrigger=213,TalkTime=164}] ["",{"text":"<"},{"text":"Emma","color":"yellow"},{"text":"> Yawwwn! Oh, really? Then I guess I've got to start looking for a new job again."}]
execute as @s[scores={DialogueTrigger=213,TalkTime=172}] run data modify entity @e[limit=1,x=-295,y=31,z=297,dy=3] {Rotation:[180.0f,0.0f]}
tellraw @s[scores={DialogueTrigger=213,TalkTime=175}] ["",{"text":"<"},{"text":"Emma","color":"yellow"},{"text":"> Huh? Wait? Why is everyone here?"}]
tellraw @s[scores={DialogueTrigger=213,TalkTime=184}] ["",{"text":"<"},{"text":"Emma","color":"yellow"},{"text":"> I thought it was a secret that I was working here!"}]
tellraw @s[scores={DialogueTrigger=213,TalkTime=193}] [<Looker> E-Emma... Are you...all right?"}]
tellraw @s[scores={DialogueTrigger=213,TalkTime=200}] ["",{"text":"<"},{"text":"Emma","color":"yellow"},{"text":"> Hm? What do you mean? I've just been taking a nap."}]
tellraw @s[scores={DialogueTrigger=213,TalkTime=209}] ["",{"text":"<"},{"text":"Emma","color":"yellow"},{"text":"> My job here was really easy. All I had to do was wear this suit while I snoozed away."}]
tellraw @s[scores={DialogueTrigger=213,TalkTime=220}] ["",{"text":"<"},{"text":"Emma","color":"yellow"},{"text":"> What are you doing here, Mr. Looker? I thought you were in the hospital!"}]
tellraw @s[scores={DialogueTrigger=213,TalkTime=230}] [<Looker> Uh... Ahem. N-no... You see..."}]
tellraw @s[scores={DialogueTrigger=213,TalkTime=239}] [<Looker> I got, uh, special permission to check myself out of the...hospital..."}]
tellraw @s[scores={DialogueTrigger=213,TalkTime=249}] [<Looker> I had to make sure you were OK, Emma."}]
tellraw @s[scores={DialogueTrigger=213,TalkTime=257}] [<Looker> I had to see you, so I found out where you worked and came to find you."}]
tellraw @s[scores={DialogueTrigger=213,TalkTime=267}] ["",{"text":"<"},{"text":"Emma","color":"yellow"},{"text":"> Oh, I see. I was afraid you might be mad because I started working without telling you."}]
tellraw @s[scores={DialogueTrigger=213,TalkTime=279}] ["",{"text":"<"},{"text":"Emma","color":"yellow"},{"text":"> I kept it a secret all this time..."}]
tellraw @s[scores={DialogueTrigger=213,TalkTime=287}] ["",{"text":"<"},{"text":"Emma","color":"yellow"},{"text":"> You really are a great detective, aren't you, Mr. Looker? You found me anyway!"}]
tellraw @s[scores={DialogueTrigger=213,TalkTime=298}] [<Looker> Naturally! Now, Emma, how about you go and get some dinner?"}]
tellraw @s[scores={DialogueTrigger=213,TalkTime=307}] [<Looker> I need to have a little grown-up talk with Dr. Xerosic here!"}]
tellraw @s[scores={DialogueTrigger=213,TalkTime=315}] ["",{"text":"<"},{"text":"Emma","color":"yellow"},{"text":"> Oh, sure. No problem! We'll head out now!"}]
tellraw @s[scores={DialogueTrigger=213,TalkTime=324}] ["",{"text":"<"},{"text":"Emma","color":"yellow"},{"text":"> Let's all go together! Mimi! And you, too, "},{"selector":"@s"},{"text":"!"}]

