tellraw @s[scores={DialogueTrigger=32,TalkTime=190}] {"text":"<Palace Owner> Give it to them."}
tellraw @s[scores={DialogueTrigger=32,TalkTime=196}] ["",{"text":"<"},{"text":"Butler","color":"gray"},{"text":"> Here is the Poké Flute."}]
