#Hotel Guests Madame
#Dialogue224

tellraw @s[scores={DialogueTrigger=224,TalkTime=1,TrainerLoot107=1}] {"text":"<Madame> Aren't there any hot springs around here? Where I come from, we have a hot spring right next to the Pokémon Center, and it's incredible!"}

tellraw @s[scores={DialogueTrigger=224,TalkTime=1,TrainerLoot107=2}] {"text":"<Madame> Where I'm from, we put Pokémon Eggs in sand baths."}

tellraw @s[scores={DialogueTrigger=224,TalkTime=1,TrainerLoot107=3}] {"text":"<Madame> Riding the monorail here reminded me of taking the cable car on Mt. Chimney!"}

tellraw @s[scores={DialogueTrigger=224,TalkTime=1,TrainerLoot107=4}] {"text":"<Madame> Here--I'll share some with you!"}
