tellraw @s[scores={DialogueTrigger=234,TalkTime=12}] ["",{"text":"<"},{"text":"Nita","color":"yellow"},{"text":"> It's been a long time, Trainer! You haven't forgotten me, right?"}]
tellraw @s[scores={DialogueTrigger=234,TalkTime=21}] ["",{"text":"<"},{"text":"Nita","color":"yellow"},{"text":"> I might go mental if you say you did, with how I've been waiting!"}]
