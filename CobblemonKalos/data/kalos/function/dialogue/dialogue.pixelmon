#Xerosic's Notes #2 (-289 32 295)
#/tedit add INTERACT /scoreboard players set @pl TalkTrigger 201
#execute as @s[score_TalkTrigger_min=201,score_TalkTrigger=201,score_TalkTime=0] run scoreboard players set @s DialogueTrigger 203

tellraw @s[scores={DialogueTrigger=203,TalkTime=1}] {"text":"Expansion Suit Field Trials Secret Records: Volume 1","italic":true}
tellraw @s[scores={DialogueTrigger=203,TalkTime=10}] {"text":"The XXth day of the XXth month...","italic":true}
tellraw @s[scores={DialogueTrigger=203,TalkTime=17}] {"text":"Posted an advertisement for part-time work at the Lysandre Café to recruit a test subject for the suit's field trials.","italic":true}
tellraw @s[scores={DialogueTrigger=203,TalkTime=29}] {"text":"The Expansion Suit should make even an average Trainer into a superhuman force, a force to be reckoned with...","italic":true}
tellraw @s[scores={DialogueTrigger=203,TalkTime=39}] {"text":"It is the ultimate result of my life's study-- my magnum opus.","italic":true}
tellraw @s[scores={DialogueTrigger=203,TalkTime=47}] {"text":"The trials must be a success! I wait on the appearance of a young, healthy, and ambitious test subject.","italic":true}

tag @s[scores={DialogueTrigger=203,TalkTime=47..}] add Dialogue203
scoreboard players set @s[tag=Dialogue203] TalkTime 0
scoreboard players set @s[tag=Dialogue203] DialogueTrigger 0

#----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
#https://youtu.be/azyrTT_H1E8?t=1272
#Xerosic's Notes #3 (-290 32 301)
#/tedit add INTERACT /scoreboard players set @pl TalkTrigger 202
#execute as @s[score_TalkTrigger_min=202,score_TalkTrigger=202,score_TalkTime=0] run scoreboard players set @s DialogueTrigger 204

tellraw @s[scores={DialogueTrigger=204,TalkTime=1}] {"text":"Expansion Suit Field Trials Secret Records: Volume 2","italic":true}
tellraw @s[scores={DialogueTrigger=204,TalkTime=10}] {"text":"The XXth day of the XXth month...","italic":true}
tellraw @s[scores={DialogueTrigger=204,TalkTime=17}] {"text":"At long last, a response came to my advertisement for part-time work.","italic":true}
tellraw @s[scores={DialogueTrigger=204,TalkTime=25}] {"text":"The subject's name is Emma. She is a healthy girl, 16 years of age.","italic":true}
tellraw @s[scores={DialogueTrigger=204,TalkTime=33}] {"text":"When I attempted to explain the intent of my research, she gave little sign of understanding.","italic":true}
tellraw @s[scores={DialogueTrigger=204,TalkTime=42}] {"text":"She does appear to understand the passion I have put into the suit research,","italic":true}
tellraw @s[scores={DialogueTrigger=204,TalkTime=50}] {"text":"and she showed interest in continuing with the trials.","italic":true}
tellraw @s[scores={DialogueTrigger=204,TalkTime=57}] {"text":"Now that Team Flare has been disbanded, my funds are running severely low.","italic":true}
tellraw @s[scores={DialogueTrigger=204,TalkTime=66}] {"text":"I hired her on the spot. The trials must proceed with no time lost.","italic":true}
tellraw @s[scores={DialogueTrigger=204,TalkTime=74}] {"text":"First, I'll measure Emma's physical and mental abilities to ensure she can complete the trials.","italic":true}
tellraw @s[scores={DialogueTrigger=204,TalkTime=84}] {"text":"The XXth day of the XXth month... I have customized the suit to better fit Emma's frame.","italic":true}
tellraw @s[scores={DialogueTrigger=204,TalkTime=94}] {"text":"The XXth day of the XXth month... ","italic":true}
tellraw @s[scores={DialogueTrigger=204,TalkTime=102}] {"text":"I have designated the code name Essentia to be used when Emma is wearing the Expansion Suit.","italic":true}

tag @s[scores={DialogueTrigger=204,TalkTime=102..}] add Dialogue204
scoreboard players set @s[tag=Dialogue204] TalkTime 0
scoreboard players set @s[tag=Dialogue204] DialogueTrigger 0

