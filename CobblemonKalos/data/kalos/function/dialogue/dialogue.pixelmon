tellraw @s[scores={DialogueTrigger=182,TalkTime=343}] ["",{"text":"<"},{"text":"Emma","color":"yellow"},{"text":"> \u3046\u3093\u2026\u2026 \u307e\u3042\u306d\u2026\u2026"}]
tellraw @s[scores={DialogueTrigger=182,TalkTime=351}] ["",{"text":"<"},{"text":"Emma","color":"yellow"},{"text":"> \u3060\u3044\u305f\u3044\u3067 \u306a\u3093\u3068\u306a\u304f \u3060\u3051\u3069 \u3053\u306e\u307e\u3061"}]
tellraw @s[scores={DialogueTrigger=182,TalkTime=360}] ["",{"text":"<"},{"text":"Emma","color":"yellow"},{"text":"> \u3063\u3066 \u304a\u305d\u3068\u306b \u3044\u308b\u3068 \u3044\u308d\u3093\u306a \u304f\u306b\u306e \u3053\u3068\u3070\u3067 \u304a\u306f\u306a\u3057 \u3057\u3066\u308b\u306e\u304c \u304d\u3053\u3048\u308b\u304b\u3089 \u3044\u3064\u306e\u307e\u306b\u304b \u304a\u307c\u3048\u3061\u3083\u3063\u305f\u306e"}]
tellraw @s[scores={DialogueTrigger=182,TalkTime=370}] ["",{"text":"<"},{"text":"Emma","color":"yellow"},{"text":"> Hmm... If we keep going like this, then "},{"selector":"@s"},{"text":" is gonna be totally lost..."}]
tellraw @s[scores={DialogueTrigger=182,TalkTime=380}] ["",{"text":"<"},{"text":"Emma","color":"yellow"},{"text":"> And I don't feel like opening up the trash talk with this old lady again..."}]
tellraw @s[scores={DialogueTrigger=182,TalkTime=388}] ["",{"text":"<"},{"text":"Emma","color":"yellow"},{"text":"> Hey, Mimi! How about it? Do you think you can help us out with your power?"}]
tellraw @s[scores={DialogueTrigger=182,TalkTime=396}] ["",{"text":"<"},{"text":"Mimi","color":"light_purple"},{"text":"> Mrrrawwwr!"}]
