tellraw @s[scores={DialogueTrigger=213,TalkTime=378}] [<Looker> Ahem. Let us get down to it."}]
tellraw @s[scores={DialogueTrigger=213,TalkTime=386}] [<Looker> I would like to straighten this out before Emma returns."}]
tellraw @s[scores={DialogueTrigger=213,TalkTime=394}] [<Looker> Dr. Xerosic, could you please confirm one small thing for me?"}]
tellraw @s[scores={DialogueTrigger=213,TalkTime=402}] [<Looker> The criminal mastermind behind all these incidents was--you yourself?"}]
tellraw @s[scores={DialogueTrigger=213,TalkTime=412}] {"text":"<Team Flare Xerosic> Oho. Right enough. The graffiti in the art museum and the theft of the Trainers' Poké Balls?"}
tellraw @s[scores={DialogueTrigger=213,TalkTime=423}] {"text":"<Team Flare Xerosic> All me, controlling Essentia remotely with the Expansion Suit!"}
tellraw @s[scores={DialogueTrigger=213,TalkTime=431}] {"text":"<Team Flare Xerosic> Emma was clinically unconscious in the suit."}
tellraw @s[scores={DialogueTrigger=213,TalkTime=439}] {"text":"<Team Flare Xerosic> Her mind had no clue what her body was doing."}
tellraw @s[scores={DialogueTrigger=213,TalkTime=447}] {"text":"<Team Flare Xerosic> She has zero responsibility for any of the crimes. You need not doubt her."}
tellraw @s[scores={DialogueTrigger=213,TalkTime=457}] [<Looker> That's how it is?"}]
tellraw @s[scores={DialogueTrigger=213,TalkTime=464}] {"text":"<Team Flare Xerosic> If you're apprehending anyone, it should be me alone."}
tellraw @s[scores={DialogueTrigger=213,TalkTime=472}] [<Looker> Ahem. For a minute, let's say I believe your statements--"}]
tellraw @s[scores={DialogueTrigger=213,TalkTime=481}] {"text":"<Team Flare Xerosic> You had better believe it. Emma is a fine person."}
tellraw @s[scores={DialogueTrigger=213,TalkTime=499}] {"text":"<Team Flare Xerosic> She may be a bit foolish, but she's strong and clear in purpose."}
tellraw @s[scores={DialogueTrigger=213,TalkTime=509}] {"text":"<Team Flare Xerosic> Yes, clarity... It is required when one dedicates oneself to a single pursuit."}
tellraw @s[scores={DialogueTrigger=213,TalkTime=519}] {"text":"<Team Flare Xerosic> Clarity of heart and of purpose is needed if work such as my research is to succeed."}
tellraw @s[scores={DialogueTrigger=213,TalkTime=529}] {"text":"<Team Flare Xerosic> The Expansion Suit that I dreamed of could have only been created thanks to the clear dedication of that girl's heart."}
tellraw @s[scores={DialogueTrigger=213,TalkTime=541}] {"text":"<Team Flare Xerosic> When you add that all up, it means..."}
tellraw @s[scores={DialogueTrigger=213,TalkTime=548}] {"text":"<Team Flare Xerosic> That I have no regrets. Take me away, Officer."}
tellraw @s[scores={DialogueTrigger=213,TalkTime=556}] [<Looker> I hear you. Once I have everything in order, I will ask you to accompany me to the station."}]
tellraw @s[scores={DialogueTrigger=213,TalkTime=568}] [<Looker> And that is all I have to say to you as Looker of the International Police."}]
tellraw @s[scores={DialogueTrigger=213,TalkTime=578}] [<Looker> What I say to you now, I say as simply Mr. Looker, young Emma's guardian..."}]
tellraw @s[scores={DialogueTrigger=213,TalkTime=588}] {"text":"<Team Flare Xerosic> Hm?"}
tellraw @s[scores={DialogueTrigger=213,TalkTime=594}] [<Looker> Would you care to stay and visit a while longer with Emma and me?"}]
tellraw @s[scores={DialogueTrigger=213,TalkTime=603}] [<Looker> She seems to have grown quite fond of you, you know."}]
tellraw @s[scores={DialogueTrigger=213,TalkTime=611}] [<Looker> We are about to have dinner together, and she was hoping you would join us."}]
tellraw @s[scores={DialogueTrigger=213,TalkTime=621}] [<Looker> Ahem... I would like to wait until tomorrow,"}]
tellraw @s[scores={DialogueTrigger=213,TalkTime=629}] [<Looker> after she has enjoyed a last cheerful night, before I must tell her the truth."}]
tellraw @s[scores={DialogueTrigger=213,TalkTime=639}] {"text":"<Team Flare Xerosic> ... ... ..."}
tellraw @s[scores={DialogueTrigger=213,TalkTime=646}] [<Looker> Dr. Xerosic..."}]
tellraw @s[scores={DialogueTrigger=213,TalkTime=653}] {"text":"<Team Flare Xerosic> ... ... ..."}
tellraw @s[scores={DialogueTrigger=213,TalkTime=660}] {"text":"<Team Flare Xerosic> ... ... ... Looker--or whatever your name truly is--"}
tellraw @s[scores={DialogueTrigger=213,TalkTime=668}] {"text":"<Team Flare Xerosic> your soft words are unexpected... But not unappreciated. Th-thanks."}

