tellraw @s[scores={DialogueTrigger=132,TalkTime=15}] {"text":"<Shauna> You're amazing, "},{"selector":"@s"},{"text":"!"}]
tellraw @s[scores={DialogueTrigger=132,TalkTime=23}] {"text":"<Shauna> A Legendary Pokémon wanting to be your friend like that! It's unbelievable!"}]
