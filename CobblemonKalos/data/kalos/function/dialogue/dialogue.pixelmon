#execute as @s[x=1103,y=105,z=2007,r=50,score_TalkTime=0,tag=!Dialogue183] run tp @e[x=-504,y=235,z=1286,dy=3,type=pixelmon:npc_chatting] 1124 105 2003
#execute as @s[x=1103,y=105,z=2007,r=50,score_TalkTime=0,tag=!Dialogue183] run tp @e[x=-504,y=235,z=1288,dy=3,type=pixelmon:npc_chatting] 1130 105 2009
#execute as @s[x=1103,y=105,z=2007,r=50,score_TalkTime=0,tag=!Dialogue183] run tp @e[x=-504,y=235,z=1290,dy=3,type=pixelmon:npc_chatting] 1131 105 2005

tellraw @s[scores={DialogueTrigger=183,TalkTime=1}] ["",{"text":"<"},{"text":"Punk Girl","color":"light_purple"},{"text":"> Hey, hey, hey! Wotcher doin' here, old man?"}]
tellraw @s[scores={DialogueTrigger=183,TalkTime=10}] ["",{"text":"<"},{"text":"Punk Girl","color":"light_purple"},{"text":"> You wander in here by mistake or what?"}]
tellraw @s[scores={DialogueTrigger=183,TalkTime=17}] ["",{"text":"<"},{"text":"Punk Girl","color":"light_purple"},{"text":"> 'Cause you'd hafter be off yer trolley to come alone an' pick a fight with us."}]
tellraw @s[scores={DialogueTrigger=183,TalkTime=27}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> Indeed. Hold that thought."}]
tellraw @s[scores={DialogueTrigger=183,TalkTime=33}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> I am not here to pick a fight. Instead, I have a simple request."}]
tellraw @s[scores={DialogueTrigger=183,TalkTime=40}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> Return that tourist's stolen Pokémon!"}]
tellraw @s[scores={DialogueTrigger=183,TalkTime=47}] ["",{"text":"<"},{"text":"Punk Girl","color":"light_purple"},{"text":"> Yer jokin', right?"}]
tellraw @s[scores={DialogueTrigger=183,TalkTime=54}] ["",{"text":"<"},{"text":"Punk Girl","color":"light_purple"},{"text":"> If we just give 'em back wit' a pretty please and thank-you, sir,"}]
tellraw @s[scores={DialogueTrigger=183,TalkTime=64}] ["",{"text":"<"},{"text":"Punk Girl","color":"light_purple"},{"text":"> why'd we bother stealin' sumfink?!"}]
tellraw @s[scores={DialogueTrigger=183,TalkTime=73}] {"text":"<Punk Girl> Lookee, old man... Yer that Looker whatsisface, eh?"}
tellraw @s[scores={DialogueTrigger=183,TalkTime=80}] {"text":"<Punk Girl> Who we are is the Lumiose Gang, and we can't stand the sight of you, got it?"}
tellraw @s[scores={DialogueTrigger=183,TalkTime=90}] {"text":"<Punk Girl> Ever since Emma went to live at yours, she ain't never come round to hang with us!"}
tellraw @s[scores={DialogueTrigger=183,TalkTime=100}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> What do you mean?"}]
tellraw @s[scores={DialogueTrigger=183,TalkTime=106}] ["",{"text":"<"},{"text":"Punk Guy","color":"aqua"},{"text":"> Y'hear me? It's just not on!"}]
tellraw @s[scores={DialogueTrigger=183,TalkTime=113}] ["",{"text":"<"},{"text":"Punk Guy","color":"aqua"},{"text":"> Why did we nab these lame Pokémon, did y'ask yerself?"}]
tellraw @s[scores={DialogueTrigger=183,TalkTime=121}] ["",{"text":"<"},{"text":"Punk Guy","color":"aqua"},{"text":"> It were just to get yer into our manor, weren't it? So yer done, old man!"}]
tellraw @s[scores={DialogueTrigger=183,TalkTime=131}] ["",{"text":"<"},{"text":"Punk Guy","color":"aqua"},{"text":"> Get yer Pokémon out for battle! If yer win, yer take the Pokémon!"}]
tellraw @s[scores={DialogueTrigger=183,TalkTime=139}] ["",{"text":"<"},{"text":"Punk Guy","color":"aqua"},{"text":"> But... If yer lose, yer got nothin' more to do with our Emma!"}]
tellraw @s[scores={DialogueTrigger=183,TalkTime=148}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> I cannot accept your challenge."}]
tellraw @s[scores={DialogueTrigger=183,TalkTime=155}] ["",{"text":"<"},{"text":"Punk Girl","color":"light_purple"},{"text":"> Oo-er! Yer too scared to fight?"}]
tellraw @s[scores={DialogueTrigger=183,TalkTime=162}] ["",{"text":"<"},{"text":"Punk Girl","color":"light_purple"},{"text":"> Or are yer givin' it that yer don't have even a single Pokémon to stand by yer?"}]
tellraw @s[scores={DialogueTrigger=183,TalkTime=173}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> You...er...\u201cgot it in one.\u201d"}]
tellraw @s[scores={DialogueTrigger=183,TalkTime=180}] {"text":"<Punk Girl> Nyahahaha! Yer not havin' us on?"}
tellraw @s[scores={DialogueTrigger=183,TalkTime=187}] {"text":"<Punk Girl> Fine, we'll give yer a shot to ready yerself!"}
tellraw @s[scores={DialogueTrigger=183,TalkTime=194}] {"text":"<Punk Girl> Go find some tall grass or somethin'... Then come back an' get yer hat handed to yer!"}
tellraw @s[scores={DialogueTrigger=183,TalkTime=203}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> Argh. Words are no use here."}]
tellraw @s[scores={DialogueTrigger=183,TalkTime=210}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> I'll have to go. Later, I'll return, and--"}]
tellraw @s[scores={DialogueTrigger=183,TalkTime=218}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> Oh! "},{"selector":"@s"},{"text":"!"}]
tellraw @s[scores={DialogueTrigger=183,TalkTime=225}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> Ahaha...ahem. You've caught me making an enormous fool of myself."}]
tellraw @s[scores={DialogueTrigger=183,TalkTime=233}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> It is as they say. The great Looker has no Pokémon of his own..."}]
tellraw @s[scores={DialogueTrigger=183,TalkTime=241}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> I can do nothing to restore the stolen Pokémon to that tourist..."}]
tellraw @s[scores={DialogueTrigger=183,TalkTime=250}] ["",{"text":"<"},{"text":"Punk Guy","color":"aqua"},{"text":"> Oi, mouth! Who are ya? Yer with this old man, eh?"}]
tellraw @s[scores={DialogueTrigger=183,TalkTime=258}] ["",{"text":"<"},{"text":"Punk Guy","color":"aqua"},{"text":"> Naw then. Yer can take his place, like. Yer win, an' we hand over the Pokémon."}]
tellraw @s[scores={DialogueTrigger=183,TalkTime=269}] ["",{"text":"<"},{"text":"Punk Guy","color":"aqua"},{"text":"> How do ya like yer chances, eh?! Nyahaha!"}]
tellraw @s[scores={DialogueTrigger=183,TalkTime=278}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> "},{"selector":"@s"},{"text":", my friend... I'm afraid this is all I can do for you."}]

