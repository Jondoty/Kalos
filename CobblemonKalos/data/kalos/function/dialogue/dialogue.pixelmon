tellraw @s[scores={DialogueTrigger=185,TalkTime=101}] [<Looker> Did you see that, "},{"selector":"@s"},{"text":"?! Where trouble goes, Looker must follow!"}]
tellraw @s[scores={DialogueTrigger=185,TalkTime=111}] [<Looker> I am on my way to the Lumiose Museum to begin my investigations! Most urgently!"}]
tellraw @s[scores={DialogueTrigger=185,TalkTime=121}] [<Looker> It is straight to the scene of the crime for us!"}]
tellraw @s[scores={DialogueTrigger=185,TalkTime=128}] [<Looker> ...Oh, wouldn't it be nice if that were true?"}]
