#tps Emma, Mimi and Looker in
#https://youtu.be/qEms9_nJ7M0?t=65030

tellraw @s[scores={DialogueTrigger=178,TalkTime=125}] ["",{"text":"<"},{"text":"...","color":"yellow"},{"text":"> Wow... So this is the Looker Bureau? It's sure warmer than the alley."}]
tellraw @s[scores={DialogueTrigger=178,TalkTime=134}] ["",{"text":"<"},{"text":"...","color":"yellow"},{"text":"> This is gonna be great, huh, Mimi?"}]
tellraw @s[scores={DialogueTrigger=178,TalkTime=141}] ["",{"text":"<"},{"text":"Mimi","color":"light_purple"},{"text":"> Murrr-mrrrawwr?"}]
execute as @s[scores={DialogueTrigger=178,TalkTime=141}] run playsound espurr hostile @s ~ ~ ~ 100 1 1
tellraw @s[scores={DialogueTrigger=178,TalkTime=146}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> Please, make yourself comfortable!"}]
tellraw @s[scores={DialogueTrigger=178,TalkTime=153}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> From today on, you will work here as my assistant!"}]
tellraw @s[scores={DialogueTrigger=178,TalkTime=161}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> And you may live here as long as you choose!"}]
tellraw @s[scores={DialogueTrigger=178,TalkTime=169}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> I seem to have forgotten my manners. Pardon me for not asking your name."}]
tellraw @s[scores={DialogueTrigger=178,TalkTime=179}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> What do you prefer to go by, or shall we stick with \u201cFriend-of-Mimi\u201d?"}]
tellraw @s[scores={DialogueTrigger=178,TalkTime=189}] ["",{"text":"<"},{"text":"Emma","color":"yellow"},{"text":"> Who, me? I'm just Emma."}]
tellraw @s[scores={DialogueTrigger=178,TalkTime=196}] ["",{"text":"<"},{"text":"Emma","color":"yellow"},{"text":"> Nice to meet you! \u266a"}]
tellraw @s[scores={DialogueTrigger=178,TalkTime=202}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> Emma, is it? Indeed, a pretty name!"}]
tellraw @s[scores={DialogueTrigger=178,TalkTime=209}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> Ahem. The case of the kids in the alleys is now closed."}]
tellraw @s[scores={DialogueTrigger=178,TalkTime=218}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> With Emma staying here instead, kids will stop making the alleys their second home!"}]
tellraw @s[scores={DialogueTrigger=178,TalkTime=229}] ["",{"text":"<"},{"text":"Looker","color":"gray"},{"text":"> "},{"selector":"@s"},{"text":", I will send a message on your Holo Caster the next time we get a case! I look forward to it indeed."}]

