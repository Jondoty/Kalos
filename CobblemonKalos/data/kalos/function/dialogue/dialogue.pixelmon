#Xerosic's Notes #5 (-285 29 313)
#/tedit add INTERACT /scoreboard players set @pl TalkTrigger 204
#execute as @s[score_TalkTrigger_min=204,score_TalkTrigger=204,score_TalkTime=0] run scoreboard players set @s DialogueTrigger 206

tellraw @s[scores={DialogueTrigger=206,TalkTime=1}] {"text":"Expansion Suit Field Trials Secret Records: Volume 4","italic":true}
tellraw @s[scores={DialogueTrigger=206,TalkTime=10}] {"text":"The XXth day of the XXth month... Finally, the trials are underway.","italic":true}
tellraw @s[scores={DialogueTrigger=206,TalkTime=18}] {"text":"The first trial is designed to test the suit's physical capabilities.","italic":true}
tellraw @s[scores={DialogueTrigger=206,TalkTime=26}] {"text":"Using the texturing function, the subject has infiltrated the closely guarded art museum and left an insignia on a historical mural.","italic":true}
tellraw @s[scores={DialogueTrigger=206,TalkTime=38}] {"text":"The remote-control function has worked without complications thus far.","italic":true}
tellraw @s[scores={DialogueTrigger=206,TalkTime=46}] {"text":"Emma shows no ill effects from her time in the suit. Her memory is blank.","italic":true}
tellraw @s[scores={DialogueTrigger=206,TalkTime=54}] {"text":"When questioned, she describes her experience as \u201ctaking a nap.\u201d","italic":true}
tellraw @s[scores={DialogueTrigger=206,TalkTime=62}] {"text":"Perhaps I will give her a bonus in celebration of this successful trial.","italic":true}

tag @s[scores={DialogueTrigger=206,TalkTime=62..}] add Dialogue206
scoreboard players set @s[tag=Dialogue206] TalkTime 0
scoreboard players set @s[tag=Dialogue206] DialogueTrigger 0

#----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
#https://youtu.be/azyrTT_H1E8?t=1316
#Xerosic's Notes #6 (-286 29 318)
#/tedit add INTERACT /scoreboard players set @pl TalkTrigger 205
#execute as @s[score_TalkTrigger_min=205,score_TalkTrigger=205,score_TalkTime=0] run scoreboard players set @s DialogueTrigger 207

tellraw @s[scores={DialogueTrigger=207,TalkTime=1}] {"text":"Expansion Suit Field Trials Secret Records: Volume 5","italic":true}
tellraw @s[scores={DialogueTrigger=207,TalkTime=10}] {"text":"The XXth day of the XXth month...","italic":true}
tellraw @s[scores={DialogueTrigger=207,TalkTime=17}] {"text":"Trials begin of a key part of the Expansion Suit: the hacking cable I've called the Poké Ball Jack.","italic":true}
tellraw @s[scores={DialogueTrigger=207,TalkTime=28}] {"text":"With the texturing function enabled, the subject battles Trainers around the city.","italic":true}
tellraw @s[scores={DialogueTrigger=207,TalkTime=37}] {"text":"She then collects the Poké Balls from Trainers she defeats, so that we may use them in our tests.","italic":true}
tellraw @s[scores={DialogueTrigger=207,TalkTime=47}] {"text":"The results of the tests have been quite favorable thus far.","italic":true}
tellraw @s[scores={DialogueTrigger=207,TalkTime=55}] {"text":"However, these trials have not been entirely free from incident.","italic":true}
tellraw @s[scores={DialogueTrigger=207,TalkTime=63}] {"text":"Some apparent acquaintances of Emma's are proving to be a hindrance to our progress.","italic":true}
tellraw @s[scores={DialogueTrigger=207,TalkTime=72}] {"text":"Among these acquaintances is a Trainer who appears to be the new Champion, but this is not yet confirmed.","italic":true}
tellraw @s[scores={DialogueTrigger=207,TalkTime=83}] {"text":"We encountered a glitch in the remote-control programming, and I lost control for a brief period.","italic":true}
tellraw @s[scores={DialogueTrigger=207,TalkTime=93}] {"text":"Fearing possible effects on Emma, I suspended the trials temporarily.","italic":true}
tellraw @s[scores={DialogueTrigger=207,TalkTime=100}] {"text":"When we returned to the secret base, I examined the girl for signs of damage, but she appeared to be unharmed.","italic":true}
tellraw @s[scores={DialogueTrigger=207,TalkTime=112}] {"text":"She still retains no memories from her intervals in the suit.","italic":true}
tellraw @s[scores={DialogueTrigger=207,TalkTime=120}] {"text":"The one thing she admitted was experiencing \u201ca frightful dream.\u201d","italic":true}

tag @s[scores={DialogueTrigger=207,TalkTime=120..}] add Dialogue207
scoreboard players set @s[tag=Dialogue207] TalkTime 0
scoreboard players set @s[tag=Dialogue207] DialogueTrigger 0

