tellraw @s[scores={DialogueTrigger=214,TalkTime=35}] {"text":"<Emma> Oh! Mimi, you're back! Come on, Mimi! You're part of the welcome party, too!"}]
tellraw @s[scores={DialogueTrigger=214,TalkTime=45}] {"text":"<Mimi> Mrawr! Murrr-rrrawr!"}]
execute as @s[scores={DialogueTrigger=214,TalkTime=45}] run playsound espurr hostile @s ~ ~ ~ 100 1 1
tellraw @s[scores={DialogueTrigger=214,TalkTime=51}] {"text":"<Emma> Huh? What's wrong with Mimi? I think it's holding something..."}]
tellraw @s[scores={DialogueTrigger=214,TalkTime=60}] {"text":"<Mimi> Mrrrawr!"}]
execute as @s[scores={DialogueTrigger=214,TalkTime=60}] run playsound espurr hostile @s ~ ~ ~ 100 1 1
execute as @s[scores={DialogueTrigger=214,TalkTime=63}] run replaceitem entity @e[x=-51,y=100,z=385,dy=3,type=pixelmon:npc_chatting] weapon.mainhand minecraft:paper
tellraw @s[scores={DialogueTrigger=214,TalkTime=65}] {"text":"<Emma> It's...a letter? It's from Mr. Looker."}]
tellraw @s[scores={DialogueTrigger=214,TalkTime=73}] {"text":"<Emma> "},{"selector":"@s"},{"text":"... I'll read it out loud, OK?"}]
execute as @s[scores={DialogueTrigger=214,TalkTime=78}] run scoreboard players set @s click 1
tellraw @s[scores={DialogueTrigger=214,TalkTime=80}] {"text":"<Emma> "\u201cTo my dearest friends... I must have but a moment of your time.","italic":true}]
tellraw @s[scores={DialogueTrigger=214,TalkTime=89}] {"text":"<Emma> "It is I, the great detective Looker.","italic":true}]
tellraw @s[scores={DialogueTrigger=214,TalkTime=96}] {"text":"<Emma> "I write today because there is something I must confess to you. This is confidential!","italic":true}]
tellraw @s[scores={DialogueTrigger=214,TalkTime=106}] {"text":"<Emma> "Top secret! I am not a private detective at all but an officer of the International Police!","italic":true}]
tellraw @s[scores={DialogueTrigger=214,TalkTime=116}] {"text":"<Emma> "You are shocked, of course. My hard-boiled detective act was brilliantly flawless, after all.","italic":true}]
tellraw @s[scores={DialogueTrigger=214,TalkTime=126}] {"text":"<Emma> "But I know you have been worrying about my long \u2018hospital stay' and the strange \u2018illness' that kept me there.","italic":true}]
tellraw @s[scores={DialogueTrigger=214,TalkTime=137}] {"text":"<Emma> "The truth is--I am the very picture of health! My hospital stay was a ruse to keep you all out of harm's way.","italic":true}]
tellraw @s[scores={DialogueTrigger=214,TalkTime=147}] {"text":"<Emma> "My intentions were only the best, but it was still a lie, for which I humbly apologize.\u201d","italic":true}]
tellraw @s[scores={DialogueTrigger=214,TalkTime=157}] {"text":"<Emma> "\u201cHowever, my friends, there is another reason for this letter.","italic":true}]
tellraw @s[scores={DialogueTrigger=214,TalkTime=166}] {"text":"<Emma> "And so I must request of you just a minute or two more. I came to this region for an investigation.","italic":true}]
tellraw @s[scores={DialogueTrigger=214,TalkTime=176}] {"text":"<Emma> "Detective Officer Looker was on the case!","italic":true}]
tellraw @s[scores={DialogueTrigger=214,TalkTime=184}] {"text":"<Emma> "And, indeed... Thanks to yours truly, the case is now closed.","italic":true}]
tellraw @s[scores={DialogueTrigger=214,TalkTime=193}] {"text":"<Emma> "My greatness prevailed! I cheer! And yet... It also means my time in Kalos is done.","italic":true}]
tellraw @s[scores={DialogueTrigger=214,TalkTime=202}] {"text":"<Emma> "I must say good-bye to this lovely region. And, more painfully, to you, my friends.","italic":true}]
tellraw @s[scores={DialogueTrigger=214,TalkTime=211}] {"text":"<Emma> "Thank you for all your assistance... And adieu. P.S. To ","italic":true},{"selector":"@s","italic":true},{"text":", my colleague...","italic":true}]
tellraw @s[scores={DialogueTrigger=214,TalkTime=223}] {"text":"<Emma> "You have been the perfect partner.","italic":true}]
tellraw @s[scores={DialogueTrigger=214,TalkTime=230}] {"text":"<Emma> "For all that you have done for me in our time together, I would like to present you with my cherished code name, \u2018Looker.'","italic":true}]
tellraw @s[scores={DialogueTrigger=214,TalkTime=242}] {"text":"<Emma> "And for Emma and Mimi... To the two of you, I leave the Looker Bureau.","italic":true}]
tellraw @s[scores={DialogueTrigger=214,TalkTime=251}] {"text":"<Emma> "I purchased the whole building, so never again will you have to worry about rent.","italic":true}]
tellraw @s[scores={DialogueTrigger=214,TalkTime=261}] {"text":"<Emma> "It is now yours to do with as you will.\u201d","italic":true}]
execute as @s[scores={DialogueTrigger=214,TalkTime=267}] run replaceitem entity @e[x=-51,y=100,z=385,dy=3,type=pixelmon:npc_chatting] weapon.mainhand minecraft:air
execute as @s[scores={DialogueTrigger=214,TalkTime=267}] run scoreboard players set @s click 1
tellraw @s[scores={DialogueTrigger=214,TalkTime=269}] {"text":"<Emma> Wh-what is this... Is he joking? What's this \u201cInternational Police\u201d?"}]
tellraw @s[scores={DialogueTrigger=214,TalkTime=279}] {"text":"<Emma> H-he wouldn't go and leave us, would he? Why...?"}]
tellraw @s[scores={DialogueTrigger=214,TalkTime=288}] {"text":"<Emma> Could he leave without even saying a word to us?!"}]
tellraw @s[scores={DialogueTrigger=214,TalkTime=296}] {"text":"<Emma> It can't be... He can't go..."}]
tellraw @s[scores={DialogueTrigger=214,TalkTime=303}] {"text":"<Emma> I don't want him to go off somewhere without us!"}]
tellraw @s[scores={DialogueTrigger=214,TalkTime=311}] {"text":"<Emma> He can't have gotten far yet, right? "},{"selector":"@s"},{"text":"! I'm going after him!"}]

