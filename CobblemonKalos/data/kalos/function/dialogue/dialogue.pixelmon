tellraw @s[scores={DialogueTrigger=219,TalkTime=11,TrainerLoot104=1}] {"text":"<Backpacker> We have this town that you wouldn't believe... Ah, never mind. You'll see it in due time."}

tellraw @s[scores={DialogueTrigger=219,TalkTime=1,TrainerLoot104=2}] {"text":"<Backpacker> The Kalos region is nice and all, but you should really check out my region!"}
tellraw @s[scores={DialogueTrigger=219,TalkTime=11,TrainerLoot104=2}] {"text":"<Backpacker> There's this facility that you wouldn't believe... Ah, never mind. You'll see it in due time."}

