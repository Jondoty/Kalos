tag @s[scores={DialogueTrigger=263,TalkTime=41..}] add Dialogue263
scoreboard players set @s[tag=Dialogue263] TalkTime 0
scoreboard players set @s[tag=Dialogue263] DialogueTrigger 0

#----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
#Player's Birthday Pokemon Centers
#https://youtu.be/YkIJXr4lIMU?t=110
#Dialogue265

execute as @s[scores={DialogueTrigger=265,TalkTime=1}] run effect give @s minecraft:blindness 5 1 true
execute as @s[scores={DialogueTrigger=265,TalkTime=1..6}] run stopsound @s record
execute as @s[scores={DialogueTrigger=265,TalkTime=7}] run scoreboard players set @s click 1

#Fireworks
execute as @s[scores={DialogueTrigger=265,TalkTime=7}] run summon minecraft:firework_rocket ~-5 ~ ~ {LifeTime:31,FireworksItem:{id:fireworks,Count:1,tag:{Fireworks:{Flight:2,Explosions:[{Type:1,Flicker:1,Trail:1,Colors:[I;11743532,2437522],FadeColors:[I;3887386,2437522]},{Type:1,Flicker:0,Trail:0,Colors:[I;14188952,12801229]}]}}}}
execute as @s[scores={DialogueTrigger=265,TalkTime=7}] run summon minecraft:firework_rocket ~5 ~ ~ {LifeTime:31,FireworksItem:{id:fireworks,Count:1,tag:{Fireworks:{Flight:2,Explosions:[{Type:1,Flicker:1,Trail:1,Colors:[I;11743532,2437522],FadeColors:[I;3887386,2437522]},{Type:1,Flicker:0,Trail:0,Colors:[I;14188952,12801229]}]}}}}

tellraw @s[scores={DialogueTrigger=265,TalkTime=10}] ["",{"text":"<Nurse Joy> Happy birthday to you, "},{"selector":"@s"},{"text":"!"}]
tellraw @s[scores={DialogueTrigger=265,TalkTime=18}] ["",{"text":"<Nurse Joy> Many happy returns, "},{"selector":"@s"},{"text":"!"}]
tellraw @s[scores={DialogueTrigger=265,TalkTime=26}] {"text":"<Nurse Joy> I hope this will be a wondewrful year for you!"}

tag @s[scores={DialogueTrigger=265,TalkTime=26..}] add Dialogue265
scoreboard players set @s[tag=Dialogue265] TalkTime 0
scoreboard players set @s[tag=Dialogue265] DialogueTrigger 0

