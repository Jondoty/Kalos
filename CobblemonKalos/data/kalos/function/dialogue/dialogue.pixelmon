tellraw @s[scores={DialogueTrigger=220,TalkTime=1,TrainerLoot103=1}] {"text":"<Tourist> I'm traveling the land to learn more about strong Trainers."}

tellraw @s[scores={DialogueTrigger=220,TalkTime=1,TrainerLoot103=2}] {"text":"<Tourist> First, I think I'll head over to Santalune City and then Cyllage City."}

tellraw @s[scores={DialogueTrigger=220,TalkTime=1,TrainerLoot103=3}] {"text":"<Tourist> There's a lot to be excited about when it comes to the strong Trainers of the Kalos region!"}

tellraw @s[scores={DialogueTrigger=220,TalkTime=1,TrainerLoot103=4..}] {"text":"<Tourist> I know a whole lot about strong Trainers!"}
