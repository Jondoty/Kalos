{
    "initializationAction": [
        "q.run_command('tag ' + q.player.username + ' add InDialogue');"
    ],
    "escapeAction": [],
    "speakers": {
        "looker": {
            "name": "Looker",
            "face": {
                "type": "artificial",
                "modelType": "npc",
                "identifier": "cobblemon:looker",
                "isLeftSide": true
            }
        },
        "newscast": {
            "name": "Newscast",
            "face": {
                "type": "artificial",
                "modelType": "npc",
                "identifier": "cobblemon:malva",
                "isLeftSide": false
            }
        },
        "player": {
            "face": "q.player.face(true);",
            "name": {
                "type": "expression",
                "expression": "q.player.username"
            }
        }
    },
    "pages": [
        {
            "id": "greeting",
            "speaker": "looker",
            "lines": [
                {
                    "type": "expression",
                    "expression": "'Ah, ' + q.player.username + ', thank you so much for your time. I need three minutes only.';"
                }
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "action": "q.dialogue.set_page('page2');"
                    }
                ]
            }
        },
        {
            "id": "page2",
            "speaker": "looker",
            "lines": [
                "Emma is on my mind. Recently, she has been running off somewhere on her own. And often."
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "action": "q.dialogue.set_page('page3');"
                    }
                ]
            }
        },
        {
            "id": "page3",
            "speaker": "looker",
            "lines": [
                "I was hoping to ask her to watch the office for me today, and once again, nowhere can she be found."
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "action": "q.dialogue.set_page('page4');"
                    }
                ]
            }
        },
        {
            "id": "page4",
            "speaker": "looker",
            "lines": [
                "It even seems as if she did not return here last night..."
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "action": "q.dialogue.set_page('page5');"
                    }
                ]
            }
        },
        {
            "id": "page5",
            "speaker": "looker",
            "lines": [
                "Her friends from the former gang seem to be on the straight and narrow,"
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "action": "q.dialogue.set_page('page6');"
                    }
                ]
            }
        },
        {
            "id": "page6",
            "speaker": "looker",
            "lines": [
                "so I hope this is not anything bad, but..."
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "action": "q.dialogue.set_page('page7');"
                    }
                ]
            }
        },
        {
            "id": "page7",
            "speaker": "looker",
            "lines": [
                "Hm? What's this? A Holo Caster clip?"
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "action": [
                            "q.dialogue.set_page('page8');"
                        ]
                    }
                ]
            }
        },
        {
            "id": "page8",
            "speaker": "newscast",
            "lines": [
                "We bring you a special bulletin..."
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "action": "q.dialogue.set_page('page9');"
                    }
                ]
            }
        },
        {
            "id": "page9",
            "speaker": "newscast",
            "lines": [
                "Late last night, an intruder broke into the Lumiose Museum and damaged a painting."
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "action": "q.dialogue.set_page('page10');"
                    }
                ]
            }
        },
        {
            "id": "page10",
            "speaker": "newscast",
            "lines": [
                "Museum staff said that security is very tight and breaking into the museum is impossible. The culprit remains at large."
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "action": "q.dialogue.set_page('page11');"
                    }
                ]
            }
        },
        {
            "id": "page11",
            "speaker": "looker",
            "lines": [
                {
                    "type": "expression",
                    "expression": "'Did you see that, ' + q.player.username + '?! Where trouble goes, Looker must follow!';"
                }
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "action": "q.dialogue.set_page('page12');"
                    }
                ]
            }
        },
        {
            "id": "page12",
            "speaker": "looker",
            "lines": [
                "I am on my way to the Lumiose Museum to begin my investigations! Most urgently!"
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "action": "q.dialogue.set_page('page13');"
                    }
                ]
            }
        },
        {
            "id": "page13",
            "speaker": "looker",
            "lines": [
                "It is straight to the scene of the crime for us!"
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "action": "q.dialogue.set_page('page14');"
                    }
                ]
            }
        },
        {
            "id": "page14",
            "speaker": "looker",
            "lines": [
                "...Oh, wouldn't it be nice if that were true?"
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "action": "q.dialogue.set_page('page15');"
                    }
                ]
            }
        },
        {
            "id": "page15",
            "speaker": "looker",
            "lines": [
                "But I actually have an appointment soon that I cannot possibly miss, so I am stuck here..."
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "action": "q.dialogue.set_page('page16');"
                    }
                ]
            }
        },
        {
            "id": "page16",
            "speaker": "looker",
            "lines": [
                {
                    "type": "expression",
                    "expression": "'I hate to ask this of you, but I need you to start the investigation without me, ' + q.player.username + '!';"
                }
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Close",
                        "value": "close",
                        "action": [
                            "q.run_command('tag ' + q.player.username + ' add Dialogue185');",
                            "q.run_command('tag ' + q.player.username + ' remove InDialogue');",
                            "q.run_command('execute as ' + q.player.username + ' run function kalos:triggers/stopsound');",
                            "q.run_command('execute as ' + q.player.username + ' run playsound lookerchapter record @s[tag=!RadioOff] ~ ~ ~ 1 1 1');",
                            "q.run_command('execute as ' + q.player.username + ' run scoreboard players add @s MusicCooldown 5');",
                            "q.run_command('effect give ' + q.player.username + ' minecraft:blindness 5 1 true');",
                            "q.run_command('title ' + q.player.username + ' times 20 100 20');",
                            "q.run_command('title ' + q.player.username + ' subtitle {\"text\":\"An Unforgivable Crime\"}');",
                            "q.run_command('title ' + q.player.username + ' title {\"text\":\"Chapter 4\"}');",
                            "q.dialogue.close();"
                        ]
                    }
                ]
            }
        }
    ]
}