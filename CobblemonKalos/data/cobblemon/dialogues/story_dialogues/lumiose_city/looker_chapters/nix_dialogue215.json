{
    "initializationAction": [
        "q.run_command('tag ' + q.player.username + ' add InDialogue');",
        "q.run_command('particle cloud -51 101 397 2 2 2 1 100');",
        "q.run_command('execute unless entity @e[limit=1,x=-51,y=100,z=397,dy=3,type=cobblemon:npc] run npcspawnat -51 101 397 punkguy_generic');"
    ],
    "escapeAction": [],
    "speakers": {
        "player": {
            "name": {
                "type": "expression",
                "expression": "q.player.username"
            },
            "face": "q.player.face(true);"
        },
        "punk": {
            "name": "Nix",
            "face": {
                "type": "artificial",
                "identifier": "cobblemon:punkguy",
                "modelType": "npc",
                "isLeftSide": true
            }
        }
    },
    "pages": [
        {
            "id": "greeting",
            "speaker": "punk",
            "lines": [
                {
                    "type": "expression",
                    "expression": "'Wotcher! How\\'s it going, ' + q.player.username + '?';"
                }
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "action": "q.dialogue.set_page('page2');"
                    }
                ]
            }
        },
        {
            "id": "page2",
            "speaker": "punk",
            "lines": [
                "I was bored, so I came over!"
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "action": "q.dialogue.set_page('page3');"
                    }
                ]
            }
        },
        {
            "id": "page3",
            "speaker": "punk",
            "lines": [
                "Eh, when I was comin' in just now, Emma were tearin' out in a hurry! Somethink happenin'?"
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "action": "q.dialogue.set_page('page4');"
                    }
                ]
            }
        },
        {
            "id": "page4",
            "speaker": "punk",
            "lines": [
                "Now you're gonna up and leave, too?!"
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "action": "q.dialogue.set_page('page5');"
                    }
                ]
            }
        },
        {
            "id": "page5",
            "speaker": "punk",
            "lines": [
                "I came all the way over here to visit! Why you all gotta be so cold like that?"
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "action": "q.dialogue.set_page('page6');"
                    }
                ]
            }
        },
        {
            "id": "page6",
            "speaker": "punk",
            "lines": [
                "An' even old man Looker!"
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "action": "q.dialogue.set_page('page7');"
                    }
                ]
            }
        },
        {
            "id": "page7",
            "speaker": "punk",
            "lines": [
                "When I just ran into him, he said he had to go to the Lumiose Museum and totally blew me off without another word!"
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "action": "q.dialogue.set_page('page8');"
                    }
                ]
            }
        },
        {
            "id": "page8",
            "speaker": "punk",
            "lines": [
                "Gah, I'm bored outta me skull."
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "action": "q.dialogue.set_page('page9');"
                    }
                ]
            }
        },
        {
            "id": "page9",
            "speaker": "punk",
            "lines": [
                "Happen I shoulda gone to the museum with our Looker, after all..."
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Close",
                        "value": "close",
                        "action": [
                            "q.run_command('particle cloud -51 101 397 2 2 2 1 100');",
                            "q.run_command('tp @e[x=-51,y=100,z=397,dy=3,type=cobblemon:npc] 10000000 -50000 -10000000');",
                            "q.run_command('tag ' + q.player.username + ' add Dialogue215');",
                            "q.run_command('tag ' + q.player.username + ' remove InDialogue');",
                            "q.dialogue.close();"
                        ]
                    }
                ]
            }
        }
    ]
}