        {
            "id": "page2",
            "speaker": "museumdirector",
            "lines": [
                "I am the museum director. May I ask you a question, young trainer?"
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
