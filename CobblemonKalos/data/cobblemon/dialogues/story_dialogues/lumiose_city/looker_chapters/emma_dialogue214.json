    "pages": [
        {
            "id": "greeting",
            "speaker": "emma",
            "lines": [
                {
                    "type": "expression",
                    "expression": "'Finally, ' + q.player.username + '! What took you so long?';"
                }
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "action": "q.dialogue.set_page('page2');"
                    }
                ]
            }
        },
        {
            "id": "page2",
            "speaker": "emma",
            "lines": [
                "Guess what! Mr. Looker is getting out of the hospital! Finally!"
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "action": "q.dialogue.set_page('page3');"
                    }
                ]
            }
        },
        {
            "id": "page3",
            "speaker": "emma",
            "lines": [
                "I wanted us all to be here to welcome him home!"
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "action": [
                            "q.run_command('particle cloud -49 101 387 2 2 2 1 100');",
                            "q.run_command('execute unless entity @e[x=-49,y=101,z=387,dy=3,type=cobblemon:pokemon] run pokespawnat -49 101 387 espurr level=30 uncatchable=yes no_ai=yes');",
                            "q.run_command('execute as ' + q.player.username + ' run playsound espurr hostile @s ~ ~ ~ 1 1 1');",
                            "q.dialogue.set_page('page4');"
                        ]
                    }
                ]
            }
        },
        {
            "id": "page4",
            "speaker": "mimi",
            "lines": [
                "Murrr-murrrrrr..."
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "action": [
                            "q.dialogue.set_page('page5');"
                        ]
                    }
                ]
            }
        },
        {
            "id": "page5",
            "speaker": "emma",
            "lines": [
                "Oh! Mimi, you're back! Come on, Mimi! You're part of the welcome party, too!"
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "action": [
                            "q.run_command('execute as ' + q.player.username + ' run playsound espurr hostile @s ~ ~ ~ 1 1 1');",
                            "q.dialogue.set_page('page6');"
                        ]
                    }
                ]
            }
        },
        {
            "id": "page6",
            "speaker": "mimi",
            "lines": [
                "Mrawr! Murrr-rrrawr!"
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "action": [
                            "q.dialogue.set_page('page7');"
                        ]
                    }
                ]
            }
        },
        {
            "id": "page7",
            "speaker": "emma",
            "lines": [
                "Huh? What's wrong with Mimi? I think it's holding something..."
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "action": [
                            "q.run_command('execute as ' + q.player.username + ' run playsound espurr hostile @s ~ ~ ~ 1 1 1');",
                            "q.dialogue.set_page('page8');"
                        ]
                    }
                ]
            }
        },
        {
            "id": "page8",
            "speaker": "mimi",
            "lines": [
                "Mrrrawr!"
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "action": [
                            "q.dialogue.set_page('page9');"
                        ]
                    }
                ]
            }
        },
        {
            "id": "page9",
            "speaker": "emma",
            "lines": [
                "It's...a letter? It's from Mr. Looker."
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "action": "q.dialogue.set_page('page10');"
                    }
                ]
            }
        },
        {
            "id": "page10",
            "speaker": "emma",
            "lines": [
                {
                    "type": "expression",
                    "expression": "'' + q.player.username + '... I\\'ll read it out loud, OK?';"
                }
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "action": [
                            "q.run_command('execute as ' + q.player.username + ' run function kalos:triggers/stopsound');",
                            "q.run_command('execute as ' + q.player.username + ' run playsound lookerssorrowfultheme record @s[tag=!RadioOff] ~ ~ ~ 1 1 1');",
                            "q.run_command('execute as ' + q.player.username + ' run scoreboard players set @s[tag=!RadioOff] MusicCooldown 133');",
                            "q.dialogue.set_page('page11');"
                        ]
                    }
                ]
            }
        },
        {
            "id": "page11",
            "speaker": "emma",
            "lines": [
                "“To my dearest friends... I must have but a moment of your time."
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "action": "q.dialogue.set_page('page12');"
                    }
                ]
            }
        },
        {
            "id": "page12",
            "speaker": "emma",
            "lines": [
                "It is I, the great detective Looker."
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "action": "q.dialogue.set_page('page13');"
                    }
                ]
            }
        },
        {
            "id": "page13",
            "speaker": "emma",
            "lines": [
                "I write today because there is something I must confess to you. This is confidential!"
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "action": "q.dialogue.set_page('page14');"
                    }
                ]
            }
        },
        {
            "id": "page14",
            "speaker": "emma",
            "lines": [
                "Top secret! I am not a private detective at all but an officer of the International Police!"
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "action": "q.dialogue.set_page('page15');"
                    }
                ]
            }
        },
        {
            "id": "page15",
            "speaker": "emma",
            "lines": [
                "You are shocked, of course. My hard-boiled detective act was brilliantly flawless, after all."
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "action": "q.dialogue.set_page('page16');"
                    }
                ]
            }
        },
        {
            "id": "page16",
            "speaker": "emma",
            "lines": [
                "But I know you have been worrying about my long ‘hospital stay' and the strange ‘illness' that kept me there."
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "action": "q.dialogue.set_page('page17');"
                    }
                ]
            }
        },
        {
            "id": "page17",
            "speaker": "emma",
            "lines": [
                "The truth is--I am the very picture of health! My hospital stay was a ruse to keep you all out of harm's way."
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "action": "q.dialogue.set_page('page18');"
                    }
                ]
            }
        },
        {
            "id": "page18",
            "speaker": "emma",
            "lines": [
                "My intentions were only the best, but it was still a lie, for which I humbly apologize.”"
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "action": "q.dialogue.set_page('page19');"
                    }
                ]
            }
        },
        {
            "id": "page19",
            "speaker": "emma",
            "lines": [
                "“However, my friends, there is another reason for this letter."
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "action": "q.dialogue.set_page('page20');"
                    }
                ]
            }
        },
        {
            "id": "page20",
            "speaker": "emma",
            "lines": [
                "And so I must request of you just a minute or two more. I came to this region for an investigation."
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "action": "q.dialogue.set_page('page21');"
                    }
                ]
            }
        },
        {
            "id": "page21",
            "speaker": "emma",
            "lines": [
                "Detective Officer Looker was on the case!"
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "action": "q.dialogue.set_page('page22');"
                    }
                ]
            }
        },
        {
            "id": "page22",
            "speaker": "emma",
            "lines": [
                "And, indeed... Thanks to yours truly, the case is now closed."
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "action": "q.dialogue.set_page('page23');"
                    }
                ]
            }
        },
        {
            "id": "page23",
            "speaker": "emma",
            "lines": [
                "My greatness prevailed! I cheer! And yet... It also means my time in Kalos is done."
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "action": "q.dialogue.set_page('page24');"
                    }
                ]
            }
        },
        {
            "id": "page24",
            "speaker": "emma",
            "lines": [
                "I must say good-bye to this lovely region. And, more painfully, to you, my friends."
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "action": "q.dialogue.set_page('page25');"
                    }
                ]
            }
        },
        {
            "id": "page25",
            "speaker": "emma",
            "lines": [
                {
                    "type": "expression",
                    "expression": "'Thank you for all your assistance... And adieu. P.S. To ' + q.player.username + ', my colleague...';"
                }
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "action": "q.dialogue.set_page('page26');"
                    }
                ]
            }
        },
        {
            "id": "page26",
            "speaker": "emma",
            "lines": [
                "You have been the perfect partner."
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "action": "q.dialogue.set_page('page27');"
                    }
                ]
            }
        },
        {
            "id": "page27",
            "speaker": "emma",
            "lines": [
                "For all that you have done for me in our time together, I would like to present you with my cherished code name, ‘Looker.'"
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "action": "q.dialogue.set_page('page28');"
                    }
                ]
            }
        },
        {
            "id": "page28",
            "speaker": "emma",
            "lines": [
                "And for Emma and Mimi... To the two of you, I leave the Looker Bureau."
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "action": "q.dialogue.set_page('page29');"
                    }
                ]
            }
        },
        {
            "id": "page29",
            "speaker": "emma",
            "lines": [
                "I purchased the whole building, so never again will you have to worry about rent."
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "action": "q.dialogue.set_page('page30');"
                    }
                ]
            }
        },
        {
            "id": "page30",
            "speaker": "emma",
            "lines": [
                "It is now yours to do with as you will.”"
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "action": "q.dialogue.set_page('page31');"
                    }
                ]
            }
        },
        {
            "id": "page31",
            "speaker": "emma",
            "lines": [
                "Wh-what is this... Is he joking? What's this “International Police”?"
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "action": "q.dialogue.set_page('page32');"
                    }
                ]
            }
        },
        {
            "id": "page32",
            "speaker": "emma",
            "lines": [
                "H-he wouldn't go and leave us, would he? Why...?"
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "action": "q.dialogue.set_page('page33');"
                    }
                ]
            }
        },
        {
            "id": "page33",
            "speaker": "emma",
            "lines": [
                "Could he leave without even saying a word to us?!"
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "action": "q.dialogue.set_page('page34');"
                    }
                ]
            }
        },
        {
            "id": "page34",
            "speaker": "emma",
            "lines": [
                "It can't be... He can't go..."
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "action": "q.dialogue.set_page('page35');"
                    }
                ]
            }
        },
        {
            "id": "page35",
            "speaker": "emma",
            "lines": [
                "I don't want him to go off somewhere without us!"
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "action": "q.dialogue.set_page('page36');"
                    }
                ]
            }
        },
        {
            "id": "page36",
            "speaker": "emma",
            "lines": [
                {
                    "type": "expression",
                    "expression": "'He can\\'t have gotten far yet, right? ' + q.player.username + '! I\\'m going after him!';"
                }
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "action": [
                            "q.run_command('particle cloud -51 101 385 2 2 2 1 100');",
                            "q.run_command('tp @e[x=-51,y=100,z=385,dy=3,type=cobblemon:npc] 10000000 -50000 -10000000');",
                            "q.run_command('execute as ' + q.player.username + ' run playsound espurr hostile @s ~ ~ ~ 1 1 1');",
                            "q.dialogue.set_page('page37');"
                        ]
                    }
                ]
            }
        },
        {
            "id": "page37",
            "speaker": "mimi",
            "lines": [
                "Mrrraaawwwrrr!!!"
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Close",
                        "value": "close",
                        "action": [
                            "q.run_command('particle cloud -49 101 387 2 2 2 1 100');",
                            "q.run_command('tp @e[x=-49,y=100,z=387,dy=3,type=cobblemon:pokemon] 10000000 -50000 -10000000');",
                            "q.run_command('tag ' + q.player.username + ' add Dialogue214');",
                            "q.run_command('tag ' + q.player.username + ' remove InDialogue');",
                            "q.dialogue.close();"
                        ]
                    }
                ]
            }
        }
    ]
