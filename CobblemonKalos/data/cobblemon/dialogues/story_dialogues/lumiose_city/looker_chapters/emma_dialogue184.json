            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "action": "q.dialogue.set_page('page50');"
                    }
                ]
            }
        },
        {
            "id": "page50",
            "speaker": "punkguy",
            "lines": [
                {
                    "type": "expression",
                    "expression": "'Sh-she really is, Looker, sir. And ' + q.player.username + '!';"
                }
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "action": "q.dialogue.set_page('page51');"
                    }
                ]
            }
        },
        {
            "id": "page51",
            "speaker": "looker",
            "lines": [
