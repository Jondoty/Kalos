{
    "initializationAction": [
        "q.run_command('tag ' + q.player.username + ' add InDialogue');",
        "q.run_command('execute as ' + q.player.username + ' run function kalos:triggers/stopsound');",
        "q.run_command('execute as ' + q.player.username + ' run playsound sycamorestheme record @s[tag=!RadioOff] ~ ~ ~ 1 1 1');",
        "q.run_command('execute as ' + q.player.username + ' run scoreboard players set @s[tag=!RadioOff] MusicCooldown 98');"
    ],
