                        "action": [
                            "q.dialogue.close();",
                            "q.run_command('particle cloud 1029 105 1893 2 2 2 1 100');",
                            "q.run_command('tp @e[x=1029,y=105,z=1893,dy=3,type=cobblemon:npc] 10000000 -50000 -10000000');",
                            "q.run_command('tag ' + q.player.username + ' add Dialogue160');",
                            "q.run_command('execute as ' + q.player.username + ' run function kalos:triggers/stopsound');",
                            "q.run_command('tag ' + q.player.username + ' remove InDialogue');"
                        ]
                    }
                ]
            }
