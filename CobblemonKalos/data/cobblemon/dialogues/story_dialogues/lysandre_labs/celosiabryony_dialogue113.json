        },
        {
            "id": "page2",
            "speaker": "celosia",
            "lines": [
                "You and your Pokémon were utterly in sync in that battle, and I know why."
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Next",
