{
    "initializationAction": [
        "q.run_command('execute as ' + q.player.username + ' run function kalos:triggers/stopsound');",
        "q.run_command('execute as ' + q.player.username + ' run playsound ultimateweapondeployed record @s[tag=!RadioOff] ~ ~ ~ 1 1 1');",
        "q.run_command('execute as ' + q.player.username + ' run scoreboard players set @s[tag=!RadioOff] MusicCooldown 90');",
        "q.run_command('tag ' + q.player.username + ' add InDialogue');"
    ],
    "escapeAction": [
    ],
    "names": [
    ],
    "speakers": {
        "xerosic": {
            "name": "Xerosic",
            "face": {
                "type": "artificial",
                "modelType": "npc",
                "identifier": "cobblemon:xerosic",
                "isLeftSide": false
            }
        }
    },
    "pages": [    
        {
            "id": "greeting",
            "speaker": "xerosic",
            "lines": [
                "You pushed it! Oh ho ho! You pushed the little red button!"
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "action": [
                            "q.dialogue.set_page('page2');"
                        ]
                    }
                ]
            }
        },
        {
            "id": "page2",
            "speaker": "xerosic",
            "lines": [
                "Too bad...for you! Pushing that button has enabled us to use the ultimate weapon!"
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "action": [
                            "q.dialogue.set_page('page3');"
                        ]
                    }
                ]
            }
        },    
        {
            "id": "page3",
            "speaker": "xerosic",
            "lines": [
                "Don't feel too down, though. I would have activated it even if you had guessed correctly."
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "action": [
                            "q.dialogue.set_page('page4');"
                        ]
                    }
                ]
            }
        },   
        {
            "id": "page4",
            "speaker": "xerosic",
            "lines": [
                "Come on! Look! Look at the monitor!"
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Close",
                        "value": "close",
                        "action": [
                            "q.run_command('scoreboard players set ' + q.player.username + ' DialogueTrigger 120');",
                            "q.run_command('scoreboard players add ' + q.player.username + ' TalkTime 34');",
                            "q.run_command('tag ' + q.player.username + ' remove InDialogue');",
                            "q.dialogue.close();"
                        ]
                    }
                ]
            }
        }
    ]
}