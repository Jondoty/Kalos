        },
        {
            "id": "page19",
            "speaker": "npc",
            "lines": [
                "Even haunted houses aren't free, you know!"
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
