                        ]
                    }
                ]
            }
        },
        {
            "id": "page17",
            "speaker": "mable",
            "lines": [
                "Allow me to spell it out for you! It's so Team Flare--and only Team Flare--can survive!"
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "action": [
