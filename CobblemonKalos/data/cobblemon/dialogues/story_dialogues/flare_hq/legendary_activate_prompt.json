{   
    "initializationAction": [
    "q.run_command('tag ' + q.player.username + ' add InDialogue');"
    ],
    "escapeAction": [
    ],
    "speakers": {
        "player": {
         "face": "q.player.face(true);",
         "name": {
        "type": "expression",
        "expression": "q.player.username"
      }
    }
      },
    "pages": [
        {
            "id": "greeting",
            "speaker": "player",
            "lines": [
                "It's the computer that's holding the Legendary Pokemon captive. "
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "action": "q.dialogue.set_page('page2');"
                    }
                ]
            }
        },
        {
            "id": "page2",
            "speaker": "player",
            "lines": [
                "Do you wish to free it?"
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Yes",
                        "value": "yes",
                        "action": "q.dialogue.set_page('page3');"
                    },
                    {
                        "text": "No",
                        "value": "no",
                        "action": [
                            "q.run_command('tag ' + q.player.username + ' remove InDialogue');",
                            "q.run_command('execute as ' + q.player.username + ' at @s run tp @s ~ ~ ~6');",
                            "q.dialogue.close();"]
                    }
                ]
            }
        },
        {
            "id": "page3",
            "speaker": "player",
            "lines": [
                "You activated the machine!"
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Close",
                        "value": "close",
                        "action": [
                            "q.run_command('execute as ' + q.player.username + ' run scoreboard players set @s DialogueTrigger 131');",
                            "q.run_command('tag ' + q.player.username + ' remove InDialogue');",
                            "q.dialogue.close();"
                            ]
                    }
                ]
            }
        }
        ]
    }