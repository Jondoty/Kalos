                        "action": [
                            "q.dialogue.set_page('page6');"
                        ]
                    }
                ]
            }
        },
        {
            "id": "page6",
            "speaker": "trainer",
            "lines": [
                "I wonder if Mamoswine was worried about its pal..."
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "action": [
                            "q.dialogue.set_page('page7');"
                        ]
                    }
                ]
            }
        },
        {
            "id": "page7",
            "speaker": "trainer",
            "lines": [
