                        "action": [
                            "q.run_command('execute as ' + q.player.username + ' run playsound minecraft:itemget ambient @s ~ ~ ~ 1 1 1');",
                            "q.run_command('execute as ' + q.player.username + ' run pokegive mamoswine level=40 tradeable=no');",
                            "q.dialogue.set_page('page8');"
                        ]
                    }
                ]
            }
        },
        {
            "id": "page8",
            "speaker": "trainer",
            "lines": [
