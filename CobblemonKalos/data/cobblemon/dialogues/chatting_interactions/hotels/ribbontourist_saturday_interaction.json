                            "q.run_command('execute as ' + q.player.username + ' run givemark @s[tag=!Dialogue280] 1 cobblemon:ribbon_day_snooze');",
                            "q.run_command('execute as ' + q.player.username + ' run playsound minecraft:entity.player.levelup ambient @s[tag=!Dialogue280] ~ ~ ~ 1 1 1');",
