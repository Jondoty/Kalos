{
    "speakers": {
        "npc": {
            "name": "Ribbon Tourist",
            "face": {
                "type": "artificial",
                "modelType": "npc",
                "identifier": "cobblemon:tourist",
                "isLeftSide": true
            }
        }
    },
    "pages": [
        {
            "id": "page1",
            "speaker": "npc",
            "lines": [
                "You ever get a bad case of brain fog and can't figure out why?"
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "action": [
                            "q.dialogue.set_page('page2');"
                        ]
                    }
                ]
            }
        },
        {
            "id": "page2",
            "speaker": "npc",
            "lines": [
                "You won't have to worry anymore with this! I'll give you a Relax Ribbon!"
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "action": [
                            "q.run_command('execute as ' + q.player.username + ' run givemark @s[tag=!Dialogue278] 1 cobblemon:ribbon_day_relax');",
                            "q.run_command('execute as ' + q.player.username + ' run playsound minecraft:entity.player.levelup ambient @s[tag=!Dialogue278] ~ ~ ~ 1 1 1');",
                            "q.run_command('execute as ' + q.player.username + ' run tag @s add Dialogue278');",
                            "q.dialogue.set_page('page3');"
                        ]
                    }
                ]
            }
        },
        {
            "id": "page3",
            "speaker": "npc",
            "lines": [
                "When you're feeling refreshed, it's easy to get inspiration!"
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "action": [
                            "q.dialogue.set_page('page4');"
                        ]
                    }
                ]
            }
        },
        {
            "id": "page4",
            "speaker": "npc",
            "lines": [
                "Take a look at the Relax Ribbon to refresh your mind and body!"
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Close",
                        "value": "close",
                        "action": [
                            "q.dialogue.close();"
                        ]
                    }
                ]
            }
        }
    ]
}