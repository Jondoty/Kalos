        },
        {
            "id": "page2",
            "speaker": "npc",
            "lines": [
                "Welcome to the only shop in town that’ll move you! It’s Sushi High Roller! So, what’re you thinking today? Anything special catch your fancy?"
            ],
            "input": {
                "type": "option",
                "vertical": true,
                "options": [
                    {
                        "text": "I’ll get something",
                        "value": "dine",
                        "action": [
                            "q.dialogue.set_page('page3');"
                        ]
                    },
                    {
                        "text": "Another time",
                        "value": "leave",
                        "action": [
                            "q.dialogue.set_page('end');"
                        ]
                    }
                ]
            }
        },
        {
            "id": "page3",
            "speaker": "npc",
            "lines": [
                "This meal will total to $30,000. Shall we begin the preparations?"
            ],
            "input": {
                "type": "option",
                "vertical": true,
                "options": [
                    {
                        "text": "I'll try it",
                        "value": "next",
                        "action": [
                            "q.dialogue.set_page('page4');"
                        ]
                    },
                    {
                        "text": "Another time",
                        "value": "leave",
                        "action": [
                            "q.dialogue.set_page('end');"
                        ]
                    }
                ]
            }
        },
        {
            "id": "page4",
            "speaker": "npc",
            "lines": [
                "I’m delighted to hear it. Please follow me this way."
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Close",
                        "value": "close",
                        "action": [
                            "q.run_command('execute as ' + q.player.username + ' run tp @s -485 101 157 -72.90 12.15');",
                            "q.run_command('execute as ' + q.player.username + ' run particle cloud -481 101 158 2 2 2 1 100');",
                            "q.run_command('execute unless entity @e[x=-481,y=100,z=158,dy=3,type=cobblemon:npc] run npcspawnat -481 101 158 highroller_first');",
                            "q.run_command('execute as ' + q.player.username + ' run scoreboard players remove @s Money 30000');",
                            "q.dialogue.close();"
                        ]
                    }
                ]
            }
        },

        {
            "id": "end",
            "speaker": "npc",
            "lines": [
                {
                    "type": "expression",
                    "expression": "'Awww! Gettin’ my expectations up like that! Typical ' + q.player.username + '!';"
                }
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Close",
                        "value": "close",
