{
    "initializationAction": [
        "q.run_command('execute as ' + q.player.username + ' run function kalos:data/testformoney');"
    ],
    "escapeAction": [
        "q.run_command('execute as ' + q.player.username + ' run function kalos:data/removemoneytags');",
        "q.dialogue.close();"
    ],
    "speakers": {
        "npc": {
            "name": "Restaurant Le Nah",
            "face": {
                "type": "artificial",
                "modelType": "npc",
                "identifier": "cobblemon:dress",
                "isLeftSide": true
            }
        }
    },
    "pages": [
        {
            "id": "greeting",
            "speaker": "npc",
            "lines": [
                {
                    "type": "expression",
                    "expression": "'Hmm. If it isn’t ' + q.player.username + '. We’ve been waiting for your visit.';"
                }
            ],
            "input": {
                "type": "option",
                "vertical": true,
                "options": [
                    {
                        "text": "I’d like to dine",
                        "value": "dine",
                        "action": [
                            "q.dialogue.set_page('page2');"
                        ]
                    },
                    {
                        "text": "Another time",
                        "value": "leave",
                        "action": [
                            "q.dialogue.set_page('end');"
                        ]
                    }
                ]
            }
        },
        {
            "id": "page2",
            "speaker": "npc",
            "lines": [
                "We are delighted to offer a full three-course feast of Pokemon battles at our establishment for a mere $3,000. Would you like to try it?"
            ],
            "input": {
                "type": "option",
                "vertical": true,
                "options": [
                    {
                        "isSelectable": "q.player.has_tag('MoneyHave3000')",
                        "text": "I'll try it",
                        "value": "next",
                        "action": [
                            "q.dialogue.set_page('page3');"
                        ]
                    },
                    {
                        "text": "Another time",
                        "value": "leave",
                        "action": [
                            "q.dialogue.set_page('end');"
                        ]
                    }
                ]
            }
        },
        {
            "id": "page3",
            "speaker": "npc",
            "lines": [
                "I’m delighted to hear it. Please follow me this way."
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Close",
                        "value": "close",
                        "action": [
                            "q.run_command('execute as ' + q.player.username + ' run tp @s -189 101 157 0 ~');",
                            "q.run_command('execute as ' + q.player.username + ' run particle cloud -185 101 158 2 2 2 1 100');",
                            "q.run_command('execute unless entity @e[x=-185,y=100,z=158,dy=3,type=cobblemon:npc] run npcspawnat -185 101 158 lenah_first');",
                            "q.run_command('execute as ' + q.player.username + ' run scoreboard players remove @s Money 3000');",
                            "q.run_command('execute as ' + q.player.username + ' run function kalos:data/removemoneytags');",
                            "q.dialogue.close();"
                        ]
                    }
                ]
            }
        },
        {
            "id": "end",
            "speaker": "npc",
            "lines": [
                {
                    "type": "expression",
                    "expression": "'Oh... Well, we’ll be looking forward to your next visit, ' + q.player.username + '...';"
                }
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Close",
                        "value": "close",
                        "action": [
                            "q.run_command('execute as ' + q.player.username + ' run function kalos:data/removemoneytags');",
                            "q.dialogue.close();"
                        ]
                    }
                ]
            }
        }
    ]
}