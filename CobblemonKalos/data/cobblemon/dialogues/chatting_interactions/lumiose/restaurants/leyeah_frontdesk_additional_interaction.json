{
    "initializationAction": [
        "q.run_command('execute as ' + q.player.username + ' run function kalos:data/testformoney');"
    ],
    "escapeAction": [
        "q.run_command('execute as ' + q.player.username + ' run function kalos:data/removemoneytags');",
        "q.dialogue.close();"
    ],
    "speakers": {
        "npc": {
            "name": "Restaurant Le Yeah",
            "face": {
                "type": "artificial",
                "modelType": "npc",
                "identifier": "cobblemon:monsieur",
                "isLeftSide": true
            }
        }
    },
    "pages": [
        {
            "id": "greeting",
            "speaker": "npc",
            "lines": [
                {
                    "type": "expression",
                    "expression": "'Well, if it isn’t good old ' + q.player.username + '! Everyone here’s been waiting for you!';"
                }
            ],
            "input": {
                "type": "option",
                "vertical": true,
                "options": [
                    {
                        "text": "Yeah, I’ll dine",
                        "value": "dine",
                        "action": [
                            "q.dialogue.set_page('page2');"
                        ]
                    },
                    {
                        "text": "Another time",
                        "value": "leave",
                        "action": [
                            "q.dialogue.set_page('end');"
                        ]
                    }
                ]
            }
        },
        {
            "id": "page2",
            "speaker": "npc",
            "lines": [
                "We're proud to serve a full four-course feast of Pokemon battles here at Le Yeah for just $15,000. Want to try it?"
            ],
            "input": {
                "type": "option",
                "vertical": true,
                "options": [
                    {
                        "isSelectable": "q.player.has_tag('MoneyHave15000')",
                        "text": "Yeah, I’ll dine",
                        "value": "next",
                        "action": [
                            "q.dialogue.set_page('page3');"
                        ]
                    },
                    {
                        "text": "Another time",
                        "value": "leave",
                        "action": [
                            "q.dialogue.set_page('end');"
                        ]
                    }
                ]
            }
        },
        {
            "id": "page3",
            "speaker": "npc",
            "lines": [
                "Yeah! That’s what we like to hear. Right this way."
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Close",
                        "value": "close",
                        "action": [
                            "q.run_command('execute as ' + q.player.username + ' run tp @s -398 101 157 0 ~');",
                            "q.run_command('execute as ' + q.player.username + ' run particle cloud -394 101 158 2 2 2 1 100');",
                            "q.run_command('execute unless entity @e[x=-394,y=100,z=158,dy=3,type=cobblemon:npc] run npcspawnat -394 101 158 leyeah_first');",
                            "q.run_command('execute as ' + q.player.username + ' run scoreboard players remove @s Money 15000');",
                            "q.run_command('execute as ' + q.player.username + ' run function kalos:data/removemoneytags');",
                            "q.dialogue.close();"
                        ]
                    }
                ]
            }
        },
        {
            "id": "end",
            "speaker": "npc",
            "lines": [
                {
                    "type": "expression",
                    "expression": "'Well, we’re always sad any time we have to see you go, ' + q.player.username + '. But all of us here on the staff will be waiting eagerly for your next visit!';"
                }
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Close",
                        "value": "close",
                        "action": [
                            "q.run_command('execute as ' + q.player.username + ' run function kalos:data/removemoneytags');",
                            "q.dialogue.close();"
                        ]
                    }
                ]
            }
        }
    ]
}