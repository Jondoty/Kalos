    "pages": [
        {
            "id": "page1",
            "speaker": "npc",
            "lines": [
                "Sleep can cure all of life's problems!"
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "action": "q.dialogue.set_page('page2');"
                    }
                ]
            }
        },
        {
            "id": "page2",
            "speaker": "npc",
            "lines": [
                "You should let your Pokemon get some rest."
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "action": [
                            "q.run_command('execute as ' + q.player.username + ' run tellraw @s[tag=ItemLoot180] {\"text\":\"You've already claimed this loot!\",\"italic\":true,\"color\":\"gray\"}');",
                            "q.run_command('execute as ' + q.player.username + ' run givetm sleep  @s[tag=!ItemLoot180]');",
                            "q.run_command('execute as ' + q.player.username + ' run tellraw @s[tag=!ItemLoot180] {\"text\":\"You received the TM Sleep!\",\"italic\":true,\"color\":\"gray\"}');",
                            "q.run_command('execute as ' + q.player.username + ' run playsound tmget ambient @s[tag=!ItemLoot180] ~ ~ ~ 1 1 1');",
                            "q.run_command('execute as ' + q.player.username + ' run tag @s[tag=!ItemLoot180] add ItemLoot180');",
                            "q.dialogue.set_page('page3');"
                        ]
                    }
                ]
            }
        },
        {
            "id": "page3",
            "speaker": "npc",
            "lines": [
                "Using Rest, sleep to fully recover HP!"
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "action": "q.dialogue.set_page('page4');"
                    }
                ]
            }
        },
        {
            "id": "page4",
            "speaker": "npc",
            "lines": [
                "Status conditions will be cured too!"
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Close",
                        "value": "close",
                        "action": [
                            "q.dialogue.close();"
                        ]
                    }
                ]
            }
        }
    ]
