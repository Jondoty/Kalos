{
    "speakers": {
        "npc": {
            "name": "Fan Club Head",
            "face": {
                "type": "artificial",
                "modelType": "npc",
                "identifier": "cobblemon:monsieur",
                "isLeftSide": true
            }
        }
    },
    "pages": [
        {
            "id": "page1",
            "speaker": "npc",
            "lines": [
                "Greetings, greetings!"
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "action": "q.dialogue.set_page('page2');"
                    }
                ]
            }
        },
        {
            "id": "page2",
            "speaker": "npc",
            "lines": [
                "As you can see, I am the head of the local chapter of the Pok\u00e9mon Fan Club here in the Kalos region!"
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "action": "q.dialogue.set_page('page3');"
                    }
                ]
            }
        },
        {
            "id": "page3",
            "speaker": "npc",
            "lines": [
                "It is my proud duty to grant Effort Ribbons to any Pok\u00e9mon that are clearly making an effort!"
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "action": "q.dialogue.set_page('page4');"
                    }
                ]
            }
        },
        {
            "id": "page4",
            "speaker": "npc",
            "lines": [
                "Let's see, your Pok\u00e9mon is..."
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "action": "q.dialogue.set_page('page5');"
                    }
                ]
            }
        },
        {
            "id": "page5",
            "speaker": "npc",
            "lines": [
                "It has made a positively tremendous effort!"
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "action": "q.dialogue.set_page('page6');"
                    }
                ]
            }
        },
        {
            "id": "page6",
            "speaker": "npc",
            "lines": [
                "It would look just stunning if you gave it this Effort Ribbon to wear as a reward!"
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Close",
                        "value": "close",
                        "action": [
                            "q.run_command('execute as ' + q.player.username + ' run givemark @s 1 cobblemon:ribbon_effort');",
                            "q.run_command('execute as ' + q.player.username + ' run playsound minecraft:entity.player.levelup ambient @s ~ ~ ~ 1 1 1');",
                            "q.dialogue.close();"
                        ]
                    }
                ]
            }
        }
    ]
}