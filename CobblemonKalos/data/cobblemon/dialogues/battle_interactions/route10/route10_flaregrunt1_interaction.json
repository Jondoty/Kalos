{
  "initializationAction": [
    "q.run_command('scoreboard players set ' + q.player.username + ' BattleStart 4');",
    "q.run_command('execute as ' + q.player.username + ' run function kalos:triggers/stopsound');"
  ],
  "escapeAction": [
    "q.run_command('scoreboard players set ' + q.player.username + ' BattleStart 0');",
    "q.run_command('execute as ' + q.player.username + ' run function kalos:triggers/stopsound');",
    "q.dialogue.close();"
  ],
  "names": [
    "Team Flare Grunt"
  ],
  "speakers": {
    "npc": {
      "name": {
        "type": "expression",
        "expression": "q.npc.name"
      },
      "face": "q.npc.face();"
    }
  },
  "pages": [
        {
            "id": "greeting",
            "speaker": "npc",
            "lines": [
                "Stop right there! I remember you!"
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "action": [
                            "q.dialogue.set_page('page2');"
                        ]
                    }
                ]
            }
        },
        {
            "id": "page2",
            "speaker": "npc",
            "lines": [
                "You're the one who foiled our Fossil-finding plans!"
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "action": "q.dialogue.set_page('page3');"
                    }
                ]
            }
        },
        {
            "id": "page3",
            "speaker": "npc",
            "lines": [
                "And now you're here, standing around these stones. Do you have any idea what they even are?"
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "action": "q.dialogue.set_page('page4');"
                    }
                ]
            }
        },
        {
            "id": "page4",
            "speaker": "npc",
            "lines": [
                "Of course you don't! You know nothing about the legend of 3,000 years ago that says..."
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "action": "q.dialogue.set_page('page5');"
                    }
                ]
            }
        },
        {
            "id": "page5",
            "speaker": "npc",
            "lines": [
                "Wait, what does it say? Oh, whatever!"
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "action": "q.dialogue.set_page('page6');"
                    }
                ]
            }
        },
    {
      "id": "page6",
      "speaker": "npc",
      "lines": [
        "Who cares about all of that? It's time for me to get some sweet revenge...with style!"
      ],
      "input": {
        "type": "option",
        "vertical": false,
        "options": [
          {
            "text": "§c⚔ Battle ⚔§r",
            "value": "battle",
            "action": [
              "q.run_command('scoreboard players set ' + q.player.username + ' BattleStart 28');",
              "q.run_command('execute as ' + q.player.username + ' run function kalos:triggers/stopsound');",
              "v.battle = q.npc.start_battle(q.player);"
            ]
          }
        ]
      }
    }
  ]
}