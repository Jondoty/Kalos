                            "q.dialogue.set_page('buy1');"
                        ]
                    }
                ]
            }
        },

        {
            "id": "buyend",
            "speaker": "npc",
            "lines": [
                "Here you are! Thank you!"
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Close",
                        "value": "close",
                        "action": [
                            "q.run_command('execute as ' + q.player.username + ' run function kalos:data/removemoneytags');",
