                            "q.dialogue.set_page('buy1');"
                        ]
                    }
                ]
            }
        },
        {
            "id": "pickraindance",
            "speaker": "npc",
            "lines": [
                "$25000) The user summons a heavy rain that falls for five turns, powering up Water-type attacks. The rain also lowers the power of Fire-type attacks."
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "isSelectable": "q.player.has_tag('MoneyHave25000')",
