                            "q.dialogue.set_page('buy1');"
                        ]
                    }
                ]
            }
        },
        {
            "id": "picklightscreen",
            "speaker": "npc",
            "lines": [
                "$15000) A wondrous wall of light is put up to reduce damage from special moves for five turns."
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "isSelectable": "q.player.has_tag('MoneyHave15000')",
