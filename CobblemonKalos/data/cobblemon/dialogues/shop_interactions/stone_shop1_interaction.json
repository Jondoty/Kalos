{
    "initializationAction": [
        "q.run_command('execute as ' + q.player.username + ' run function kalos:data/testformoney');"
    ],
    "escapeAction": [
        "q.run_command('execute as ' + q.player.username + ' run function kalos:data/removemoneytags');",
        "q.dialogue.close();"
    ],
    "names": [
        "Stone Emporium Shop"
    ],
    "speakers": {
        "npc": {
            "name": "Stone Emporium Shop",
            "face": {
                "type": "artificial",
                "modelType": "npc",
                "identifier": "cobblemon:shopman",
                "isLeftSide": true
            }
        }
    },
    "pages": [
        {
            "id": "greeting",
            "speaker": "npc",
            "lines": [
                "Welcome to the Stone Emporium. We sell various stones."
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Buy",
                        "value": "buy",
                        "action": "q.dialogue.set_page('buy1');"
                    },
                    {
                        "text": "No Thanks",
                        "value": "nothanks",
                        "action": "q.dialogue.set_page('end');"
                    }
                ]
            }
        },
        {
            "id": "buy1",
            "speaker": "npc",
            "lines": [
                "Which item would you like to purchase?"
            ],
            "input": {
                "type": "option",
                "vertical": true,
                "options": [
                    {
                        "text": "Fire Stone",
                        "value": "firestone",
                        "action": "q.dialogue.set_page('pickfirestone');"
                    },
                    {
                        "text": "Water Stone",
                        "value": "waterstone",
                        "action": "q.dialogue.set_page('pickwaterstone');"
                    },
                    {
                        "text": "Thunder Stone",
                        "value": "thunderstone",
                        "action": "q.dialogue.set_page('pickthunderstone');"
                    },
                    {
                        "text": "Leaf Stone",
                        "value": "leafstone",
                        "action": "q.dialogue.set_page('pickleafstone');"
                    },
                    {
                        "text": "Moon Stone",
                        "value": "moonstone",
                        "action": "q.dialogue.set_page('pickmoonstone');"
                    },
                    {
                        "text": "Next Page >>",
                        "value": "nextpage",
                        "action": "q.dialogue.set_page('buy2');"
                    }
                ]
            }
        },
        {
            "id": "buy2",
            "speaker": "npc",
            "lines": [
