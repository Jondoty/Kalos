                    },
                    {
                        "text": "<< Page 1",
                        "value": "page1",
                        "action": "q.dialogue.set_page('buy1');"
                    }
                ]
            }
        },



        {
            "id": "pickfirestone",
            "speaker": "npc",
            "lines": [
                "You'd like to purchase a Fire Stone for $3000?"
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "isSelectable": "q.player.has_tag('MoneyHave3000')",
                        "text": "Buy 1",
                        "value": "buy1",
                        "action": [
                            "q.run_command('execute as ' + q.player.username + ' run give @s cobblemon:fire_stone 1');",
                            "q.run_command('execute as ' + q.player.username + ' run playsound minecraft:entity.experience_orb.pickup ambient @s ~ ~ ~ 1 1 1');",
                            "q.run_command('execute as ' + q.player.username + ' run scoreboard players remove @s Money 3000');",
                            "q.dialogue.set_page('buyend');"
                        ]
                    },
                    {
                        "text": "Go Back",
                        "value": "goback",
                        "action": [
                            "q.dialogue.set_page('buy1');"
                        ]
