{
    "initializationAction": [
        "q.run_command('execute as ' + q.player.username + ' run function kalos:data/testformoney');"
    ],
    "escapeAction": [
        "q.run_command('execute as ' + q.player.username + ' run function kalos:data/removemoneytags');",
        "q.dialogue.close();"
    ],
    "names": [
        "Herboriste Shop"
    ],
    "speakers": {
        "npc": {
            "name": "Herboriste Shop",
            "face": {
                "type": "artificial",
                "modelType": "npc",
                "identifier": "cobblemon:oldlady",
                "isLeftSide": true
            }
        }
    },
    "pages": [
        {
            "id": "greeting",
            "speaker": "npc",
            "lines": [
                "Medicinal herbs from foreign countries. They make Pokémon healthy! Come now. Buy them!"
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Buy",
                        "value": "buy",
                        "action": "q.dialogue.set_page('buy1');"
                    },
                    {
                        "text": "No Thanks",
                        "value": "nothanks",
                        "action": "q.dialogue.set_page('end');"
                    }
                ]
            }
        },
        {
            "id": "buy1",
            "speaker": "npc",
            "lines": [
                "What would you like to purchase?"
            ],
            "input": {
                "type": "option",
                "vertical": true,
                "options": [
                    {
                        "text": "Heal Powder",
                        "value": "healpowder",
                        "action": "q.dialogue.set_page('pickhealpowder');"
                    },
                    {
                        "text": "Energy Root",
                        "value": "energyroot",
                        "action": "q.dialogue.set_page('pickenergyroot');"
                    },
                    {
                        "text": "Revival Herb",
                        "value": "revivalherb",
                        "action": "q.dialogue.set_page('pickrevivalherb');"
                    }
                ]
            }
        },
        {
            "id": "pickhealpowder",
            "speaker": "npc",
            "lines": [
                "Heal Powder is a very bitter medicine powder. It heals all the status problems of a single Pokémon. Each one is $450."
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "isSelectable": "q.player.has_tag('MoneyHave450')",
                        "text": "Buy",
                        "value": "buy",
                        "action": [
                            "q.run_command('execute as ' + q.player.username + ' run give @s cobblemon:heal_powder 1');",
                            "q.run_command('execute as ' + q.player.username + ' run playsound minecraft:entity.experience_orb.pickup ambient @s ~ ~ ~ 1 1 1');",
                            "q.run_command('execute as ' + q.player.username + ' run scoreboard players remove @s Money 450');",
                            "q.dialogue.set_page('buyend');"
                        ]
                    },
                    {
                        "text": "<< Go Back",
                        "value": "goback",
                        "action": [
                            "q.dialogue.set_page('buy1');"
                        ]
                    }
                ]
            }
        },
        {
            "id": "pickenergypowder",
            "speaker": "npc",
            "lines": [
                "EnergyPowder is a very bitter medicine powder. It restores the HP of one Pokémon by 50 points. Each one is $500."
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "isSelectable": "q.player.has_tag('MoneyHave350')",
                        "text": "Buy",
                        "value": "buy",
                        "action": [
                            "q.run_command('scoreboard players set ' + q.player.username + ' TriggerCommand 202');",
                            "q.dialogue.set_page('buyend');"
                        ]
                    },
                    {
                        "text": "<< Go Back",
                        "value": "goback",
                        "action": [
                            "q.dialogue.set_page('buy1');"
                        ]
                    }
                ]
            }
        },
        {
            "isSelectable": "q.player.has_tag('MoneyHave800')",
            "id": "pickenergyroot",
            "speaker": "npc",
            "lines": [
                "Energy Root is a very bitter root. It restores the HP of one Pokémon by 120 points. Each one is $800."
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Buy",
                        "value": "buy",
                        "action": [
                            "q.run_command('execute as ' + q.player.username + ' run give @s cobblemon:energy_root 1');",
                            "q.run_command('execute as ' + q.player.username + ' run playsound minecraft:entity.experience_orb.pickup ambient @s ~ ~ ~ 1 1 1');",
                            "q.run_command('execute as ' + q.player.username + ' run scoreboard players remove @s Money 800');",
                            "q.dialogue.set_page('buyend');"
                        ]
                    },
                    {
                        "text": "<< Go Back",
                        "value": "goback",
                        "action": [
                            "q.dialogue.set_page('buy1');"
                        ]
                    }
                ]
            }
        },
        {
            "id": "pickrevivalherb",
            "speaker": "npc",
            "lines": [
                "Revival Herb is a very bitter medicinal herb. It revives a fainted Pokémon, fully restoring its HP. Each one is $2800."
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "isSelectable": "q.player.has_tag('MoneyHave2800')",
                        "text": "Buy",
                        "value": "buy",
                        "action": [
                            "q.run_command('execute as ' + q.player.username + ' run give @s cobblemon:revival_herb 1');",
                            "q.run_command('execute as ' + q.player.username + ' run playsound minecraft:entity.experience_orb.pickup ambient @s ~ ~ ~ 1 1 1');",
                            "q.run_command('execute as ' + q.player.username + ' run scoreboard players remove @s Money 2800');",
                            "q.dialogue.set_page('buyend');"
                        ]
                    },
                    {
                        "text": "<< Go Back",
                        "value": "goback",
                        "action": [
                            "q.dialogue.set_page('buy1');"
                        ]
                    }
                ]
            }
        },
        {
            "id": "buyend",
            "speaker": "npc",
            "lines": [
                "Here you are! Thank you!"
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Close",
                        "value": "close",
                        "action": [
                            "q.run_command('execute as ' + q.player.username + ' run function kalos:data/removemoneytags');",
                            "q.dialogue.close();"
                        ]
                    }
                ]
            }
        },
        {
            "id": "end",
            "speaker": "npc",
            "lines": [
                "Please come again!"
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Close",
                        "value": "close",
                        "action": [
                            "q.run_command('execute as ' + q.player.username + ' run function kalos:data/removemoneytags');",
                            "q.dialogue.close();"
                        ]
                    }
                ]
            }
        }
    ]
}