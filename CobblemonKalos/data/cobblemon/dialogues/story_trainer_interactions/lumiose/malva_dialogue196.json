        "q.run_command('execute as ' + q.player.username + ' run function kalos:triggers/stopsound');",
        "q.run_command('tellraw ' + q.player.username + ' {\"text\":\"You got $12600 for winning!\",\"italic\":true,\"color\":\"gray\"}');",
        "q.run_command('scoreboard players add ' + q.player.username + ' Money 12600');"
    ],
    "escapeAction": [],
    "speakers": {
        "malva": {
            "name": "Malva",
            "face": {
                "type": "artificial",
                "modelType": "npc",
                "identifier": "cobblemon:malva",
                "isLeftSide": true
            }
        },
        "player": {
            "face": "q.player.face(true);",
