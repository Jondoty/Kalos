{
    "initializationAction": [],
    "escapeAction": [
        "q.dialogue.close();"
    ],
    "names": [
        "Suspicious Lady"
    ],
    "speakers": {
        "npc": {
            "name": {
                "type": "expression",
                "expression": "q.npc.name"
            },
            "face": "q.npc.face();"
        }
    },
    "pages": [
        {
            "id": "greeting",
            "speaker": "npc",
            "lines": [
                "Welcome, welcome. Step right up. I didn't expect you to show. But here you are."
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "action": [
                            "q.dialogue.set_page('page2');"
                        ]
                    }
                ]
            }
        },
        {
            "id": "page2",
            "speaker": "npc",
            "lines": [
                "Heh heh heh... Let's get into it."
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "§c⚔ Battle ⚔§r",
                        "value": "battle",
                        "action": [
                            "q.run_command('scoreboard players set ' + q.player.username + ' BattleStart 34');",
                            "q.run_command('execute as ' + q.player.username + ' run function kalos:triggers/stopsound');",
                            "v.battle = q.npc.start_battle(q.player);"
                        ]
                    }
                ]
            }
        }
    ]
}