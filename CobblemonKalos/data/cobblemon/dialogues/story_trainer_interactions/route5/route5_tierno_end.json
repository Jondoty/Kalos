        "q.run_command('execute as ' + q.player.username + ' run tag @s add Dialogue25');",
        "q.run_command('tellraw ' + q.player.username + ' {\"text\":\"You got $1200 for winning!\",\"italic\":true,\"color\":\"gray\"}');",
        "q.run_command('scoreboard players add ' + q.player.username + ' Money 1200');"
