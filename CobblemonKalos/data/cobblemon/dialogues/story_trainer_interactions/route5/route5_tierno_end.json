            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "action": [
                            "q.run_command('execute as ' + q.player.username + ' run function kalos:spawn/honey');",
                            "q.run_command('execute as ' + q.player.username + ' run playsound minecraft:itemget ambient @s ~ ~ ~ 1 1 1');",
                            "q.dialogue.set_page('page9');"
                        ]
                    }
                ]
            }
        },
        {
            "id": "page9",
            "speaker": "trevor",
            "lines": [
                "You see, using Honey will encourage Pokémon hordes to appear."
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Next",
                        "value": "next",
                        "action": "q.dialogue.set_page('page10');"
                    }
                ]
            }
        },
        {
            "id": "page10",
            "speaker": "trevor",
            "lines": [
                "Though if you are going to challenge a whole horde... A lot of Pokémon will spawn!"
            ],
            "input": {
                "type": "option",
                "vertical": false,
                "options": [
                    {
                        "text": "Close",
                        "value": "close",
                        "action": [
                            "q.run_command('particle cloud -766 100 -134 2 2 2 1 100');",
                            "q.run_command('particle cloud -769 100 -136 2 2 2 1 100');",
                            "q.run_command('tp @e[x=-769,y=99,z=-136,dy=3,type=cobblemon:npc] 10000000 -50000 -10000000');",
                            "q.run_command('tp @e[x=-766,y=99,z=-134,dy=3,type=cobblemon:npc] 10000000 -50000 -10000000');",
                            "q.run_command('tag ' + q.player.username + ' remove InDialogue');",
                            "q.dialogue.close();"
